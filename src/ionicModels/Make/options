EXE_INC = \
    -I$(LIB_SRC)/ODE/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(PWD)/../couplingModels/common \
    -I$(PWD)/../couplingModels \
    -I$(PWD)/../couplingModels/lnInclude \
    -I$(PWD)/../genericWriter/lnInclude \
    -I$(PWD)/../verificationModels \
    $(if $(CARDIAC_ENABLE_CUDA),-DHAS_CUDA -I$(CUDA_HOME)/include)


LIB_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lgenericWriter \
    -lfiniteVolume \
    -lmeshTools \
    -lODE \
    $(if $(CARDIAC_ENABLE_CUDA),-L$(CUDA_HOME)/lib64 -lcudart)

// Load wmake CUDA compilation rules (.cu -> .o via nvcc) when GPU build is on.
// General/cuda adds: SUFFIXES += .cu  and  $(OBJECTS_DIR)/%.o : %.cu  recipe.
$(if $(CARDIAC_ENABLE_CUDA),$(eval sinclude $(WM_DIR)/rules/General/cuda))
