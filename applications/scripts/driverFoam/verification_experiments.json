{
  "schema_version": "1",
  "experiments": [
    {
      "experiment_id": "monodomain_cartesian",
      "description": "Cartesian monodomain fields and pseudo-ECG convergence",
      "case_dir": "tutorials/manufacturedSolutions/monodomainPseudoECG",
      "execution": {"kind": "driver_sweep", "runner": "setup/run_monodomain_cartesian.sh", "driver_specs": ["setup/studies/hexConvergence/sweep_hex_convergence.json"]},
      "matrix": {"mesh_family": ["cartesian"], "dimensions": ["1D", "2D", "3D"], "N": [10, 20, 40, 80]},
      "observables": ["Vm", "u1", "u2", "Phi_e"],
      "aggregation": {"key": "monodomain_cartesian", "result": "setup/results/monodomain_cartesian.csv", "reference": "reference/monodomain_cartesian.csv"}
    },
    {
      "experiment_id": "monodomain_tet_generic",
