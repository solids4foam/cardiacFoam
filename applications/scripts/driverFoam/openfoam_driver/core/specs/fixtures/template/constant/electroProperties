// APPENDIX A — PURKINJE GRAPH FILE FORMAT (constant/purkinjeGraph)
// ─────────────────────────────────────────────────────────────────────────────
/*
When using conductionNetworkDomains, the 'graphFile' key references a separate
dictionary in constant/ directory. Example constant/purkinjeGraph:

    FoamFile
    {
        version     2.0;
        format      ascii;
        class       dictionary;
        location    "constant";
        object      purkinjeGraph;
    }

    // Edge list: ( nodeA  nodeB  length[m]  conductance[S/m] )
    // A tree on N nodes requires exactly N-1 edges.
    edges
    (
        ( 0  1  0.003  3.0 )
        ( 1  2  0.005  3.0 )
        ( 1  3  0.005  3.0 )
    );

    // 3-D position of every node [m] (size = nNodes, must include all nodes 0..N-1)
    points
    (
        (0.0        0.0        0.0)
        (0.003      0.0        0.0)
        (0.008      0.0        0.0)
        (0.008      0.001      0.0)
    );

    // Node indices where Purkinje terminates and couples to myocardium
    pvjNodes  ( 2  3 );

    // 3-D position of each PVJ [m] (size = pvjNodes.size())
    pvjLocations
    (
        (0.008  0.0    0.0)
        (0.008  0.001  0.0)
    );

    // Optional: root stimulus node (default: 0)
    // rootNode  0;
*/

