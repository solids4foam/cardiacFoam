// ─────────────────────────────────────────────────────────────────────────────
// SECTION 2D — 3D EIKONAL SOLVER COEFFICIENTS
// (activate by setting: myocardiumSolver eikonalSolver;)
//
// Solves a steady nonlinear anisotropic eikonal-diffusion equation to compute
// activation times psi(x) [s]. No ionic model needed — only physical tissue
// parameters and a wave-speed normalisation factor c0. The stimulus box pins psi = 0 at
// the initial activation site.
// ─────────────────────────────────────────────────────────────────────────────

/*
eikonalSolverCoeffs
{
    // Tissue conductivity tensor [S/m]  (falls back to 0/conductivity if present)
    conductivity  [-1 -3 3 0 0 2 0]  (0.1334 0 0 0.01761 0 0.01761);

    // Surface-to-volume ratio  [1/m]
    chi           [0 -1 0 0 0 0 0]   140000;

    // Membrane capacitance  [F/m²]
    cm            [-1 -4 4 0 0 2 0]  0.01;

    // Reference wave-speed normalisation factor [s^-1/2]
    // c0 enters the eikonal equation as CV = c0 * sqrt(conductivity / (chi*cm)).
    c0            [0 0 -0.5 0 0 0 0]   0.8;

    // Linearisation scheme:
    //   true  → advection-diffusion approach (more stable, recommended)
    //   false → pure diffusion (simpler, may need tighter PIMPLE relaxation)
    eikonalAdvectionDiffusionApproach  true;

    // Stimulus box — cells inside are pinned to psi = 0 (activation origin)
    stimulusLocationMin  (0 0 5.5e-3);
    stimulusLocationMax  (1.5e-3 1.5e-3 7e-3);

    // Optional Purkinje coupling follows the same structure used above for
    // monodomainSolverCoeffs:
    //   conductionNetworkDomains { ... }
    //   domainCouplings { ... }
    // Use:
    //   purkinjeGraphModelCoeffs.conductionSystemSolver  eikonalSolver1D;
    //   conductionNetworkDomain  purkinjeNetwork;
    //   electroDomainCoupler     eikonalPvjCoupler;
}
*/

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 3 — ECG / PSEUDO-ECG MONITORING  [OPTIONAL]
// ─────────────────────────────────────────────────────────────────────────────

/*
Place ecgDomains inside the active <solver>Coeffs block, for example:

monodomainSolverCoeffs
{
    ecgDomains
    {
        bodySurfaceECG
        {
            // ECG solver selection (registered in ecgSolver RTST)
            // Valid type: pseudoECG
            ecgSolver  pseudoECG;
            // sigmaExtracellular  0.2668; // fallback conductivity if 3D tensor is unavailable

            // Electrode positions [m]
            electrodePositions
            {
                lead_I   ( 0.1  0.0  0.0 );
                lead_II  ( 0.0  0.1  0.0 );
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Eikonal ECG (activation-time surrogate — fast, no ionic solve at ECG time)
// Requires myocardiumSolver = eikonalSolver.
// The 'sampling' block is REQUIRED: it defines the Vm-response interpolation
// window used by the tissue templates (see src/electroModels/ecgModels/eikonalECG/).
// ─────────────────────────────────────────────────────────────────────────────

eikonalSolverCoeffs
{
    ecgDomains
    {
        ECG
        {
            ecgSolver    eikonalECG;

            sampling                    // REQUIRED — must cover the full action potential
            {
                start  0;              // [s] start of Vm-response window
                end    0.5;            // [s] end of window (>= action potential duration)
                deltaT 0.005;          // [s] interpolation time step
            }

            electrodePositions
            {
                lead_I   ( 0.1  0.0  0.0 );
                lead_II  ( 0.0  0.1  0.0 );
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Bath-coupled ECG support
// ─────────────────────────────────────────────────────────────────────────────
// For body-surface ECG over an immersed heart, configure the unified
// bidomain+bath solve via a 'bathPotentialDomain' subdict inside the active
// bidomainSolverCoeffs block, then enable 'torsoECG' under ecgDomains.
// Requires myocardiumSolver = bidomainSolver.
