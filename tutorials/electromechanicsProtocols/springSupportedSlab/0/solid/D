FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/solid";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

#include "$FOAM_CASE/system/caseParameters"

boundaryField
{
    "xMin|xMax"
    {
        type            solidRobin;
        kNormal         uniform $kEnds;
        kTangential     uniform $kEnds;
        value           uniform (0 0 0);
    }

    lateral
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
}

