# Reference grammar: tutorials/regression/lib.sh.
# probe <file> <time> <column> <expected> <tolerance>
# springLaw <time> <tolerance [N]>: force on xMin from the stress field
#     versus -kEnds * A0 * <Dx> (case-local kind, see regressionTest.sh)
# Values from solids4foam ed7f957f, whose electroMechanicalLaw pushes the active
# stress forward with the deformation gradient (#393).
# Default case (kEnds = 1e7 Pa/m, deltaT = 1e-5 s), stopped at 0.05 s.
#
# Far-end Vm: resting at 0.02 s, activated by 0.05 s.
probe      postProcessing/Vmprobes/electro/0/Vm                 0.02  4  -0.0855739     2e-3
probe      postProcessing/Vmprobes/electro/0/Vm                 0.05  4  0.0131733      3e-3
# Ta near the stimulus and at the centre, above the resting 5.1-5.6 kPa.
probe      postProcessing/Taprobes/solid/0/Ta                   0.05  3  10023.9        200.0
probe      postProcessing/Taprobes/solid/0/Ta                   0.05  5  6659.53        200.0
# End displacement: preloaded by the resting Ta, then shortening.
probe      postProcessing/solid/D_xMin/0/surfaceFieldValue.dat  0.02  2  0.0002539433   7e-06
probe      postProcessing/solid/D_xMin/0/surfaceFieldValue.dat  0.05  2  0.0003284756   7e-06
probe      postProcessing/solid/D_xMax/0/surfaceFieldValue.dat  0.05  2  -0.0003224575  7e-06
springLaw  0.02                                                 1e-4
springLaw  0.05                                                 1e-4
