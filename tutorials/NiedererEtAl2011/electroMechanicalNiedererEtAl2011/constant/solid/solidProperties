FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/solid";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel     nonLinearGeometryTotalLagrangianTotalDisplacement;

nonLinearGeometryTotalLagrangianTotalDisplacementCoeffs
{
    nCorrectors     200;

    // Relative residual: converge when residual < rTol * initialResidual.
    // The solver plateaus at ~5% of initial residual; 0.1 accepts that.
    rTol            0.1;

    // Absolute residual: converge when residual < aTol
    aTol            1e-6;

    // Step norm: converge when deltaX < sTol * xNorm
    sTol            1e-4;

    infoFrequency   1;

    predictor       true;
}

