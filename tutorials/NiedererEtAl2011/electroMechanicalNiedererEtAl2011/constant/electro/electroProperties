FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/electro";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver    monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.1334177215 0 0 0.01760617761 0 0.01760617761);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    TNNP;
    tissue    epicardialCells;

    ionicHeterogeneity
    {
        field            t;
        mode             transmuralBands;
        endoMInterface   0.3;
        mEpiInterface    0.7;
        transitionWidth  0.1;
        transitionMode   blend;
        smoothing        smoothstep;
    }

    outputVariables
    {
        ionic
        {
            export (Ca_i);
        }
    }

    solutionAlgorithm    explicit;

    solver RKF45;
    maxSteps 1000000000;

    externalStimulus
    {
        stimulusLocationMin (0 0 5.5e-3);
        stimulusLocationMax (1.5e-3 1.5e-3 7e-3);
        stimulusDuration [ 0 0 1 0 0 0 0 ] 2e-3;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 50000;
        stimulusStartTime 0.0;
    }
}

