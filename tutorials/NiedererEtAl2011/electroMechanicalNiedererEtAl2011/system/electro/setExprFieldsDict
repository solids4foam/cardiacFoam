FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

expressions
(
    t
    {
        field       t;
        create      true;
        dimensions  [0 0 0 0 0 0 0];

        expression
        #{
            pos().z()/0.007
        #};
    }
);

