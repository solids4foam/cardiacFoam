// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

// Hybrid solver: time-stepping reaction-diffusion solver
// Runs 1D Purkinje eikonal + 3D tissue monodomain with reaction-diffusion coupling
// Time-steps from t=0 to t=0.02s with Δt=5×10⁻⁵s for accurate ODE integration

application     cardiacFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.02;

deltaT          5e-05;

maxCo           0.1;

writeControl    runTime;

writeInterval   0.005;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

functions
{
}


// ************************************************************************* //
