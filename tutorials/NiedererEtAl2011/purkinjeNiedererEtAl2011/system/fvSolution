FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Monodomain Vm field
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.0;
    }

    // Eikonal activationTime field — symmetric (non-advection branch)
    "activationTime|activationTimeFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          1e-5;
    }

    // Eikonal activationTime field — advection-diffusion branch.
    // DILU is safe because activationEqn.relax() boosts the diagonal.
    // relTol 0.01 lets the inner solver exit early on hard Picard steps
    // rather than stalling at maxIter and producing NaN.
    asymmetric_activationTime
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
        maxIter         500;
    }
}

PIMPLE
{
    nOuterCorrectors    1000;

    residualControl
    {
        Vm
        {
            relTol          0.0;
            tolerance       1e-6;
        }
        activationTime
        {
            relTol          0.0;
            tolerance       1e-11;
        }
    }
}

relaxationFactors
{
    equations
    {
        activationTime    0.9;
    }
}

