FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    // Gauss linear is more stable than leastSquares with anisotropic
    // conductivity tensors; leastSquares can amplify high-frequency noise.
    default         Gauss linear;
}

divSchemes
{
    default                          none;
    div(phiU,activationTime)         Gauss upwind;  // eikonal advection-diffusion
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

