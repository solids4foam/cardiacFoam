FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  eikonalSolver;

eikonalSolverCoeffs
{
    // Conductivity, surface-to-volume ratio and membrane capacitance
    // match the standard NiedererEtAl2011 slab parameters.
    conductivity [ -1 -3 3 0 0 2 0 ] (0.1334177215 0 0 0.01760617761 0 0.01760617761);
    chi          [ 0 -1 0 0 0 0 0 ]  140000;
    cm           [ -1 -4 4 0 0 2 0 ] 0.01;

    // Eikonal conduction speed (sqrt of 1/(chi*cm) scaling factor).
    c0           [ 0 0 -0.5 0 0 0 0 ] 1;

    eikonalAdvectionDiffusionApproach true;
    electrophysicsAdvanceScheme       staggeredElectrophysicsAdvanceScheme;

    // No direct bounding-box stimulus: all activation constraints are
    // deposited by the Purkinje-ventricular junction coupler below.
    stimulusLocationMin (1e6 1e6 1e6);
    stimulusLocationMax (1e6 1e6 1e6);

    // ---------------------------------------------------------------
    // Purkinje network — eikonal 1-D Dijkstra propagation
    // ---------------------------------------------------------------
    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver eikonalSolver1D;
                graphFile              purkinjeGraph;

                // Purkinje conduction velocity (m/s).
                purkinjeCV [ 0 1 -1 0 0 0 0 ] 2.0;

                // Required by purkinjeGraphModel even for the eikonal solver.
                chi     140000;
                cm      0.01;
                vm1DRest -0.084;

                // Seed the Purkinje root node at t = 0.
                rootStimulus
                {
                    node      0;
                    startTime 0.0;
                    duration  0.0;
                    intensity 0.0;
                }

                outputVariables
                {
                    export (activationTime);
                    debug  ();
                }
            }
        }
    }

    // ---------------------------------------------------------------
    // Purkinje-ventricular junction: eikonal coupler deposits Purkinje
    // terminal activation times as Dirichlet constraints on psi.
    // ---------------------------------------------------------------
    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    eikonalPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            pvjRadius               5e-4;
            couplingMode            unidirectional;
        }
    }
}

// ************************************************************************* //
