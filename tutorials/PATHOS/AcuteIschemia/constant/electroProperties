FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    chi         [ 0 -1 0 0 0 0 0 ] 140000;
    cm          [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel  TNNP;
    tissue      epicardialCells;

    ionicHeterogeneity
    {
        field             uvc_transmural;
        mode              transmuralBands;
        endoMInterface    0.3;
        mEpiInterface     0.7;
        transitionWidth   0;
        transitionMode    hard;
        smoothing         smoothstep;
    }

    // Acute ischemia parametrisation — early ischemic zone (10-15 min).
    // K_o elevated (hyperkalemia): 5.4 → 8.0 mM.
    // g_Na reduced 40 % (acidosis + fast Na+ channel depression).
    // g_CaL reduced 40 % (acidosis + Ca2+ channel depression).
    // g_K1 doubled (I_K1 increase from hyperkalemia).
    // P_NaK halved (Na/K-ATPase inhibition from ATP depletion).
    // References: Ferrero et al. 1996, Trenor et al. 2010, Rodriguez et al. 2006.
    ionicConstantOverrides
    {
        global
        {
            set
            {
                K_o     8.0;
            }
            scale
            {
                g_Na    0.6;
                g_CaL   0.6;
                g_K1    2.0;
                P_NaK   0.5;
            }
        }
    }

    solutionAlgorithm explicit;
    solver            RKF45;
    maxSteps          1000000000;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;

                ionicModel             BuenoOrovio;
                tissue                 epicardialCells;

                chi                    14000;
                cm                     0.01;
                purkinjeConductivity   5.0;
                vm1DRest               -0.084;

                rootStimulus
                {
                    node      14083;
                    startTime 0.0;
                    duration  0.002;
                    intensity 500000.0;
                }

                solver         RKF45;
                maxSteps       1000000000;

                outputVariables
                {
                    export (Vm activationTime Icoupling);
                    debug  (Vm Iion);
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    reactionDiffusionPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            rPvj                    1000;
            pvjRadius               6e-4;
            couplingMode            unidirectional;
            debugCoupling           true;
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver pseudoECG;
            sigmaExtracellular 0.2;

            electrodePositions
            {
                V1 (0.047864   0.05969    -0.10536);
                V2 (0.08917    0.08074    -0.14187);
                V3 (0.10940    0.0684336   -0.169305);
                V4 (0.131631   0.073495    -0.21842);
                V5 (0.132433   0.11248     -0.290978);
                V6 (0.137525   0.0933918   -0.26164);
            }
        }
    }
}

