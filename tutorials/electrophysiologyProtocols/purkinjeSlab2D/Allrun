#!/bin/bash

# Source OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Options
#   solver=monodomain  (default) — monodomain 2-D slab + restitutionEikonalSolver1D
#                                  Purkinje network, bidirectional PVJ coupling.
#                                  Real multi-step timeline; this is the variant
#                                  used to exercise retrograde tissue->network
#                                  activation.
#   solver=eikonal     — eikonalSolver 2-D slab + restitutionEikonalSolver1D
#                         Purkinje network. NOTE: eikonalSolver collapses the
#                         whole run to a single dimensionless step (see
#                         eikonalMyocardiumDomain::applyModelTimeControls) —
#                         kept for comparison, not for multi-step timelines.

solver="monodomain"
for arg in "$@"; do
    case "$arg" in
        solver=*) solver="${arg#solver=}" ;;
    esac
done

case "$solver" in
    monodomain|eikonal) ;;
    *) echo "Unknown solver '$solver'. Use solver=monodomain or solver=eikonal." ; exit 1 ;;
esac

echo "Using solver: $solver"
cp "constant/electroProperties.$solver" constant/electroProperties

runApplication blockMesh
runApplication cardiacFoam
