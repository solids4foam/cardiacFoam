FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  eikonalSolver;

eikonalSolverCoeffs
{
    // Conductivity to match monodomain scaling
    conductivity    [-1 -3 3 0 0 2 0] (0.1334 0 0 0.1334 0 0.1334);

    chi  [0 -1 0 0 0 0 0]   140000;
    cm   [-1 -4 4 0 0 2 0]  0.01;
    
    // c0 factor defines the CV multiplier: CV = c0 * sqrt(sigma / (chi * cm))
    // With sigma=0.1334, chi=140000, cm=0.01:
    // sqrt(0.1334 / 1400) = ~0.00976
    // If c0 = 72, CV = 72 * 0.00976 = ~0.702 m/s
    c0   [0 0 -0.5 0 0 0 0] 72;

    eikonalAdvectionDiffusionApproach true;

    stimulusLocationMin  (0 0 0);
    stimulusLocationMax    (2e-3 2e-4 2e-4);
}

