FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  monodomainSolver;

monodomainSolverCoeffs
{
    // Main calibration knob for this tutorial.
    conductivity    [-1 -3 3 0 0 2 0] (0.1334 0 0 0.1334 0 0.1334);

    chi  [0 -1 0 0 0 0 0]   140000;
    cm   [-1 -4 4 0 0 2 0]  0.01;

    ionicModel    TWorldcompactBatched;
    tissue    epicardialCells;

    outputVariables
    {
        ionic
        {
            export  ();
            debug   (Vm);
        }
    }

    solutionAlgorithm    explicit;
    solver             RKF45;
    initialODEStep    1e-06;
    absTol    1e-06;
    relTol    0.0001;
    maxSteps           1000000000;

    externalStimulus
    {
        stimulusLocationMin  (0 0 0);
        stimulusLocationMax    (2e-3 2e-4 2e-4);
        stimulusDuration     [0 0 1 0 0 0 0]  4e-3;
        stimulusIntensity    [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime    0.0;
    }
}

