FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
myocardiumSolver singleCellSolver;
singleCellSolverCoeffs
{

    // Cell model selection

    ionicModel    TWorld;
    tissue    endocardialCells;


    // Time integration settings

    solver          RKF45;
    initialODEStep  1e-6;
    maxSteps        1000000000;


    // Stimulus protocol
    singleCellStimulus
    {
        stim_start      20;
        stim_duration   1;
        stim_amplitude  60;
        stim_period_S1  1000;
        nstim1          2;
        stim_period_S2  0;
        nstim2          0;
    }



    // optional I/O control

    writeAfterTime  0;
    writeFrequency  0.001;

    outputVariables
    {
        ionic
        {
            export (Vm cai nai ki AV_INa_INa AV_ICaL_ICaL AV_Ito_Ito AV_IKr_IKr AV_IKs_IKs AV_IK1_IK1 AV_INaCa_INaCa AV_INaK_INaK);
            debug ();
        }
        activeTension
        {
            export (AV_Ta);
        }
    }

    activeTensionModel LandNiederer;
}
