/*--------------------------------*- C++ -*----------------------------------*\
| cardiacFoam: the OpenFOAM heart project                                     |
| Version:     v0.1                                                           |
| Web:         https://cardiacFoam.github.io                                  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue    epicardialCells;

    outputVariables
    {
        ionic
        {
            export (Vm);
            debug ();
        }
    }

    solutionAlgorithm    explicit;
    solver RKF45;
    maxSteps 1000000000;
    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;
                ionicModel             BuenoOrovio;
                tissue                 epicardialCells;

                chi      140000;
                cm       0.01;
                vm1DRest -0.084;

                // Current injected at the root node over each window.
                rootStimulus
                {
                    node          0;
                    startTimeList (0.01 0.3);
                    duration      0.002;
                    intensity     500000.0;
                }

                solver   RKF45;
                maxSteps 1000000000;

                outputVariables
                {
                    export (IcouplingSource Vm);
                    debug  ();
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    reactionDiffusionPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            rPvj                    10000;
            pvjRadius               0.0006;
            pvjKernel               linear;
            pvjCouplingScheme       implicit;
            couplingMode            unidirectional;
            debugCoupling           false;
        }
    }
}

// ************************************************************************* //
