#!/bin/bash
#-------------------------------------------------------------------------------
# Allrun script for electro-mechanical coupling tutorial
#
# Usage:
#   ./Allrun          serial
#   ./Allrun parallel  parallel (N cores set in system/decomposeParDict)
#-------------------------------------------------------------------------------

. $WM_PROJECT_DIR/bin/tools/RunFunctions

requireFullElectroMechanicalBuild()
{
    local lib
    local libDir="${FOAM_USER_LIBBIN:-}"

    if [[ -z "$libDir" ]]; then
        echo "FOAM_USER_LIBBIN is not set. Source the OpenFOAM environment first."
        exit 1
    fi

    for lib in "${libDir}"/libelectroMechanicalModels.*; do
        if [[ -e "$lib" ]]; then
            return 0
        fi
    done

    cat <<'EOF'
This tutorial requires cardiacFoam built in full solids4foam mode.
The lightweight electrophysiology-only build does not compile
libelectroMechanicalModels, so electroMechanicalModel is unavailable.

Rebuild cardiacFoam after compiling solids4foam and sourcing that environment.
EOF

    exit 1
}

parallelRun=false
for arg in "$@"; do
    case "$arg" in
        parallel) parallelRun=true ;;
    esac
done

requireFullElectroMechanicalBuild

# -------------------------
# Mesh preparation
# -------------------------

# The mesh is the single copy shared with the sibling electroHeart
# case, kept once in ../mesh/ to avoid tracking the same ~10MB mesh twice in
# git. It is already scaled to adult-heart-scale SI metres (80 x 100 x 80 mm,
# 226 mL) - just copy it into both regions. Do not run blockMesh here:
# system/blockMeshDict belongs to the slab tutorial scaffold and was already
# removed from this case.
# Guard: if the shared mesh is still a Git-LFS pointer (a clone or CI
# checkout made without LFS), fail here with a readable message instead of
# letting cardiacFoam die later on an unparsable mesh.
if head -c 40 ../mesh/constant/polyMesh/points 2>/dev/null \
    | grep -q "git-lfs.github.com"; then
    echo "ERROR: ../mesh holds Git-LFS pointer files, not the real mesh." 1>&2
    echo "       Run 'git lfs install && git lfs pull' and retry." 1>&2
    exit 1
fi

cp -a ../mesh/constant/polyMesh constant/electro/polyMesh
cp -a ../mesh/constant/polyMesh constant/solid/polyMesh

# The shared fibre/sheet/tm/conductivity fields also live once in
# ../mesh/0/, alongside the mesh. D is case-specific and stays committed
# here. f0f (the face-interpolated, unit-length companion of f0 that
# electroMechanicalLaw requires) was precomputed once from f0 via
# interpolateFibreField and committed alongside it, the same way f0
# itself is precomputed rather than solved for at run time.
cp ../mesh/0/fiber 0/solid/f0
cp ../mesh/0/f0f 0/solid/f0f
cp ../mesh/0/sheet 0/solid/sheet
cp ../mesh/0/tm 0/electro/tm
cp ../mesh/0/tm 0/solid/tm
cp ../mesh/0/Conductivity 0/electro/Conductivity

# tm is 0 at epicardium and 1 at endocardium in this mesh. The ionic
# heterogeneity band lookup requires the opposite orientation (0 at
# endocardium, 1 at epicardium), so derive t = 1 - tm for it to read.
runApplication -s electro setExprFields -region electro

# -------------------------
# Run solver
# -------------------------

if $parallelRun; then
    runApplication -s electro decomposePar -region electro
    runApplication -s solid decomposePar -region solid
    runParallel cardiacFoam
    runApplication -s electro reconstructPar -region electro
    runApplication -s solid reconstructPar -region solid
else
    runApplication cardiacFoam
fi
