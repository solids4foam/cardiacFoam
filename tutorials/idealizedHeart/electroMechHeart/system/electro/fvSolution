FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/electro";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.0;
    }

    "psi|psiFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.1;
    }

    "activationTime|activationTimeFinal"
    {
        solver          PCG;
        preconditioner  none;
        tolerance       1e-11;
        relTol          1e-6;
    }

    asymmetric_activationTime
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.01;
        maxIter         1000;
    }
}

PIMPLE
{
    nOuterCorrectors    1000;

    residualControl
    {
        "Vm|psi"
        {
            relTol          0.0;
            tolerance       1e-6;
        }
        activationTime
        {
            relTol          0.0;
            tolerance       1e-5;
        }
    }
}

relaxationFactors
{
    equations
    {
        psi    0.9;
        "activationTime.*"  0.7;
    }
}

