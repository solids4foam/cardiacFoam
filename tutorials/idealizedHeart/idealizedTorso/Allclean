#!/bin/bash
cd "${0%/*}" || exit 1

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

cleanCase
rm -rf case.foam postProcessing local
rm -f log.*
rm -f constant/electroProperties.withDefaultValues

# Solved time directories (cleanCase has been observed to leave them behind)
find . -maxdepth 1 -regex '\./-?[0-9]+\(\.[0-9]+\)?' ! -name '0' -exec rm -rf {} +

# The mesh, the 0/ fields, the Purkinje graph and the lead fields are copied
# in or built by Allrun, not source of this case
rm -rf constant/polyMesh 0
rm -f constant/purkinjeGraph constant/leadField_* constant/leadFieldBuildRecord \
    constant/leadFieldSignature

