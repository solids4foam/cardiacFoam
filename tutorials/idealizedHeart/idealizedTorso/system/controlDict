FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     cardiacFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
// One beat, QRS and T wave: the last cells activate by about 0.2 s and
// repolarise about 0.29 s later (README)
endTime         0.6;
deltaT          2e-05;
writeControl    runTime;
writeInterval   0.005;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
// -endTime of Allrun
#includeIfPresent "<case>/local/time"

