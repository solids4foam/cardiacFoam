#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source OpenFOAM run functions
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

usage()
{
    cat <<USAGE 1>&2
Usage: ./Allrun [leadField|bath] [sealed|stock] [parallel] [-endTime t]

Bidomain idealized ventricles inside the idealized torso, with the
body-surface ECG at nine electrodes.

  leadField     heart-only bidomain recorded through lead fields; the torso
                does not feed back (default)
  bath          one phiE over the heart and the torso, solved with Vm every
                step (two-way)
  sealed        sealedHeartBoundary true and sealedWallLeastSquares for grad(Vm)
                and grad(phiE) (default)
  stock         sealedHeartBoundary false and leastSquares
  parallel      decomposePar, [buildLeadFields,] cardiacFoam on the ranks of
                system/decomposeParDict, reconstructPar
  -endTime t    end time in seconds (default 0.6, the QRS and the T wave;
                system/controlDict)

leadField builds the lead fields for each run (they depend on the wall
treatment) and needs cardiacFoam built with solids4foam and PETSc.
USAGE
    exit 2
}

coupling=leadField
wall=sealed
parallelRun=false
endTime=
while [ "$#" -gt 0 ]
do
    case "$1" in
        leadField|bath) coupling="$1" ;;
        sealed|stock) wall="$1" ;;
        parallel)     parallelRun=true ;;
        -endTime)
            [ "$#" -ge 2 ] || usage
            endTime="$2"
            awk -v t="$endTime" 'BEGIN { exit !(t ~ /^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/ && t > 0) }' \
                || { echo "-endTime requires a positive number." 1>&2; exit 2; }
            shift
            ;;
        -h|-help|--help) usage ;;
        *) echo "Unknown argument '$1'." 1>&2; usage ;;
    esac
    shift
done

if [ -e log.cardiacFoam ] || [ -e log.buildLeadFields ]
then
    echo "${0##*/}: a run log exists; run ./Allclean first" 1>&2
    exit 1
fi

# The shared heart/torso geometry and the Purkinje graph (Git LFS)
geometry=../mesh/heartTorso
for file in "$geometry"/constant/polyMesh/points "$geometry"/0/ConductivityIntracellular \
    ../mesh/constant/purkinjeGraph
do
    if [ ! -f "$file" ] || head -c 200 "$file" | grep -q 'git-lfs.github.com'
    then
        echo "ERROR: $file is missing or a Git-LFS pointer." 1>&2
        echo "       Run 'git lfs install && git lfs pull' and retry." 1>&2
        exit 1
    fi
done

rm -rf local
mkdir local
if [ "$wall" = sealed ]
then
    echo "sealedHeartBoundary true;" > local/wall
    cat > local/gradSchemes <<EOF
grad(Vm)                sealedWallLeastSquares;
grad(Vm.component(0))   sealedWallLeastSquares;
grad(phiE)              sealedWallLeastSquares;
grad(phiE.component(0)) sealedWallLeastSquares;
EOF
else
    echo "sealedHeartBoundary false;" > local/wall
    : > local/gradSchemes
fi
[ -z "$endTime" ] || echo "endTime $endTime;" > local/time

echo "torsoCoupling $coupling;" > local/coupling
if [ "$coupling" = leadField ]
then
    # The heart-only phiE is pure Neumann: pin it at a point inside the
    # myocardium
    cat > local/myocardium <<EOF
phiERefPoint       (0.06137746404 0.023833610115 0.0039119150485);
phiEReferenceValue 0;
EOF
else
    # The torso phiERefPoint pins the global phiE. Each step: Vm, then the
    # PIMPLE nOuterCorrectors passes of (global phiE, Vm)
    echo "bathPredictorCorrector yes;" > local/myocardium
fi
echo "Torso coupling: $coupling, wall treatment: $wall"

cp -a "$geometry"/constant/polyMesh constant/polyMesh
mkdir -p 0
cp "$geometry"/0/* 0/
cp ../mesh/constant/purkinjeGraph constant/purkinjeGraph

# Heart conductivity tensors from 0/fiber and constant/heartConductivity
python3 setup/heartConductivity.py > log.heartConductivity 2>&1 \
    || { cat log.heartConductivity 1>&2; exit 1; }

runApplication checkMesh

if $parallelRun
then
    runApplication decomposePar
    [ "$coupling" = bath ] || runParallel buildLeadFields
    runParallel cardiacFoam
    runApplication reconstructPar
    runApplication redistributeRestartState
else
    [ "$coupling" = bath ] || runApplication buildLeadFields
    runApplication cardiacFoam
fi

#------------------------------------------------------------------------------
