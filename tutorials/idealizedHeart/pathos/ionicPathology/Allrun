#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# -------------------------
# Variant selection
# -------------------------
# One purkinjeGraph (unmodified), two ionic-pathology variants of
# electroProperties. No default - pick one explicitly.
variant=""
parallelRun=false
for arg in "$@"; do
    case "$arg" in
        ischemia|brugada) variant="$arg" ;;
        parallel)         parallelRun=true ;;
        *) echo "Unknown argument '$arg'. Use ischemia or brugada, and/or parallel." ; exit 1 ;;
    esac
done

if [ -z "$variant" ]; then
    cat <<'EOF'
Usage: ./Allrun <ischemia|brugada> [parallel]

ionicPathology has no default pathology - pick one explicitly:
  ./Allrun ischemia    acute ischemia (TNNP ionicConstantOverrides)
  ./Allrun brugada     Brugada syndrome type-1 (TNNP ionicConstantOverrides)

(For the healthy baseline, unmodified, run ../../electroHeart instead.)
EOF
    exit 1
fi

ln -sf "electroProperties.$variant" constant/electroProperties
echo "Active ionic-pathology variant: $variant (constant/electroProperties -> electroProperties.$variant)"

# -------------------------
# Mesh and anatomy field preparation
# -------------------------

# The mesh and its anatomy fields, shared with the sibling cases in
# ../../mesh/, are already scaled to adult-heart-scale SI metres - just copy
# them in. The graph itself is not modified by either pathology variant here
# (unlike conductionBlock), so it's copied straight in under its normal name.
# The heart mesh and its anatomy fields are written from the heart/torso mesh
# ../../mesh/heartTorso (Git LFS), the one committed geometry, by
# ../../prepareHeartMesh; it stops with a readable message if that mesh is a
# Git-LFS pointer, and does nothing when its output is current.
../../prepareHeartMesh

cp -a ../../mesh/constant/polyMesh constant/polyMesh

# git does not track empty directories, so a case whose 0/ holds nothing
# tracked has no 0/ at all in a fresh checkout and every copy below fails
# with "No such file or directory" - the solver then dies and the
# regression reports "missing output file". Create the destinations first.
mkdir -p 0

# Only Conductivity and tm are read by this case: Conductivity by name in
# monodomainSolver, and tm by setExprFields below to derive t. fiber,
# sheet, sheetNormal, tv and apicobasal are referenced by neither the
# solver nor this case's dictionaries - apicobasal is needed only where a
# gradientAxes block exists, which this case does not have.
cp ../../mesh/0/tm 0/tm
cp ../../mesh/0/Conductivity 0/Conductivity
cp ../../mesh/constant/purkinjeGraph constant/purkinjeGraph

# tm is 0 at epicardium and 1 at endocardium in this mesh. The ionic
# heterogeneity band lookup requires the opposite orientation (0 at
# endocardium, 1 at epicardium), so derive t = 1 - tm for it to read.
runApplication setExprFields

# -------------------------
# Run solver
# -------------------------

if $parallelRun; then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar
    runApplication redistributeRestartState
else
    runApplication cardiacFoam
fi
