FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource field;
    chi         [ 0 -1 0 0 0 0 0 ] 140000;
    cm          [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel  TNNP;
    tissue      epicardialCells;

    ionicHeterogeneity
    {
        field             t;
        mode              transmuralBands;
        endoMInterface    0.3;
        mEpiInterface     0.7;
        transitionWidth   0;
        transitionMode    hard;
        smoothing         smoothstep;
    }

    // Brugada Syndrome parametrisation (Ten Tusscher-Noble-Noble-Panfilov
    // 2004), same as tutorials/PATHOS/BrugadaSyndrome.
    // SCN5A loss-of-function:  g_Na reduced 80 % across all tissue types.
    // I_to gain-of-function:   g_to x6 in epicardium only.
    // This tips the plateau past the bifurcation point, causing complete
    // dome loss in epicardial cells and transmural dispersion of
    // repolarisation.
    // Reference values: Coronel et al. 2009, Shimizu & Antzelevitch 1999.
    ionicConstantOverrides
    {
        global
        {
            scale
            {
                g_Na    0.2;
            }
        }
        epicardialCells
        {
            scale
            {
                g_to    6.0;
                g_CaL   0.5;
            }
        }
    }

    solutionAlgorithm explicit;
    solver            RKF45;
    maxSteps          1000000000;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;

                ionicModel             BuenoOrovio;
                tissue                 epicardialCells;

                chi                    14000;
                cm                     0.01;
                purkinjeConductivity   10.0;
                vm1DRest               -0.084;

                rootStimulus
                {
                    node      0;
                    startTime 0.0;
                    duration  0.002;
                    intensity 500000.0;
                }

                solver         RKF45;
                maxSteps       1000000000;

                outputVariables
                {
                    export (Vm activationTime Icoupling);
                    debug  (Vm Iion);
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    reactionDiffusionPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            rPvj                    1000;
            pvjRadius               2.5e-3;
            couplingMode            unidirectional;
            debugCoupling           true;
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver pseudoECG;
            sigmaExtracellular 0.2;

            electrodePositions
            {
                V1 (0.015716  0.005708  -0.073831);
                V2 (0.033206 -0.023525  -0.056927);
                V3 (0.052927 -0.027237  -0.044977);
                V4 (0.070759 -0.041274  -0.018468);
                V5 (0.073891 -0.055458   0.008801);
                V6 (0.069582 -0.064013   0.029485);
            }
        }
    }
}

// ************************************************************************* //
