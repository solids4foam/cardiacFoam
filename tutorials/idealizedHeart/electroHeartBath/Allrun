#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# -------------------------
# Run selection
# -------------------------
#   qrs (default) - endTime 0.04, the electroHeart window; used by the
#                   regression.
#   fullBeat      - endTime 0.4, QRS and T wave, for local runs.
#   parallel      - decompose, run cardiacFoam in parallel, reconstruct.
duration="qrs"
parallelRun=false
for arg in "$@"; do
    case "$arg" in
        qrs|fullBeat) duration="$arg" ;;
        parallel)     parallelRun=true ;;
    esac
done

ln -sf "controlDict.$duration" system/controlDict
echo "Active controlDict: $duration (system/controlDict -> controlDict.$duration)"

# -------------------------
# Heart+torso mesh and fields
# -------------------------
# ../mesh/heartTorso holds the heart+torso mesh with its cellZones and every
# field the run reads, written once by meshGeneration/Allmesh. The Purkinje
# tree is the shared heart's: the heart cells and coordinates are unchanged.
if head -c 40 ../mesh/heartTorso/constant/polyMesh/points 2>/dev/null \
    | grep -q "git-lfs.github.com"; then
    echo "ERROR: ../mesh holds Git-LFS pointer files, not the real mesh." 1>&2
    echo "       Run 'git lfs install && git lfs pull' and retry." 1>&2
    exit 1
fi

cp -a ../mesh/heartTorso/constant/polyMesh constant/polyMesh
mkdir -p 0
cp ../mesh/heartTorso/0/* 0/
cp ../mesh/constant/purkinjeGraph constant/purkinjeGraph

if $parallelRun; then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar
else
    runApplication cardiacFoam
fi
