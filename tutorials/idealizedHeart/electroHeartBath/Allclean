#!/bin/bash

cd "${0%/*}" || exit 1

rm -f log.*
rm -f constant/electroProperties.withDefaultValues
# Explicit fallback for solved time directories: solver output, never
# source data.
find . -maxdepth 1 -regex '\./-?[0-9]+\(\.[0-9]+\)?' ! -name '0' -exec rm -rf {} +
rm -rf processor* postProcessing

# The mesh, the 0/ fields and the Purkinje tree are copied in by Allrun from
# ../mesh, not source in this case directory.
rm -rf constant/polyMesh constant/purkinjeGraph 0
rm -f system/controlDict
