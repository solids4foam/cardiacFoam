FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setCardiacConductivityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// cardiacCore setCardiacConductivity input. Each tensor is
// df f f + ds s s + dn n n in the fibre (f), sheet (s) and sheet-normal
// (n = f x s) frame; torso cells carry f = s = 0 and get a zero tensor.
//
// Bidomain set: the per-direction ratios ge/gi of Johnston, "Six
// conductivity values to use in the bidomain model of cardiac tissue",
// IEEE TBME 63(7), 2016 (nominal 0.24/0.24, 0.035/0.20, 0.008/0.11 S/m),
// with gi and ge scaled together in each direction so that the
// monodomain-equivalent gi ge/(gi + ge) equals the electroHeart
// Conductivity (0.5, 0.1, 0.1).

df          0.5;
ds          0.1;
dn          0.1;

conductivityIntracellular
{
    df      1.0;
    ds      0.1175;
    dn      0.107272727272727;
}

conductivityExtracellular
{
    df      1.0;
    ds      0.671428571428571;
    dn      1.475;
}

fiberField  "fiber";
sheetField  "sheet";

