FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.0;
    }

    "phiE|phiEFinal|phiI|phiIFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.0;
        maxIter         5000;
    }
}

PIMPLE
{
    // The global heart+torso phiE is advanced outside the PIMPLE outer loop;
    // both phiE and Vm reassemble the corrected Laplacian once for the
    // non-orthogonal tetrahedra.
    nOuterCorrectors         1;
    nNonOrthogonalCorrectors 1;
}

