FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource field;
    chi         [ 0 -1 0 0 0 0 0 ] 140000;
    cm          [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel  BuenoOrovio;
    tissue      epicardialCells;

    ionicHeterogeneity
    {
        mode              namedRegions;
        field             t;
        transitionMode    blend;
        transitionWidth   0.1;
        smoothing         smoothstep;
        regions
        {
            endocardialCells { range (0 0.3); }
            mCells           { range (0.3 0.7); }
            epicardialCells  { range (0.7 1); }
        }

        // Apex-to-base APD gradient (composes with the named regions
        // above): APD shorter at the apex, longer at the base, matching the
        // consistently reported direction in the literature (e.g. Opthof
        // et al., J Cardiovasc Electrophysiol; Sengupta et al., Circulation
        // Cardiovasc Imaging). apicobasal follows the same 0=apex/1=base
        // convention this tutorial already uses for Purkinje-tree UVCs (see
        // README), so it is used directly as the distance field, no
        // inversion needed. tauSi is the primary APD-determining time
        // constant in the Bueno-Orovio-Cherry-Fenton minimal model;
        // scalingMin/scalingMax were calibrated against single-cell APD90
        // measurements (RKF45, S1 pacing) to target the ~20ms total
        // apex-base gradient commonly used in simulation studies, not the
        // library's generic wide-range defaults.
        gradientAxes
        {
            apicobasal
            {
                field       apicobasal;
                beta        1.2;
                scalingMin  0.97;
                scalingMax  1.04;
                variables   (tauSi);
            }
        }
    }

    solutionAlgorithm explicit;
    solver            RKF45;
    maxSteps          1000000000;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;

                ionicModel             BuenoOrovio;
                tissue                 epicardialCells;

                chi                    14000;
                cm                     0.01;
                // Purkinje conduction velocity ~3.3 m/s, matching the hybrid variant's
                // calibrated restitution maximum (3.33 m/s); 10.0 gave ~8.7 m/s.
                purkinjeConductivity   0.4;
                vm1DRest               -0.084;

                rootStimulus
                {
                    node      0;
                    startTime 0.0;
                    duration  0.002;
                    intensity 500000.0;
                }

                solver         RKF45;
                maxSteps       1000000000;

                outputVariables
                {
                    export (Vm activationTime Icoupling);
                    debug  (Vm Iion);
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    reactionDiffusionPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            rPvj                    1000;
            // Smallest radius valid at every junction of both Purkinje trees:
            // the coarsest junction cell (pig tree, mid-wall) is 1.60 mm across.
            pvjRadius               1.65e-3;
            couplingMode            unidirectional;
            debugCoupling           true;
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver pseudoECG;
            sigmaExtracellular 0.2;

            electrodePositions
            {
                V1 (0.010407  0.056280  -0.050468);
                V2 (0.030086  0.016628  -0.061925);
                V3 (0.052524 -0.019359  -0.050439);
                V4 (0.070768 -0.037057  -0.026220);
                V5 (0.073474 -0.043547  -0.003609);
                V6 (0.068323 -0.043011   0.018866);
            }
        }
    }
}

// ************************************************************************* //
