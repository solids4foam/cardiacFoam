FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Eikonal variant: both the 3D myocardium and the 1D Purkinje network are
// eikonal (activation-time-only) solves - the cheapest of electroHeart's
// three solver combinations. Field/graphFile names and electrode positions
// follow this tutorial's own convention (see ../electroProperties.monodomain).

myocardiumSolver eikonalSolver;

eikonalSolverCoeffs
{
    conductivitySource field;
    chi         [ 0 -1 0 0 0 0 0 ] 140000;
    cm          [ -1 -4 4 0 0 2 0 ] 0.01;
    c0          [ 0 0 -0.5 0 0 0 0 ] 60;

    eikonalAdvectionDiffusionApproach true;
    useGraphPrePopulation true;
    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    // No intramural box stimulus: activation is seeded exclusively through
    // the Purkinje graph's rootStimulus below.
    stimulusLocationMin (1e6 1e6 1e6);
    stimulusLocationMax (1e6 1e6 1e6);

    ionicHeterogeneity
    {
        mode              namedRegions;
        field             t;
        transitionMode    blend;
        transitionWidth   0.1;
        smoothing         smoothstep;
        regions
        {
            endocardialCells { range (0 0.3); }
            mCells           { range (0.3 0.7); }
            epicardialCells  { range (0.7 1); }
        }
    }

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver eikonalSolver1D;
                graphFile              purkinjeGraph;

                // Matches the hybrid variant's calibrated restitution maximum.
                purkinjeCV  [ 0 1 -1 0 0 0 0 ] 3.33;
                chi         14000;
                cm          0.01;
                vm1DRest    -0.084;

                rootStimulus
                {
                    node      0;
                    startTime 0.0;
                }

                outputVariables
                {
                    export (activationTime);
                    debug  ();
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    eikonalPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            // Smallest radius valid at every junction of both Purkinje trees:
            // the coarsest junction cell (pig tree, mid-wall) is 1.60 mm across.
            pvjRadius               1.65e-3;
            couplingMode            unidirectional;
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver eikonalECG;
            sigmaExtracellular 0.2;

            sampling
            {
                start  0;
                end    0.04;
                deltaT 1e-4;
            }

            electrodePositions
            {
                V1 (0.010407  0.056280  -0.050468);
                V2 (0.030086  0.016628  -0.061925);
                V3 (0.052524 -0.019359  -0.050439);
                V4 (0.070768 -0.037057  -0.026220);
                V5 (0.073474 -0.043547  -0.003609);
                V6 (0.068323 -0.043011   0.018866);
            }
        }
    }
}

// ************************************************************************* //
