#!/bin/bash

# Source OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# -------------------------
# Variant selection
# -------------------------
# Three solver combinations on the same mesh, same anatomy:
#   monodomain (default) - monodomainSolver + monodomain1DSolver (full
#     reaction-diffusion myocardium, full-cable Purkinje). The original
#     healthy baseline; unchanged, always the default with no argument.
#   eikonal   - eikonalSolver + eikonalSolver1D (both domains eikonal,
#     cheapest combination).
#   hybrid    - monodomainSolver + restitutionEikonalSolver1D (full 3D
#     myocardium, eikonal 1D Purkinje - the middle ground).
variant="monodomain"
parallelRun=false
for arg in "$@"; do
    case "$arg" in
        monodomain|eikonal|hybrid) variant="$arg" ;;
        parallel)                  parallelRun=true ;;
    esac
done

ln -sf "electroProperties.$variant" constant/electroProperties
echo "Active solver variant: $variant (constant/electroProperties -> electroProperties.$variant)"

# controlDict is still per-variant, but all three now share endTime 0.04.
# The probe activations were re-measured: monodomain at 19.4ms, hybrid's
# eikonal-Purkinje-to-monodomain coupling at 31.3ms (an earlier note here
# claimed ~100ms; that was not borne out). 0.04 clears both with margin and
# keeps the variants comparable. eikonal is unaffected either way - it
# overrides the case time controls and solves one steady problem, writing
# only time 1.
ln -sf "controlDict.$variant" system/controlDict
echo "Active controlDict: $variant (system/controlDict -> controlDict.$variant)"

# -------------------------
# Mesh and anatomy field preparation
# -------------------------

# The mesh and its anatomy fields are the single copy shared with the
# sibling electroMechHeart case, kept once in ../mesh/ to avoid
# tracking the same ~10MB mesh twice in git. The mesh in ../mesh/ is
# already scaled to adult-heart-scale SI metres - just copy it in.
# Guard: if the shared mesh is still a Git-LFS pointer (a clone or CI
# checkout made without LFS), fail here with a readable message instead of
# letting cardiacFoam die later on an unparsable mesh.
if head -c 40 ../mesh/constant/polyMesh/points 2>/dev/null \
    | grep -q "git-lfs.github.com"; then
    echo "ERROR: ../mesh holds Git-LFS pointer files, not the real mesh." 1>&2
    echo "       Run 'git lfs install && git lfs pull' and retry." 1>&2
    exit 1
fi

cp -a ../mesh/constant/polyMesh constant/polyMesh

# git does not track empty directories, so a case whose 0/ holds nothing
# tracked has no 0/ at all in a fresh checkout and every copy below fails
# with "No such file or directory" - the solver then dies and the
# regression reports "missing output file". Create the destinations first.
mkdir -p 0

cp ../mesh/0/fiber 0/fiber
cp ../mesh/0/sheet 0/sheet
cp ../mesh/0/sheetNormal 0/sheetNormal
cp ../mesh/0/tm 0/tm
cp ../mesh/0/tv 0/tv
cp ../mesh/0/apicobasal 0/apicobasal
cp ../mesh/0/Conductivity 0/Conductivity
cp ../mesh/constant/purkinjeGraph constant/purkinjeGraph

# tm is 0 at epicardium and 1 at endocardium in this mesh. The ionic
# heterogeneity band lookup requires the opposite orientation (0 at
# endocardium, 1 at epicardium), so derive t = 1 - tm for it to read.
runApplication setExprFields

if $parallelRun; then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar
else
    runApplication cardiacFoam
fi

if [ "${CF_SKIP_PLOTS:-1}" = "1" ]; then
    echo "Skipping pseudoECG plot generation (CF_SKIP_PLOTS=1)."
elif [ "$variant" = "eikonal" ]; then
    python3 plot_pseudo_ecg.py --case-dir . --eikonal
else
    python3 plot_pseudo_ecg.py --case-dir . --monodomain
fi
