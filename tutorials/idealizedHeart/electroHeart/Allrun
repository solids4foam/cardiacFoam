#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# -------------------------
# Variant selection
# -------------------------
# Three solver combinations on the same mesh, same anatomy:
#   monodomain (default) - monodomainSolver + monodomain1DSolver (full
#     reaction-diffusion myocardium, full-cable Purkinje). The original
#     healthy baseline; unchanged, always the default with no argument.
#   eikonal   - eikonalSolver + eikonalSolver1D (both domains eikonal,
#     cheapest combination).
#   hybrid    - monodomainSolver + restitutionEikonalSolver1D (full 3D
#     myocardium, eikonal 1D Purkinje - the middle ground).
#
# Purkinje tree selection, independent of the variant:
#   human (default) - ../mesh/constant/purkinjeGraph, every terminal on the
#     endocardial surface.
#   pig             - ../mesh/constant/purkinjeGraphPig, same seeds and growth
#     but pig terminals: LV weighted subendocardial/intramural selection and
#     transmural insertion into the wall on both ventricles.
variant="monodomain"
purkinjeTree="human"
parallelRun=false
for arg in "$@"; do
    case "$arg" in
        monodomain|eikonal|hybrid) variant="$arg" ;;
        human|pig)                 purkinjeTree="$arg" ;;
        parallel)                  parallelRun=true ;;
        *) echo "Unknown argument '$arg'. Use monodomain, eikonal or hybrid, human or pig, and/or parallel." ; exit 1 ;;
    esac
done

ln -sf "electroProperties.$variant" constant/electroProperties
echo "Active solver variant: $variant (constant/electroProperties -> electroProperties.$variant)"

# system/controlDict is shared by the three variants (endTime 0.04). The
# regression probe activates at 28.6ms (monodomain) and 28.9ms (hybrid) on the
# human tree, 32.5ms and 34.5ms on the pig tree; 0.04 clears all four. eikonal
# overrides the case time controls and solves one steady problem, writing only
# time 1.

# -------------------------
# Mesh and anatomy field preparation
# -------------------------

# The mesh and its anatomy fields, shared with the sibling cases in ../mesh/,
# are already scaled to adult-heart-scale SI metres - just copy them in.
# The heart mesh and its anatomy fields are written from the heart/torso mesh
# ../mesh/heartTorso (Git LFS), the one committed geometry, by
# ../prepareHeartMesh; it stops with a readable message if that mesh is a
# Git-LFS pointer, and does nothing when its output is current.
../prepareHeartMesh

cp -a ../mesh/constant/polyMesh constant/polyMesh

# git does not track empty directories, so a case whose 0/ holds nothing
# tracked has no 0/ at all in a fresh checkout and every copy below fails
# with "No such file or directory" - the solver then dies and the
# regression reports "missing output file". Create the destinations first.
mkdir -p 0

cp ../mesh/0/fiber 0/fiber
cp ../mesh/0/sheet 0/sheet
cp ../mesh/0/sheetNormal 0/sheetNormal
cp ../mesh/0/tm 0/tm
cp ../mesh/0/tv 0/tv
cp ../mesh/0/apicobasal 0/apicobasal
cp ../mesh/0/Conductivity 0/Conductivity
if [ "$purkinjeTree" = "pig" ]; then
    cp ../mesh/constant/purkinjeGraphPig constant/purkinjeGraph
else
    cp ../mesh/constant/purkinjeGraph constant/purkinjeGraph
fi
echo "Purkinje tree: $purkinjeTree"

# tm is 0 at epicardium and 1 at endocardium in this mesh. The ionic
# heterogeneity band lookup requires the opposite orientation (0 at
# endocardium, 1 at epicardium), so derive t = 1 - tm for it to read.
runApplication setExprFields

if $parallelRun; then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar
    runApplication redistributeRestartState
else
    runApplication cardiacFoam
fi
