// Single probe on the LV free wall at a Purkinje-myocardial-junction site,
// picked from the shared purkinjeGraph (node 211): the PMJ with the
// earliest healthy activation time (~3.6ms, see PVJ diagnostic notes) whose
// downstream tissue is fully cut off from the root in conductionBlock's
// lbbb variant (severed LV subtree, no alternate path in the tree graph).
// Regression uses this same point/probe in both electroHeart
// (healthy - confirms Purkinje-to-myocardium injection fires and reaches
// tissue) and conductionBlock lbbb (confirms it does not, since the LBB
// bridge disconnects this subtree from the root entirely).

type            probes;
libs            ("libsampling.so");
enabled         true;

writeControl    writeTime;

fields
(
    Vm
    activationTime
);

probeLocations
(
    (0.02395 0.01743 -0.00191)
);

