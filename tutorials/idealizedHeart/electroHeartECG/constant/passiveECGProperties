FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object passiveECGProperties;
}

maxCorrectors 200;
absoluteTolerance 1e-11;
relativeTolerance 1e-8;
maxLinearResidual 1e-11;
bidomainSolverCoeffs
{
    cellZone myocardium;
    sealedHeartBoundary true;
    bathHeartPhiETrace global;
    conductivitySource field;
    chi [0 -1 0 0 0 0 0] 140000;
    cm [-1 -4 4 0 0 2 0] 0.01;
    ionicModel BuenoOrovio;
    tissue epicardialCells;
    solutionAlgorithm implicit;
    solver RKF45;
    maxSteps 1000000000;
}
bathPotentialDomain
{
    #include "torsoConductor"
}
