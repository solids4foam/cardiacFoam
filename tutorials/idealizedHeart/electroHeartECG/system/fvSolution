FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    "Vm|VmFinal" { solver PCG; preconditioner DIC; tolerance 1e-11; relTol 0; }
    leadPotential
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-12;
        relTol 0;
        maxIter 5000;
    }
    "phiE|phiEFinal|phiI|phiIFinal|leadPotential_.*"
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-12;
        relTol 0;
        maxIter 5000;
    }
}
PIMPLE
{
    nOuterCorrectors 2;
    nNonOrthogonalCorrectors 1;
}
