FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    //default         CrankNicolson 1.0;
    default         backward; // 2nd order
    //default         Euler; // 1st order
}

gradSchemes
{
    default         leastSquares;
    // Eikonal variant only: advection direction and eikonal ECG activation gradient
    grad(activationTime)   Gauss linear;
    // Eikonal variant only: bounded reconstruction of div(phiU,activationTime)
    limitedGrad     cellMDLimited leastSquares 1;
}

divSchemes
{
    default         none;
    div(phiU,psi)   Gauss linear;
    // Eikonal variant only: c0 |grad psi|_M as a bounded convection term
    div(phiU,activationTime)   Gauss linearUpwind limitedGrad;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}


