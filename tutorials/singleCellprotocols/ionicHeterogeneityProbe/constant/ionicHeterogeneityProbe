FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      ionicHeterogeneityProbe;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nSamples        101;
duration        800;
dt              0.2;
writeEvery      5;

minAmplitude    50;
minPeak         0;
checkSecondaryRise false;
maxRecoveryRise 5;
maxAPDJump      30;
maxWaveformRMS  15;
checkAPDEnvelope true;
failOnAPDEnvelope true;
maxAPDBoundTolerance 5;

singleCellStimulus
{
    stim_start      20;
    stim_duration   1;
    stim_amplitude  0.4;
    stim_period_S1  1000;
    nstim1          1;
    stim_period_S2  0;
    nstim2          0;
}

