FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
myocardiumSolver singleCellSolver;
singleCellSolverCoeffs
{

    // Cell model selection

    ionicModel    TWorld;
    tissue        epicardialCells;


    // Time integration settings

    solver          RKF45;
    initialODEStep  1e-5;
    maxSteps        1000000000;
    absTol          1e-6;
    relTol          1e-4;


    // Stimulus protocol
    singleCellStimulus
    {
        stim_start      20;
        stim_duration   1;
        stim_amplitude  60;
        stim_period_S1  1000;
        nstim1          2;
        stim_period_S2  0;
        nstim2          0;
    }



    // optional I/O control

    writeAfterTime  0;

    outputVariables
    {
        ionic
        {
            export (Vm cai);
            debug (Vm);
        }
        activeTension
        {
            export (AV_Ta);
        }
    }

    activeTensionModel LandNiederer;
}
