FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 1D-3D eikonal: PATHOS Healthy Human Tree Purkinje graph (root node 0,
// 2529 PVJ sites) coupled to the 3D myocardium via eikonalPvjCoupler.
// Activation seeded exclusively through rootStimulus at node 0 (His bundle).

myocardiumSolver eikonalSolver;

eikonalSolverCoeffs
{
    chi         [0 -1 0 0 0 0 0] 140000;
    cm          [-1 -4 4 0 0 2 0] 0.01;
    c0          [0 0 -0.5 0 0 0 0] 60;

    conductivitySource field;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;
    eikonalAdvectionDiffusionApproach true;
    reportSetup true;

    // No intramural box stimulus: Purkinje graph deposits activation constraints.
    stimulusLocationMin (1e6 1e6 1e6);
    stimulusLocationMax (1e6 1e6 1e6);

    ionicHeterogeneity
    {
        field             uvc_transmural;
        mode              transmuralBands;
        endoMInterface    0.3;
        mEpiInterface     0.7;
        transitionWidth   0.1;
        transitionMode    blend;
        smoothing         smoothstep;
    }

    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver eikonalSolver1D;
                graphFile              purkinjeGraph_healthy;

                c0          [0 1 -1 0 0 0 0] 4.2;
                chi         14000;
                cm          0.01;
                vm1DRest    -0.084;
                reportSetup false;

                rootStimulus
                {
                    node      0;
                    startTime 0.0;
                }

                outputVariables
                {
                    export (activationTime);
                    debug  ();
                }
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            electroDomainCoupler    eikonalPvjCoupler;
            conductionNetworkDomain purkinjeNetwork;
            pvjRadius               6e-4;
            couplingMode            unidirectional;
            reportSetup             false;
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver eikonalECG;
	    sigmaExtracellular 0.2;

            sampling
            {
                start  0;
                end    0.6;
                deltaT 1e-4;
            }

            electrodePositions
            {
                V1 (0.047864   0.05969    -0.10536);
                V2 (0.08917    0.08074    -0.14187);
                V3 (0.10940    0.0684336  -0.169305);
                V4 (0.131631   0.073495   -0.21842);
                V5 (0.132433   0.11248    -0.290978);
                V6 (0.137525   0.0933918  -0.26164);
            }
        }
    }
}

