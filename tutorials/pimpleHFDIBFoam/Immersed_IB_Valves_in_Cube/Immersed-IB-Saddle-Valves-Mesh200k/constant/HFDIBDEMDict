        // bottomCenter = annulus → fixed side
        fixedEnd  bottom;

        period    1;
        timeLaw   threeWindow;

        // Your shifted timings
        // original: openWindow (0.645 0.675); close2Window (0.950 1.000);
	close1Window (0.000 0.010);
	//close1Window (0.000 0.005);
	//openWindow (0.645 0.675);
	//close2Window (0.950 1.000);
