    }

    sdBasedLambda   false;
    interfaceSpan   1.0;
    startSynced     false;
    refineBuffers   2;
    timesToSetStatic -1;

    // -------- Prescribed valve motion (AORTIC, geodesic-ξ axis) --------
    deformingBody_mitral_ref   // keep this name if C++ expects it
