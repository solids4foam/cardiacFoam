FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}

dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs
(
    "libfvMotionSolvers.so"
    "libdecayingTaylorGreenVortexMeshMotion.so"
);

solver          decayingTaylorGreenVortexMeshMotion;

decayingTaylorGreenVortexMeshMotionCoeffs
{
    scaleFactor             0.15;
    orthogonalMeshMotion    no;

    xMin                    0.0;
    xMax                    24.0;
    yMin                    0.0;
    yMax                    4.1;

    period                  1;
}
