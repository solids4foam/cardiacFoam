#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# -------------------------------------------------------------------------
# cardiacFoam regression test driver
#
# Copies regression test cases to a separate directory and
# runs them there to avoid polluting the original tutorials.
#
# Usage: Alltest-regression [-l | --list] [-h | --help] [pattern ...]
#
#   pattern    run only the cases whose path (relative to tutorials/)
#              contains one of the given substrings, e.g.
#              "Alltest-regression bidomain purkinje"
#   -l, --list list the regression cases and exit
# -------------------------------------------------------------------------

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REG_ROOT="${ROOT_DIR}/../tutorialsTest-regression"

# List of regression test directories (relative to tutorials/)
REGRESSION_TESTS=(
    "electrophysiologyProtocols/singleCell"
    "electrophysiologyProtocols/ionicHeterogeneity"
    "NiedererEtAl2011/NiedererEtAl2011verification"
    "NiedererEtAl2011/electroMechanicalNiedererEtAl2011"
    "manufacturedSolutions/bidomain"
    "manufacturedSolutions/monodomainPseudoECG"
    "manufacturedSolutions/eikonalECG"
    "manufacturedSolutions/bathBidomain"
    "manufacturedSolutions/monodomainTotalLagrangianEM"
    "electrophysiologyProtocols/rotorInstability"
    "electrophysiologyProtocols/purkinjeRestitution2D"
    "idealizedHeart/electroHeart"
    "idealizedHeart/electroMechHeart"
    "idealizedHeart/pathos/conductionBlock"
)

usage()
{
    sed -n '/^# Usage:/,/^# ----/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
}

listOnly=0
patterns=()

while (( $# > 0 )); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -l|--list)
            listOnly=1
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            exit 2
            ;;
        *)
            patterns+=("$1")
            ;;
    esac
    shift
done

# Select the cases matching any pattern (all cases when none is given)
selectedTests=()
for testCase in "${REGRESSION_TESTS[@]}"; do
    if (( ${#patterns[@]} == 0 )); then
        selectedTests+=("${testCase}")
        continue
    fi
    for pattern in "${patterns[@]}"; do
        if [[ "${testCase}" == *"${pattern}"* ]]; then
            selectedTests+=("${testCase}")
            break
        fi
    done
done

if (( ${#selectedTests[@]} == 0 )); then
    echo "FAIL: no regression case matches: ${patterns[*]}"
    exit 2
fi

if (( listOnly )); then
    printf '%s\n' "${selectedTests[@]}"
    exit 0
fi

echo "============================================================"
echo "cardiacFoam regression tests"
echo "============================================================"

# Create regression root directory, with the shared helpers the
# regressionTest.sh scripts source
rm -rf "${REG_ROOT}"
mkdir -p "${REG_ROOT}"
cp -a "${ROOT_DIR}/regressionFunctions" "${REG_ROOT}/"

failures=0
skips=0
unexpected_skips=0
build_mode="${CARDIAC_REGRESSION_BUILD_MODE:-}"

case "${build_mode}" in
    with-solids4foam)
        ;;
    lightweight)
        ;;
    *)
        echo "FAIL: CARDIAC_REGRESSION_BUILD_MODE must be 'with-solids4foam' or 'lightweight'."
        exit 2
        ;;
esac

# Regression cases that need cardiacFoam built with solids4foam. In
# lightweight mode their regressionTest.sh exits 77 and the skip is expected;
# in with-solids4foam mode any skip is a failure.
FULL_SOLIDS4FOAM_ONLY_TESTS=(
    "NiedererEtAl2011/electroMechanicalNiedererEtAl2011"
    "manufacturedSolutions/monodomainTotalLagrangianEM"
    "idealizedHeart/electroMechHeart"
)

# Regression cases known to be broken on one OpenFOAM version, as
# "<version> <case>". Their regressionTest.sh exits 77 on that version, and
# the skip is expected there in either build mode.
VERSION_SKIP_TESTS=(
    "v2312 manufacturedSolutions/bathBidomain"
)

isExpectedSkip()
{
    local skipped_case="$1"
    local fullOnlyCase
    local versionSkip

    for versionSkip in "${VERSION_SKIP_TESTS[@]}"; do
        if [[ "${versionSkip}" == "${WM_PROJECT_VERSION:-} ${skipped_case}" ]]; then
            return 0
        fi
    done

    [[ "${build_mode}" == "lightweight" ]] || return 1

    for fullOnlyCase in "${FULL_SOLIDS4FOAM_ONLY_TESTS[@]}"; do
        if [[ "${skipped_case}" == "${fullOnlyCase}" ]]; then
            return 0
        fi
    done

    return 1
}

for testCase in "${selectedTests[@]}"; do
    echo
    echo "------------------------------------------------------------"
    echo "Running regression test: ${testCase}"
    echo "------------------------------------------------------------"

    SRC_CASE="${ROOT_DIR}/${testCase}"
    DST_CASE="${REG_ROOT}/${testCase}"

    # Copy test case (fresh copy each time)
    rm -rf "${DST_CASE}"
    mkdir -p "$(dirname "${DST_CASE}")"
    cp -a "${SRC_CASE}" "${DST_CASE}"

    # idealizedHeart/* cases read their shared mesh and anatomy fields from
    # a mesh/ directory at the idealizedHeart/ root (not tracked per-case,
    # to avoid committing the same ~10MB mesh twice - see
    # tutorials/idealizedHeart/README.md). That sibling isn't part of this
    # single-directory copy, so bring it in once per sweep.
    if [[ "${testCase}" == idealizedHeart/* && "${testCase}" != "idealizedHeart/mesh" ]]; then
        MESH_DST="${REG_ROOT}/idealizedHeart/mesh"
        if [[ ! -d "${MESH_DST}" ]]; then
            cp -a "${ROOT_DIR}/idealizedHeart/mesh" "${MESH_DST}"
        fi
    fi

    cd "${DST_CASE}"

    if [[ ! -x ./regression/regressionTest.sh ]]; then
        echo "FAIL: regressionTest.sh not found or not executable in ${testCase}"
        failures=$((failures + 1))
        continue
    fi

    if ./regression/regressionTest.sh; then
        echo "PASS: regression test passed in ${testCase}"
    else
        rc=$?
        if (( rc == 77 )); then
            skips=$((skips + 1))
            if isExpectedSkip "${testCase}"; then
                echo "EXPECTED SKIP: regression test skipped in ${testCase}"
            else
                echo "FAIL: unexpected regression-test skip in ${testCase}"
                unexpected_skips=$((unexpected_skips + 1))
            fi
            continue
        fi

        echo "FAIL: regression test failed in ${testCase}"
        failures=$((failures + 1))
    fi
done

echo
echo "============================================================"

if (( failures > 0 || unexpected_skips > 0 )); then
    echo "Regression tests FAILED (${failures} failing case(s), ${unexpected_skips} unexpected skip(s), ${skips} total skip(s))"
    exit 1
elif (( skips > 0 )); then
    echo "Regression tests PASSED WITH EXPECTED SKIPS (${skips} expected skip(s))"
    exit 0
else
    echo "All regression tests PASSED (no skips)"
    exit 0
fi
