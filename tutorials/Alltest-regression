#!/usr/bin/env bash
set -Eeuo pipefail

# -------------------------------------------------------------------------
# cardiacFoam regression test driver
#
# Discovers every case under tutorials/ that carries
# regression/regressionTest.sh, copies it to ../tutorialsTest-regression
# without generated output, and runs its regression script there.
#
# Usage:
#   Alltest-regression [--list] [--only PATTERN]...
#
#   --list          print the discovered cases and exit; no build mode needed
#   --only PATTERN  run only cases whose path matches the extended regular
#                   expression PATTERN (repeatable)
#
# Environment:
#   CARDIAC_REGRESSION_BUILD_MODE  with-solids4foam | lightweight (required)
#   CARDIAC_REGRESSION_SCOPE       passed through to the cases, see
#                                  regression/lib.sh
#
# A case that needs cardiacFoam built with solids4foam carries an empty
# marker file regression/needs-solids4foam: in lightweight mode it exits 77
# and the skip is expected. A case that cannot run on some OpenFOAM versions
# lists them, one per line, in regression/skips-on-openfoam (for example
# v2312): on those versions its exit 77 is expected. Any other exit 77 fails
# the run.
# -------------------------------------------------------------------------

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REG_ROOT="${ROOT_DIR}/../tutorialsTest-regression"
MARKER="regression/needs-solids4foam"
VERSION_SKIPS="regression/skips-on-openfoam"

listOnly=0
onlyPatterns=()
while (( $# > 0 )); do
    case "$1" in
        --list) listOnly=1 ;;
        --only)
            (( $# >= 2 )) || { echo "FAIL: --only requires a pattern" >&2; exit 2; }
            onlyPatterns+=("$2"); shift ;;
        -h|--help) sed -n '4,27p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "FAIL: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# ---- discovery -----------------------------------------------------------

discoverCases()
{
    find "${ROOT_DIR}" -path '*/regression/regressionTest.sh' \
        -not -path '*/results/*' -not -path '*/.tmp/*' \
        | sed -e "s|^${ROOT_DIR}/||" -e 's|/regression/regressionTest.sh$||' \
        | sort
}

ALL_CASES=()
while IFS= read -r c; do ALL_CASES+=("$c"); done < <(discoverCases)

CASES=()
for c in "${ALL_CASES[@]}"; do
    if (( ${#onlyPatterns[@]} > 0 )); then
        keep=0
        for p in "${onlyPatterns[@]}"; do [[ "$c" =~ $p ]] && keep=1; done
        (( keep )) || continue
    fi
    CASES+=("$c")
done

needsSolids4Foam()
{
    [[ -e "${ROOT_DIR}/$1/${MARKER}" ]]
}

skipsThisVersion()
{
    [[ -f "${ROOT_DIR}/$1/${VERSION_SKIPS}" ]] \
        && grep -qx -- "${WM_PROJECT_VERSION:-}" "${ROOT_DIR}/$1/${VERSION_SKIPS}"
}

expectedSkip()
{
    { [[ "${build_mode}" == "lightweight" ]] && needsSolids4Foam "$1"; } || skipsThisVersion "$1"
}

if (( listOnly )); then
    for c in "${CASES[@]}"; do
        tag=""
        needsSolids4Foam "$c" && tag="${tag}  (needs-solids4foam)"
        [[ -f "${ROOT_DIR}/$c/${VERSION_SKIPS}" ]] && tag="${tag}  (skips on: $(tr '\n' ' ' < "${ROOT_DIR}/$c/${VERSION_SKIPS}" | sed 's/ $//'))"
        echo "$c${tag}"
    done
    exit 0
fi

build_mode="${CARDIAC_REGRESSION_BUILD_MODE:-}"
case "${build_mode}" in
    with-solids4foam|lightweight) ;;
    *)
        echo "FAIL: CARDIAC_REGRESSION_BUILD_MODE must be 'with-solids4foam' or 'lightweight'."
        exit 2
        ;;
esac

echo "============================================================"
echo "cardiacFoam regression tests (${build_mode}, ${#CASES[@]} case(s))"
echo "============================================================"

rm -rf "${REG_ROOT}"
mkdir -p "${REG_ROOT}"

# The case scripts source the shared library by walking up from the case,
# so it travels with the copies.
cp -a "${ROOT_DIR}/regression" "${REG_ROOT}/regression"

# ---- copying a case without its generated output ------------------------

# copyCase <case>: copy the tracked inputs of a case, leaving behind solver
# output, logs, study results, caches, generated meshes, time directories
# and any nested case that is discovered on its own.
copyCase()
{
    local case="$1"
    local src="${ROOT_DIR}/${case}"
    local dst="${REG_ROOT}/${case}"
    local -a ex=(
        --exclude='./postProcessing*' --exclude='./processor*' --exclude='./log.*'
        --exclude='results' --exclude='__pycache__' --exclude='.tmp'
        --exclude='./constant/polyMesh' --exclude='./constant/*/polyMesh'
        --exclude='*.foam' --exclude='./platforms'
    )
    local d other
    # time directories (anything numeric except 0)
    while IFS= read -r d; do
        ex+=(--exclude="./${d#./}")
    done < <(cd "${src}" && find . -maxdepth 1 -type d \
        -regex '\./-?[0-9][0-9]*\(\.[0-9]*\)?\([eE]-?[0-9][0-9]*\)?' ! -name 0)
    # nested cases run on their own
    for other in "${ALL_CASES[@]}"; do
        [[ "${other}" == "${case}/"* ]] && ex+=(--exclude="./${other#${case}/}")
    done

    rm -rf "${dst}"
    mkdir -p "${dst}"
    tar -C "${src}" "${ex[@]}" -cf - . | tar -C "${dst}" -xf -
}

failures=0
skips=0
unexpected_skips=0
failed_cases=()

for testCase in "${CASES[@]}"; do
    echo
    echo "------------------------------------------------------------"
    echo "Running regression test: ${testCase}"
    echo "------------------------------------------------------------"

    copyCase "${testCase}"

    # idealizedHeart/* cases read their shared mesh and anatomy fields from
    # a mesh/ directory at the idealizedHeart/ root (see
    # tutorials/idealizedHeart/README.md), which is not part of the case
    # copy: bring it in once per sweep.
    if [[ "${testCase}" == idealizedHeart/* && ! -d "${REG_ROOT}/idealizedHeart/mesh" ]]; then
        cp -a "${ROOT_DIR}/idealizedHeart/mesh" "${REG_ROOT}/idealizedHeart/mesh"
    fi

    rc=0
    (cd "${REG_ROOT}/${testCase}" && ./regression/regressionTest.sh) || rc=$?

    if (( rc == 0 )); then
        echo "PASS: regression test passed in ${testCase}"
    elif (( rc == 77 )); then
        skips=$((skips + 1))
        if expectedSkip "${testCase}"; then
            echo "EXPECTED SKIP: regression test skipped in ${testCase}"
        else
            echo "FAIL: unexpected regression-test skip in ${testCase}"
            unexpected_skips=$((unexpected_skips + 1))
            failed_cases+=("${testCase}")
        fi
    else
        echo "FAIL: regression test failed in ${testCase} (exit ${rc})"
        failures=$((failures + 1))
        failed_cases+=("${testCase}")
    fi
done

echo
echo "============================================================"
if (( failures > 0 || unexpected_skips > 0 )); then
    echo "Regression tests FAILED (${failures} failing case(s), ${unexpected_skips} unexpected skip(s), ${skips} total skip(s))"
    printf '  %s\n' "${failed_cases[@]}"
    exit 1
elif (( skips > 0 )); then
    echo "Regression tests PASSED WITH EXPECTED SKIPS (${skips} expected skip(s))"
else
    echo "All regression tests PASSED (no skips)"
fi
exit 0
