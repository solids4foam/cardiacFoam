#!/bin/bash
set -euo pipefail

CASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CASE_DIR"

bash setup/run_mesh_gate.sh 10
rm -rf 0 postProcessing [0-9]*

set +eu
source /Volumes/OpenFOAM-v2412/etc/bashrc
set -eu

setTorsoOrganConductivityField > log.setTorsoOrganConductivityField 2>&1
cardiacFoam > log.cardiacFoam 2>&1

OUT_DIR="setup/results/N10/smoke"
rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"
cp log.setTorsoOrganConductivityField log.cardiacFoam "$OUT_DIR/"

if [[ -d postProcessing ]]
then
    cp -R postProcessing "$OUT_DIR/"
fi

mkdir -p "$OUT_DIR/fields"
for time_dir in [0-9]*
do
    if [[ -d "$time_dir" ]]
    then
        cp -R "$time_dir" "$OUT_DIR/fields/"
    fi
done

echo "N=10 bath-bidomain tetrahedral smoke run complete."
