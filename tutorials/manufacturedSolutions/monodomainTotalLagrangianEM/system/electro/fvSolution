FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/electro";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors     2;
}

