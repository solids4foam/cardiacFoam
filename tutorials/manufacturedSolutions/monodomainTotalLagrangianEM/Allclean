#!/bin/bash
cd "${0%/*}" || exit 1

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

cleanCase

# Generated by Allrun (local/, the region meshes, the case-local library) and
# cardiacFoam (*.withDefaultValues)
rm -rf local platforms constant/polyMesh constant/electro/polyMesh constant/solid/polyMesh
rm -f constant/*.withDefaultValues constant/electro/*.withDefaultValues \
    constant/solid/*.withDefaultValues
(cd src && wclean)
