FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         none;
}

gradSchemes
{
    default                             leastSquares;
    grad(activationTime)                sealedWallLeastSquares;
    grad(activationTime.component(0))   sealedWallLeastSquares;
    limitedGrad                         cellMDLimited leastSquares 1;

    #includeIfPresent "<case>/local/gradient"
}

divSchemes
{
    default         none;
    div(phiU,activationTime) Gauss linearUpwind limitedGrad;

    #includeIfPresent "<case>/local/convection"
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

