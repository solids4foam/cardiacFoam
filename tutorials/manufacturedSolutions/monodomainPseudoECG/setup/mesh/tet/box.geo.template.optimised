// Unit-cube [0,1]^3 tetrahedral mesh for the monodomain manufactured MMS.
//
// This is the anatomically-oriented quality family. It keeps the domain,
// boundary surfaces, and characteristic-length ladder identical to the
// Delaunay family in box.geo.template, while changing only Gmsh's 3D
// generation and optimisation controls.

SetFactory("OpenCASCADE");

lc = __LC__;

Box(1) = {0, 0, 0, 1, 1, 1};

Physical Volume("internal") = {1};
Physical Surface("boundary") = {1, 2, 3, 4, 5, 6};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.Algorithm3D = 4;      // Frontal: anatomically-oriented quality family
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2; // gmshToFoam requires the legacy msh2 format
Mesh.OptimizeNetgen = 1;
Mesh.Smoothing = 100;
