// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource uniform;
    conductivity    [ -1 -3 3 0 0 2 0 ] ( 0.106875 -0.0084931 -0.022561 0.116682 -0.0130256 0.0398782 );
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      monodomainFDAManufactured;
    timeCouplingScheme godunov;
    outputVariables
    {
        ionic
        {
            export          ( u1 u2 u3 );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedAnisotropicMonodomainVerifier;
    }
    dimension       "3D";
    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    externalStimulus
    {
        stimulusLocationMin ( 0 0 0.0055 );
        stimulusLocationMax ( 0.0015 0.0015 0.007 );
        stimulusDuration [ 0 0 1 0 0 0 0 ] 0;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 0;
        stimulusStartTime 0;
    }
    ecgDomains
    {
        ECG
        {
            ecgSolver       pseudoECG;
            manufactured
            {
                enabled         yes;
                dimension       "3D";
                referenceQuadratureOrder 96;
                checkQuadratureOrders ( 6 12 24 48 );
            }
            electrodePositions
            {
                E1              ( -0.5 0.5 0.5 );
                E2              ( 1.5 0.5 0.5 );
                E3              ( 1.2 0.23 0.61 );
                E4              ( 1.35 0.74 0.28 );
                E5              ( 1.55 0.41 0.83 );
            }
        }
    }
}


