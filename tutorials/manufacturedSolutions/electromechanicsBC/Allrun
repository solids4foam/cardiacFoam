#!/bin/bash
#-------------------------------------------------------------------------------
# Allrun script for boundary-constrained electromechanics verification tutorial
#-------------------------------------------------------------------------------

cd "${0%/*}" || exit 1

. $WM_PROJECT_DIR/bin/tools/RunFunctions

requireFullElectroMechanicalBuild()
{
    local lib
    local libDir="${FOAM_USER_LIBBIN:-}"

    if [[ -z "$libDir" ]]; then
        echo "FOAM_USER_LIBBIN is not set. Source the OpenFOAM environment first."
        exit 1
    fi

    for lib in "${libDir}"/libelectroMechanicalModels.*; do
        if [[ -e "$lib" ]]; then
            return 0
        fi
    done

    cat <<'EOF'
This tutorial requires cardiacFoam built in full solids4foam mode.
The lightweight electrophysiology-only build does not compile
libelectroMechanicalModels, so electroMechanicalModel is unavailable.

Rebuild cardiacFoam after compiling solids4foam and sourcing that environment.
EOF

    exit 1
}

parallelRun=false
for arg in "$@"; do
    case "$arg" in
        parallel) parallelRun=true ;;
    esac
done

requireFullElectroMechanicalBuild

caseLibDir="$PWD/platforms/${WM_OPTIONS}/lib"

case "$(uname -s)" in
    Darwin) caseLibExt="dylib" ;;
    MINGW*|MSYS*|CYGWIN*) caseLibExt="dll" ;;
    *) caseLibExt="so" ;;
esac

mkdir -p "$caseLibDir"

(
    export FOAM_USER_LIBBIN="$caseLibDir"
    cd src || exit 1
    ./Allwmake -s
) || exit 1

if [[ "$caseLibExt" != "so" ]]; then
    ln -snf \
        "libmanufacturedElectromechanicsBC.$caseLibExt" \
        "$caseLibDir/libmanufacturedElectromechanicsBC.so"
fi

if [[ ! -d constant/polyMesh ]]; then
    runApplication blockMesh
fi

cp -r constant/polyMesh constant/electro/polyMesh
cp -r constant/polyMesh constant/solid/polyMesh

if $parallelRun; then
    runApplication -s electro decomposePar -region electro
    runApplication -s solid decomposePar -region solid
    runParallel cardiacFoam
else
    runApplication cardiacFoam
fi
