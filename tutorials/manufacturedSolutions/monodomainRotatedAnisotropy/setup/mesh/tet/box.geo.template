// Unit-cube [0,1]^3 tetrahedral mesh for the rotated-anisotropy monodomain
// manufactured solution.
//
// The characteristic length placeholder __LC__ is substituted by
// run_rotated_anisotropy_tet.sh (lc = 1/N) to build the refinement ladder.
// The manufactured solution has zero normal flux on all cube faces, so a
// single physical boundary patch is sufficient.

SetFactory("OpenCASCADE");

lc = __LC__;

Box(1) = {0, 0, 0, 1, 1, 1};

Physical Volume("internal") = {1};
Physical Surface("boundary") = {1, 2, 3, 4, 5, 6};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.Algorithm3D = 1;      // Delaunay
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2; // gmshToFoam requires the legacy msh2 format
