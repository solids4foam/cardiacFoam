# Reference grammar: tutorials/regression/lib.sh.
# error <field> <norm> <expected> <tolerance>
# -seedProfile curvedFront -PeL 21 -N 20: gmsh 4.15.2, seed 1. Tolerances
# cover the spread over gmsh mesh seeds 1 to 4.
error  eps        L2  0.0013803195  0.00043
error  eps_bulk   L2  0.0013711055  0.00043
error  eps_wall   L2  0.00014083478  4.2e-05
error  eps_ball   L2  7.4277726e-05  1.5e-05
error  grad_bulk  L2  0.030072815  0.0006
