FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     cardiacFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime 0.002;

deltaT 0.0001;

writeControl    runTime;

writeInterval 0.001;

purgeWrite      0;

writeFormat     binary;

writePrecision  17;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

libs            ( "libverificationModels.so" );


#include "../local/time"

