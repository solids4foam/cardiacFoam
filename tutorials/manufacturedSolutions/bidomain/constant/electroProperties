FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    conductivitySource uniform;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] ( 0.111453 0 0 0.121585 0 0.0303964 );
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] ( 0.0461655 0 0 0.0503623 0 0.0125906 );
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      bidomainFDAManufactured;
    outputVariables
    {
        ionic
        {
            export          ( u1 u2 u3 );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedFDABidomainVerifier;
        k               0.707107;
    }
    dimension       "3D";
    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    phiERefPoint    ( 0.125 0.05 0.05 );
    phiEReferenceValue 0;
    externalStimulus
    {
        stimulusLocationMin ( 0 0 0.0055 );
        stimulusLocationMax ( 0.0015 0.0015 0.007 );
        stimulusDuration [ 0 0 1 0 0 0 0 ] 0;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 0;
        stimulusStartTime 0;
    }
    timeCouplingScheme sbdf2;
}


