FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }

    "phiE|phiEFinal|phiI|phiIFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors     2;

    // Stated explicitly so the corrector studies have a key to set; OpenFOAM and cardiacFoam both default it to 0.
    nNonOrthogonalCorrectors 0;
}


