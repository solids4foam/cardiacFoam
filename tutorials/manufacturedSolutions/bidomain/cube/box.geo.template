// Unit cube [0,1]^3, Delaunay tetrahedra of size lc. Set lc and seed with
// gmsh -setnumber lc <value> -setnumber seed <value>. With gmsh 4.15.2 and
// seed 1 it gives 4874 tetrahedra at lc = 1/10 and 37040 at lc = 1/20.

SetFactory("OpenCASCADE");

DefineConstant[ lc = { 0.1, Name "lc" }, seed = { 1, Name "seed" } ];

Box(1) = {0, 0, 0, 1, 1, 1};

Physical Volume("internal") = {1};
Physical Surface("boundary") = {1, 2, 3, 4, 5, 6};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.Algorithm3D = 1;      // Delaunay: near-uniform, isotropic tets
Mesh.Optimize = 1;
Mesh.RandomSeed = seed;
Mesh.MshFileVersion = 2.2; // gmshToFoam requires the legacy msh2 format
