{
  "base": {
    "entry": "manufacturedBidomain",
    "case_dir_name": "manufacturedSolutions/bidomain",
    "setup_dir_name": "setup",
    "dimensions": ["3D"],
    "solver_types": ["implicit"],
    "piecewise_sweep": false,
    "mesh_family": "tet",
    "numerics_profile": "bidomain_tet",
    "phi_tolerance": 1e-15,
    "ode_abs_tolerance": 1e-10,
    "ode_rel_tolerance": 1e-08,
    "end_time": 0.2,
    "run_in_parallel": true,
    "postprocess_strict_artifacts": false,
    "archive_dir_name": "setup/studies/tetTemporalControl/results/sweepCases"
  },
  "sweep": {
    "mode": "zip",
    "independent": {
      "grad_scheme": ["gauss_linear", "gauss_linear", "least_squares", "least_squares"],
      "number_cells": [40, 80, 40, 80],
      "dt_values": [0.000280269, 0.000070087, 0.000280269, 0.000070087]
    },
    "dependent": [
      {
        "name": "output_dir_name",
        "derive": "output_dir_name_template",
        "of": ["grad_scheme", "number_cells", "dt_values"]
      }
    ]
  }
}
