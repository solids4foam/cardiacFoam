#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

usage()
{
    cat <<USAGE
Usage: ${0##*/} [parallel] [OPTION]...

The bath shell: the heart shell 0.5 < |x| < 1 coupled every step to the bath
ball and the outer bath 1 < |x| < 1.5 (torsoCoupling bath), verified against
the manufactured solution of bath_shell_bidomain_mms.py.

Options (parameters are written to local/ and included by the dictionaries):
  parallel                  decomposePar (6 subdomains, scotch), cardiacFoam in
                            parallel, reconstructPar
  -mesh hex|tet             blockMesh cubed sphere (default) or gmsh tetrahedra
                            (shell.geo.template)
  -N n                      cells per unit length (default 12); hex: a multiple
                            of 4; tet: element size 1/n
  -seed n                   gmsh random seed for -mesh tet (default 1)
  -outer insulated|grounded outer sphere insulated (pinned at phiERefPoint) or
                            grounded at the c0 of the parameter set (default
                            insulated)
  -parameterSet default|alternate
                            manufactured parameters; alternate turns the common
                            mode on (default default)
  -interface distanceWeightedHarmonic|conormalHarmonic
                            interfaceConductivityInterpolation (default
                            conormalHarmonic)
  -trace zeroGradient|global
                            bathHeartPhiETrace (default zeroGradient)
  -wallGradient sealed|stock
                            sealedWallLeastSquares or leastSquares for grad(Vm)
                            and grad(phiE) (default sealed)
  -predictorCorrector yes|no
                            bathPredictorCorrector (default yes)
  -outerCorrectors n        PIMPLE nOuterCorrectors (default 1)
  -dt x                     time step
  -endTime x                end time (default 0.2)

Without -dt the time step is endTime/ceil(endTime/(0.00892857*(10/N)^2)).
-mesh tet needs gmsh (tested with 4.15.2) and gmshToFoam.
USAGE
    exit 2
}

parallel=false
mesh=hex
N=12
seed=1
outer=insulated
parameterSet=default
interface=conormalHarmonic
trace=zeroGradient
wallGradient=sealed
predictorCorrector=yes
outerCorrectors=1
dt=
endTime=0.2

needValue()
{
    [ "$#" -ge 2 ] || { echo "${0##*/}: $1 needs a value" 1>&2; usage; }
}

positiveInteger()
{
    case "$2" in
        ''|*[!0-9]*|0*)
            echo "${0##*/}: $1 takes a positive integer, not $2" 1>&2
            usage
            ;;
    esac
}

positiveNumber()
{
    awk -v r="$2" 'BEGIN { exit !(r ~ /^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/ && r > 0) }' \
        || { echo "${0##*/}: $1 takes a positive number, not $2" 1>&2; usage; }
}

oneOf()
{
    local option="$1" value="$2"
    shift 2
    for allowed in "$@"
    do
        [ "$value" = "$allowed" ] && return 0
    done
    echo "${0##*/}: unknown $option $value" 1>&2
    usage
}

while [ "$#" -gt 0 ]
do
    case "$1" in
        parallel)
            parallel=true
            ;;
        -mesh)
            needValue "$@"; mesh="$2"; shift
            oneOf -mesh "$mesh" hex tet
            ;;
        -N)
            needValue "$@"; N="$2"; shift
            positiveInteger -N "$N"
            ;;
        -seed)
            needValue "$@"; seed="$2"; shift
            positiveInteger -seed "$seed"
            ;;
        -outer)
            needValue "$@"; outer="$2"; shift
            oneOf -outer "$outer" insulated grounded
            ;;
        -parameterSet)
            needValue "$@"; parameterSet="$2"; shift
            oneOf -parameterSet "$parameterSet" default alternate
            ;;
        -interface)
            needValue "$@"; interface="$2"; shift
            oneOf -interface "$interface" distanceWeightedHarmonic conormalHarmonic
            ;;
        -trace)
            needValue "$@"; trace="$2"; shift
            oneOf -trace "$trace" zeroGradient global
            ;;
        -wallGradient)
            needValue "$@"; wallGradient="$2"; shift
            oneOf -wallGradient "$wallGradient" sealed stock
            ;;
        -predictorCorrector)
            needValue "$@"; predictorCorrector="$2"; shift
            oneOf -predictorCorrector "$predictorCorrector" yes no
            ;;
        -outerCorrectors)
            needValue "$@"; outerCorrectors="$2"; shift
            positiveInteger -outerCorrectors "$outerCorrectors"
            ;;
        -dt)
            needValue "$@"; dt="$2"; shift
            positiveNumber -dt "$dt"
            ;;
        -endTime)
            needValue "$@"; endTime="$2"; shift
            positiveNumber -endTime "$endTime"
            ;;
        -h|-help|--help)
            usage
            ;;
        *)
            echo "${0##*/}: unknown argument $1" 1>&2
            usage
            ;;
    esac
    shift
done

if [ -e log.gmsh ] || [ -e log.blockMesh ]
then
    echo "${0##*/}: a mesh log exists; run ./Allclean first" 1>&2
    exit 1
fi

if [ "$mesh" = hex ] && [ $((N % 4)) -ne 0 ]
then
    echo "${0##*/}: -mesh hex takes -N as a multiple of 4, not $N" 1>&2
    usage
fi

if [ "$mesh" = tet ]
then
    for tool in gmsh gmshToFoam
    do
        command -v "$tool" > /dev/null || { echo "${0##*/}: $tool not found" 1>&2; exit 1; }
    done
fi

rm -rf local
mkdir local
echo "N $N;" > local/mesh

# The verifier's options; the ground value c0 of each parameter set
# (bath_shell_bidomain_mms.py: default 0.1, alternate -0.05)
cat > local/verification <<EOF2
N               $N;
outerClosure    $outer;
parameterSet    $parameterSet;
EOF2
echo "interfaceConductivityInterpolation $interface;" > local/torso
if [ "$outer" = grounded ]
then
    c0=0.1
    [ "$parameterSet" = alternate ] && c0=-0.05
    cat >> local/torso <<EOF2
groundPatches
{
    outer           $c0;
}
EOF2
fi
cat > local/myocardium <<EOF2
bathHeartPhiETrace $trace;
bathPredictorCorrector $predictorCorrector;
EOF2
if [ "$wallGradient" = stock ]
then
    cat > local/wallGradient <<EOF2
grad(Vm)                leastSquares;
grad(Vm.component(0))   leastSquares;
grad(phiE)              leastSquares;
grad(phiE.component(0)) leastSquares;
EOF2
fi
echo "nOuterCorrectors $outerCorrectors;" > local/pimple

if [ -z "$dt" ]
then
    dt=$(awk -v T="$endTime" -v N="$N" 'BEGIN {
        h = 0.00892857*(10/N)^2
        n = int(T/h); if (n*h < T) n++
        printf "%.17g", T/n }')
fi
cat > local/time <<EOF2
endTime         $endTime;
deltaT          $dt;
writeInterval   $endTime;
EOF2

# Mesh with the cellZones bloodPool, myocardium and bath and the patch outer
if [ "$mesh" = hex ]
then
    runApplication blockMesh
else
    lc=$(awk -v N="$N" 'BEGIN { printf "%.17g", 1/N }')
    runApplication gmsh -3 shell.geo.template -setnumber lc "$lc" -setnumber seed "$seed" \
        -o local/shell.msh
    if grep -q "Error" log.gmsh
    then
        echo "${0##*/}: gmsh reported errors; see log.gmsh" 1>&2
        exit 1
    fi
    runApplication gmshToFoam local/shell.msh
fi
runApplication checkMesh

# Gi, Ge and the bath conductivity of the manufactured solution
runApplication setManufacturedFields

if $parallel
then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar -latestTime
else
    runApplication cardiacFoam
fi
