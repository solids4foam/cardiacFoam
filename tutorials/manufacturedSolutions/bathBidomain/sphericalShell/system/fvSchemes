FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         none;
    ddt(Vm)         backward;
}

// The sealed-wall gradient for Vm and phiE (Allrun -wallGradient stock
// writes leastSquares into local/wallGradient)
gradSchemes
{
    default                 leastSquares;
    grad(Vm)                sealedWallLeastSquares;
    grad(Vm.component(0))   sealedWallLeastSquares;
    grad(phiE)              sealedWallLeastSquares;
    grad(phiE.component(0)) sealedWallLeastSquares;

    #includeIfPresent "<case>/local/wallGradient"
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    phiE;
}


