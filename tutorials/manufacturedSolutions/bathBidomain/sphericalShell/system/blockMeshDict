FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          blockMeshDict;
}

// Cubed sphere for -mesh hex: an inner cube and three six-block layers (bloodPool to
// r1, myocardium r1 - r2, bath to the box [-L, L]^3), vertices and the faces at r1
// and r2 projected onto the spheres. N (a multiple of 4) sets k = N/4: 3k cells
// along a cube-face edge and 2k radially in each layer, N cells per unit length
// radially in the heart.

N   12;
#includeIfPresent "<case>/local/mesh"

r1  0.5;
r2  1.0;
L   1.5;

a0  #eval{ 0.5*$r1/sqrt(3.0) };
a1  #eval{ $r1/sqrt(3.0) };
a2  #eval{ $r2/sqrt(3.0) };

k   #eval{ round($N/4) };
nt  #eval{ 3*$k };
nP  #eval{ 2*$k };
nM  #eval{ 2*$k };
nB  #eval{ 2*$k };

geometry
{
    s1 { type sphere; origin (0 0 0); radius $r1; }
    s2 { type sphere; origin (0 0 0); radius $r2; }
}

vertices
(
    #eval{ vector(-$a0, -$a0, -$a0) }
    #eval{ vector($a0, -$a0, -$a0) }
    #eval{ vector($a0, $a0, -$a0) }
    #eval{ vector(-$a0, $a0, -$a0) }
    #eval{ vector(-$a0, -$a0, $a0) }
    #eval{ vector($a0, -$a0, $a0) }
    #eval{ vector($a0, $a0, $a0) }
    #eval{ vector(-$a0, $a0, $a0) }
    project #eval{ vector(-$a1, -$a1, -$a1) } (s1)
    project #eval{ vector($a1, -$a1, -$a1) } (s1)
    project #eval{ vector($a1, $a1, -$a1) } (s1)
    project #eval{ vector(-$a1, $a1, -$a1) } (s1)
    project #eval{ vector(-$a1, -$a1, $a1) } (s1)
    project #eval{ vector($a1, -$a1, $a1) } (s1)
    project #eval{ vector($a1, $a1, $a1) } (s1)
    project #eval{ vector(-$a1, $a1, $a1) } (s1)
    project #eval{ vector(-$a2, -$a2, -$a2) } (s2)
    project #eval{ vector($a2, -$a2, -$a2) } (s2)
    project #eval{ vector($a2, $a2, -$a2) } (s2)
    project #eval{ vector(-$a2, $a2, -$a2) } (s2)
    project #eval{ vector(-$a2, -$a2, $a2) } (s2)
    project #eval{ vector($a2, -$a2, $a2) } (s2)
    project #eval{ vector($a2, $a2, $a2) } (s2)
    project #eval{ vector(-$a2, $a2, $a2) } (s2)
    #eval{ vector(-$L, -$L, -$L) }
    #eval{ vector($L, -$L, -$L) }
    #eval{ vector($L, $L, -$L) }
    #eval{ vector(-$L, $L, -$L) }
    #eval{ vector(-$L, -$L, $L) }
    #eval{ vector($L, -$L, $L) }
    #eval{ vector($L, $L, $L) }
    #eval{ vector(-$L, $L, $L) }
);

blocks
(
    hex (0 1 2 3 4 5 6 7) bloodPool ($nt $nt $nt) simpleGrading (1 1 1)
    hex (8 0 3 11 12 4 7 15) bloodPool ($nP $nt $nt) simpleGrading (1 1 1)
    hex (1 9 10 2 5 13 14 6) bloodPool ($nP $nt $nt) simpleGrading (1 1 1)
    hex (8 9 1 0 12 13 5 4) bloodPool ($nt $nP $nt) simpleGrading (1 1 1)
    hex (3 2 10 11 7 6 14 15) bloodPool ($nt $nP $nt) simpleGrading (1 1 1)
    hex (8 9 10 11 0 1 2 3) bloodPool ($nt $nt $nP) simpleGrading (1 1 1)
    hex (4 5 6 7 12 13 14 15) bloodPool ($nt $nt $nP) simpleGrading (1 1 1)
    hex (16 8 11 19 20 12 15 23) myocardium ($nM $nt $nt) simpleGrading (1 1 1)
    hex (9 17 18 10 13 21 22 14) myocardium ($nM $nt $nt) simpleGrading (1 1 1)
    hex (16 17 9 8 20 21 13 12) myocardium ($nt $nM $nt) simpleGrading (1 1 1)
    hex (11 10 18 19 15 14 22 23) myocardium ($nt $nM $nt) simpleGrading (1 1 1)
    hex (16 17 18 19 8 9 10 11) myocardium ($nt $nt $nM) simpleGrading (1 1 1)
    hex (12 13 14 15 20 21 22 23) myocardium ($nt $nt $nM) simpleGrading (1 1 1)
    hex (24 16 19 27 28 20 23 31) bath ($nB $nt $nt) simpleGrading (1 1 1)
    hex (17 25 26 18 21 29 30 22) bath ($nB $nt $nt) simpleGrading (1 1 1)
    hex (24 25 17 16 28 29 21 20) bath ($nt $nB $nt) simpleGrading (1 1 1)
    hex (19 18 26 27 23 22 30 31) bath ($nt $nB $nt) simpleGrading (1 1 1)
    hex (24 25 26 27 16 17 18 19) bath ($nt $nt $nB) simpleGrading (1 1 1)
    hex (20 21 22 23 28 29 30 31) bath ($nt $nt $nB) simpleGrading (1 1 1)
);

edges
(
    arc 8 9 origin (0 0 0)
    arc 11 10 origin (0 0 0)
    arc 15 14 origin (0 0 0)
    arc 12 13 origin (0 0 0)
    arc 8 11 origin (0 0 0)
    arc 9 10 origin (0 0 0)
    arc 13 14 origin (0 0 0)
    arc 12 15 origin (0 0 0)
    arc 8 12 origin (0 0 0)
    arc 9 13 origin (0 0 0)
    arc 10 14 origin (0 0 0)
    arc 11 15 origin (0 0 0)
    arc 16 17 origin (0 0 0)
    arc 19 18 origin (0 0 0)
    arc 23 22 origin (0 0 0)
    arc 20 21 origin (0 0 0)
    arc 16 19 origin (0 0 0)
    arc 17 18 origin (0 0 0)
    arc 21 22 origin (0 0 0)
    arc 20 23 origin (0 0 0)
    arc 16 20 origin (0 0 0)
    arc 17 21 origin (0 0 0)
    arc 18 22 origin (0 0 0)
    arc 19 23 origin (0 0 0)
);

faces
(
    project (8 11 15 12) s1
    project (9 10 14 13) s1
    project (8 9 13 12) s1
    project (11 10 14 15) s1
    project (8 9 10 11) s1
    project (12 13 14 15) s1
    project (16 19 23 20) s2
    project (17 18 22 21) s2
    project (16 17 21 20) s2
    project (19 18 22 23) s2
    project (16 17 18 19) s2
    project (20 21 22 23) s2
);

boundary
(
    outer
    {
        type patch;
        faces
        (
            (24 27 31 28) (25 26 30 29) (24 25 29 28)
            (27 26 30 31) (24 25 26 27) (28 29 30 31)
        );
    }
    exposed
    {
        type patch;
        faces ();
    }
);


