FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The bath shell: the heart shell 0.5 < |x| < 1 (cellZone myocardium)
// coupled every step to the bath ball bloodPool and the outer bath
// 1 < |x| < 1.5 (torsoCoupling bath). The manufactured solution is that of
// bath_shell_bidomain_mms.py. Allrun writes its options into local/.

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    // The intracellular space is sealed on both spheres
    sealedHeartBoundary true;
    bathHeartPhiETrace zeroGradient;
    bathPredictorCorrector yes;
    cellZone        myocardium;
    conductivitySource field;
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      monodomainFDAManufactured;
    timeCouplingScheme godunov;
    outputVariables
    {
        ionic
        {
            export          ( u1 u2 u3 );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedShellBathBidomainVerifier;
        N               12;
        outerClosure    insulated;
        parameterSet    default;
        // Body surface: the curved conductor's eight electrodes at |x| = 1.47
        // and its probes in the outer bath and the pool
        electrodePositions
        {
            surface1        ( 1.2228 0.8015 -0.1527 );
            surface2        ( 0.2016 0.6627 1.2966 );
            surface3        ( 1.1745 -0.8486 -0.2475 );
            surface4        ( -0.2508 1.3845 -0.4257 );
            surface5        ( -0.3203 -0.8630 1.1461 );
            surface6        ( 0.1463 -0.3572 -1.4184 );
            surface7        ( -1.3923 0.4245 0.2054 );
            surface8        ( -0.8235 -1.1660 -0.3509 );
            outerNear       ( 0.0517 1.0713 0.0811 );
            outerSide       ( -1.2117 -0.4313 0.6271 );
            outerFar        ( 0.9113 0.8121 -0.6730 );
            pool            ( 0.1131 -0.0733 0.2117 );
        }
        #includeIfPresent "<case>/local/verification"
    }
    dimension       "3D";
    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    phiERefPoint    ( 0.7413 0.0317 0.0291 );
    phiEReferenceValue 0;
    externalStimulus
    {
        stimulusLocationMin ( 0 0 0 );
        stimulusLocationMax ( 0 0 0 );
        stimulusDuration [ 0 0 1 0 0 0 0 ] 0;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 0;
        stimulusStartTime 0;
    }
    #includeIfPresent "<case>/local/myocardium"
}

// The bath: the pool and the outer bath, the conductivity written by
// setManufacturedFields; insulated outer sphere by default (pinned at
// phiERefPoint), grounded with Allrun -outer grounded. conormalHarmonic: the
// cross and non-orthogonal terms of the interface faces use the jump-aware
// gradient (distanceWeightedHarmonic leaves a first-order error at the
// concave interface)
torso
{
    cellZones       ( bloodPool bath );
    conductivityField bodyAndOrgansConductivity;
    interfaceConductivityInterpolation conormalHarmonic;
    phiERefPoint    ( 1.3137 0.0371 0.0459 );
    phiEReferenceValue 0;
    #includeIfPresent "<case>/local/torso"
}

torsoCoupling bath;


