// Spherical heart shell r1 < |x| < r2 around the bath ball bloodPool, in the
// bath box [-L, L]^3; tetrahedra of size lc. Set lc and seed with
// gmsh -setnumber lc <value> -setnumber seed <value>.
SetFactory("OpenCASCADE");

If (!Exists(lc))
    lc = 0.1;
EndIf
If (!Exists(seed))
    seed = 1;
EndIf

L = 1.5;
r1 = 0.5;
r2 = 1.0;
e = 1e-6;

Box(1) = {-L, -L, -L, 2*L, 2*L, 2*L};
Sphere(2) = {0, 0, 0, r2};
Sphere(3) = {0, 0, 0, r1};
BooleanFragments{ Volume{1, 2, 3}; Delete; }{}

ball() = Volume In BoundingBox{-r1 - e, -r1 - e, -r1 - e, r1 + e, r1 + e, r1 + e};
inner() = Volume In BoundingBox{-r2 - e, -r2 - e, -r2 - e, r2 + e, r2 + e, r2 + e};
shell() = inner();
shell() -= ball();
outer() = Volume{:};
outer() -= inner();

boxFaces() = Abs(Boundary{ Volume{outer()}; });
sphereFaces() = Surface In BoundingBox{-r2 - e, -r2 - e, -r2 - e, r2 + e, r2 + e, r2 + e};
boxFaces() -= sphereFaces();

Physical Volume("bloodPool") = {ball()};
Physical Volume("myocardium") = {shell()};
Physical Volume("bath") = {outer()};
Physical Surface("outer") = {boxFaces()};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.MeshSizeFromCurvature = 0;
Mesh.Algorithm = 6;
Mesh.Algorithm3D = 1;
Mesh.Optimize = 1;
Mesh.RandomSeed = seed;
Mesh.MaxNumThreads1D = 1;
Mesh.MaxNumThreads2D = 1;
Mesh.MaxNumThreads3D = 1;
General.NumThreads = 1;
Mesh.MshFileVersion = 2.2;
