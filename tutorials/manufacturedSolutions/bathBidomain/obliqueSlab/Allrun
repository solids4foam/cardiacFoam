#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

usage()
{
    cat <<USAGE
Usage: ${0##*/} [parallel] [OPTION]...

Options (parameters are written to local/ and included by the dictionaries):
  parallel                  decomposePar, run cardiacFoam in parallel, reconstructPar
  -mesh hex|tet             blockMesh parallelepipeds (default) or gmsh tetrahedra (slab.geo.template)
  -N n                      cells per unit length in s and per period in tau (default 10);
                            hex: a positive multiple of 10; tet: element size 1/n, any positive integer
  -seed n                   gmsh random seed for -mesh tet (default 1)
  -dt x                     time step
  -endTime x                end time (default 0.2)
  -elliptic                 one step of 1e-9 s (overrides -dt and -endTime)
  -config 0|A|AI|ATI|ATBI   interface configuration (default: ATBI, as in electroProperties)
  -solution affine|levelSet manufactured solution (default levelSet)
  -shear c                  hex only: heart and inner bath block shear both set to c (0: orthogonal slab);
                            applied before -shearHeart and -shearBath, whatever the order
  -shearHeart c             heart block shear (default 0.6)
  -shearBath c              inner bath block shear (default -0.4)
  -nOuter n                 PIMPLE nOuterCorrectors
  -nNonOrth n               nNonOrthogonalCorrectors (a non-negative integer)
  -predictor on|off         bathPredictorCorrector
  -grad leastSquares|GaussLinear
                            default gradient scheme (default leastSquares)
  -decomposition manual|simple
                            decomposition method (default manual)

Without -dt the time step is endTime/ceil(endTime/(0.00892857*(10/N)^2)).
USAGE
    exit 2
}

parallel=false
mesh=hex
N=10
seed=1
dt=
endTime=
elliptic=false
config=
solution=levelSet
shearHeart=0.6
shearBath=-0.4
shear=
shearHeartArg=
shearBathArg=
nOuter=
nNonOrth=
predictor=
grad=leastSquares
decomposition=manual

needValue()
{
    [ "$#" -ge 2 ] || { echo "${0##*/}: $1 needs a value" 1>&2; usage; }
}

while [ "$#" -gt 0 ]
do
    case "$1" in
        parallel)
            parallel=true
            ;;
        -mesh)
            needValue "$@"; mesh="$2"; shift
            case "$mesh" in
                hex|tet) ;;
                *) echo "${0##*/}: unknown -mesh $mesh" 1>&2; usage ;;
            esac
            ;;
        -N)
            needValue "$@"; N="$2"; shift
            case "$N" in
                ''|*[!0-9]*|0*)
                    echo "${0##*/}: -N takes a positive integer, not $N" 1>&2
                    usage
                    ;;
            esac
            ;;
        -seed)
            needValue "$@"; seed="$2"; shift
            case "$seed" in
                ''|*[!0-9]*|0*)
                    echo "${0##*/}: -seed takes a positive integer, not $seed" 1>&2
                    usage
                    ;;
            esac
            ;;
        -dt)
            needValue "$@"; dt="$2"; shift
            ;;
        -endTime)
            needValue "$@"; endTime="$2"; shift
            ;;
        -elliptic)
            elliptic=true
            ;;
        -config)
            needValue "$@"; config="$2"; shift
            case "$config" in
                0|A|AI|ATI|ATBI) ;;
                *) echo "${0##*/}: unknown -config $config" 1>&2; usage ;;
            esac
            ;;
        -solution)
            needValue "$@"; solution="$2"; shift
            case "$solution" in
                affine|levelSet) ;;
                *) echo "${0##*/}: unknown -solution $solution" 1>&2; usage ;;
            esac
            ;;
        -shear)
            needValue "$@"; shear="$2"; shift
            ;;
        -shearHeart)
            needValue "$@"; shearHeartArg="$2"; shift
            ;;
        -shearBath)
            needValue "$@"; shearBathArg="$2"; shift
            ;;
        -nOuter)
            needValue "$@"; nOuter="$2"; shift
            ;;
        -nNonOrth)
            needValue "$@"; nNonOrth="$2"; shift
            case "$nNonOrth" in
                ''|*[!0-9]*)
                    echo "${0##*/}: -nNonOrth takes a non-negative integer, not $nNonOrth" 1>&2
                    usage
                    ;;
            esac
            ;;
        -predictor)
            needValue "$@"; predictor="$2"; shift
            case "$predictor" in
                on|off) ;;
                *) echo "${0##*/}: -predictor takes on or off" 1>&2; usage ;;
            esac
            ;;
        -grad)
            needValue "$@"; grad="$2"; shift
            case "$grad" in
                leastSquares|GaussLinear) ;;
                *) echo "${0##*/}: unknown -grad $grad" 1>&2; usage ;;
            esac
            ;;
        -decomposition)
            needValue "$@"; decomposition="$2"; shift
            case "$decomposition" in
                manual|simple) ;;
                *) echo "${0##*/}: unknown -decomposition $decomposition" 1>&2; usage ;;
            esac
            ;;
        -h|-help|--help)
            usage
            ;;
        *)
            echo "${0##*/}: unknown argument $1" 1>&2
            usage
            ;;
    esac
    shift
done

if [ -e log.blockMesh ] || [ -e log.gmsh ]
then
    echo "${0##*/}: a mesh log exists; run ./Allclean first" 1>&2
    exit 1
fi

if [ "$mesh" = hex ] && [ $((N % 10)) -ne 0 ]
then
    echo "${0##*/}: -mesh hex takes -N as a positive multiple of 10, not $N" 1>&2
    usage
fi

if [ "$mesh" = tet ] && [ -n "$shear$shearHeartArg$shearBathArg" ]
then
    echo "${0##*/}: -shear, -shearHeart and -shearBath apply to -mesh hex only" 1>&2
    usage
fi

# -shear first, then the individual shears override it
[ -z "$shear" ] || { shearHeart="$shear"; shearBath="$shear"; }
[ -z "$shearHeartArg" ] || shearHeart="$shearHeartArg"
[ -z "$shearBathArg" ] || shearBath="$shearBathArg"

rm -rf local
mkdir local

# Mesh
cat > local/mesh <<EOF
N   $N;
cH  $shearHeart;
cB  $shearBath;
EOF

# Time: -elliptic > -dt/-endTime > the N-derived step.
if $elliptic
then
    cat > local/time <<EOF
endTime         1e-9;
deltaT          1e-9;
writeInterval   1e-9;
EOF
else
    endTime="${endTime:-0.2}"
    if [ -z "$dt" ]
    then
        dt=$(awk -v T="$endTime" -v N="$N" 'BEGIN {
            h = 0.00892857*(10/N)^2
            n = int(T/h); if (n*h < T) n++
            printf "%.17g", T/n }')
    fi
    cat > local/time <<EOF
endTime         $endTime;
deltaT          $dt;
writeInterval   $endTime;
EOF
fi

# Verification model
cat > local/solution <<EOF
N           $N;
solution    $solution;
EOF

# Interface configuration
{
    case "$config" in
        0)
            echo "sealedHeartBoundary false;"
            echo "sealedWallTrace zeroGradient;"
            echo "bathHeartPhiETrace zeroGradient;"
            echo "bathPotentialDomain { interfaceConductivityInterpolation distanceWeightedHarmonic; }"
            ;;
        A)
            echo "sealedHeartBoundary true;"
            echo "sealedWallTrace zeroGradient;"
            echo "bathHeartPhiETrace zeroGradient;"
            echo "bathPotentialDomain { interfaceConductivityInterpolation distanceWeightedHarmonic; }"
            ;;
        AI)
            echo "sealedHeartBoundary true;"
            echo "sealedWallTrace zeroGradient;"
            echo "bathHeartPhiETrace zeroGradient;"
            echo "bathPotentialDomain { interfaceConductivityInterpolation conormalHarmonic; }"
            ;;
        ATI)
            echo "sealedHeartBoundary true;"
            echo "sealedWallTrace zeroGradient;"
            echo "bathHeartPhiETrace global;"
            echo "bathPotentialDomain { interfaceConductivityInterpolation conormalHarmonic; }"
            ;;
        ATBI)
            echo "sealedHeartBoundary true;"
            echo "sealedWallTrace conormal;"
            echo "bathHeartPhiETrace global;"
            echo "bathPotentialDomain { interfaceConductivityInterpolation conormalHarmonic; }"
            ;;
    esac
    if [ -n "$predictor" ]
    then
        echo "bathPredictorCorrector $predictor;"
    fi
    if [ "$mesh" = tet ]
    then
        echo "dimension \"3D\";"
    fi
} > local/configuration

[ -s local/configuration ] || rm -f local/configuration

if [ -n "$nOuter" ] || [ -n "$nNonOrth" ]
then
    {
        [ -z "$nOuter" ] || echo "nOuterCorrectors $nOuter;"
        [ -z "$nNonOrth" ] || echo "nNonOrthogonalCorrectors $nNonOrth;"
    } > local/coupling
fi

if [ "$grad" = GaussLinear ]
then
    echo "default Gauss linear;" > local/schemes
fi

if [ "$decomposition" = simple ]
then
    echo "method simple; coeffs { n (2 2 1); }" > local/decomposition
fi

if [ "$mesh" = hex ]
then
    runApplication blockMesh
    runApplication checkMesh -allGeometry -allTopology
else
    for tool in gmsh gmshToFoam
    do
        command -v "$tool" > /dev/null || { echo "${0##*/}: $tool not found" 1>&2; exit 1; }
    done

    # Tetrahedra in slab coordinates (s, tau, z), rotated by geometryCoeffs.alpha about z
    alpha=$(foamDictionary -entry bidomainSolverCoeffs/verificationModel/geometryCoeffs/alpha -value constant/electroProperties)
    printf 'alpha   %s;\nT       0.2;\n' "$alpha" > local/slabTet
    lc=$(awk -v N="$N" 'BEGIN { printf "%.17g", 1/N }')
    cp slab.geo.template local/slab.geo
    runApplication gmsh -3 local/slab.geo -setnumber lc "$lc" -setnumber seed "$seed" -o local/slab.msh
    if grep -q "Error" log.gmsh
    then
        echo "${0##*/}: gmsh reported errors; see log.gmsh" 1>&2
        exit 1
    fi
    runApplication gmshToFoam local/slab.msh
    runApplication transformPoints -rotate-z "$alpha"
    runApplication createPatch -dict system/createPatchDict.tet -overwrite

    # The zero-face patch that receives the exposed heart faces, appended after createPatch, which drops empty patches
    boundary=constant/polyMesh/boundary
    nFaces=$(sed -n 's/.*nFaces: *\([0-9]*\).*/\1/p' constant/polyMesh/owner | head -n 1)
    if [ -z "$nFaces" ]
    then
        echo "${0##*/}: no face count in constant/polyMesh/owner" 1>&2
        exit 1
    fi
    awk -v start="$nFaces" '
        !counted && /^[0-9]+[[:space:]]*$/ { print $1 + 1; counted = 1; next }
        !done && /^\)[[:space:]]*$/ {
            printf "    exposed\n    {\n        type            patch;\n        nFaces          0;\n        startFace       %s;\n    }\n", start
            done = 1
        }
        { print }
    ' "$boundary" > "$boundary.new"
    mv "$boundary.new" "$boundary"

    runApplication checkMesh
fi
if grep -q "Failed [0-9]* mesh checks" log.checkMesh
then
    echo "checkMesh reported failed mesh checks; see log.checkMesh" 1>&2
    exit 1
fi

# Gi, Ge, the bath conductivity and constant/cellDecomposition
runApplication setManufacturedFields

if $parallel
then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar
else
    runApplication cardiacFoam
fi
