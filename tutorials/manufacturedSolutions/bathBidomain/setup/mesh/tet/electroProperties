FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  bidomainSolver;

bidomainSolverCoeffs
{
    conductivitySource uniform;
    cellZone myocardium;
    bathPredictorCorrector true;

    conductivityIntracellular [-1 -3 3 0 0 2 0] (0.111453302 0 0 0.121585420 0 0.030396355);
    conductivityExtracellular [-1 -3 3 0 0 2 0] (0.046165469 0 0 0.050362330 0 0.012590582);

    chi  [0 -1 0 0 0 0 0] 3;
    cm   [-1 -4 4 0 0 2 0] 2;

    ionicModel bathBidomainFDAManufactured;

    outputVariables
    {
        ionic
        {
            export (V u1 u2 u3 Iion);
            debug (V u1 u2 u3 Iion);
        }
    }

    verificationModel
    {
        type    manufacturedFDABathBidomainVerifier;
        k               0.7071067811865476;
        alpha           0.01;
        fdaBathVariant  groundElectrode;
    }

    manufacturedBidomain
    {
        k               0.7071067811865476;
        alpha           0.01;
        fdaBathVariant  groundElectrode;
    }

    dimension    "3D";

    solutionAlgorithm    implicit;
    solver RKF45;
    maxSteps 1000000000;

    bathPotentialDomain
    {
        bathCellZones (bath);
        bathConductivityField bodyAndOrgansConductivity;
        interfaceConductivityInterpolation distanceWeightedHarmonic;

        groundPatches
        {
            xMin 0;
        }

        surfaceCurrentPatches
        {
            xMax 0.01;
        }
    }

}

