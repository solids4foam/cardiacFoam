// Conformal tetrahedral bath--myocardium--bath mesh.
// Second, independent Frontal-family realization: same Mesh.Algorithm3D=4
// generator as three_domain_box.geo.template.optimised, but a different
// Mesh.RandomSeed, so the resulting tet connectivity differs even though the
// algorithm and target cell size do not. Used to test whether a localized
// interface defect found on the primary Frontal mesh is tied to the
// generation algorithm or is a fluke of that one specific mesh instance.

SetFactory("OpenCASCADE");

// Mesh.RandomSeed does not perturb this Algorithm3D=4 + OptimizeNetgen
// pipeline (confirmed: identical mesh and identical errors to full solver
// precision with RandomSeed=42 vs the unset default). A small, deliberately
// non-round characteristic-length offset is used instead to force a
// genuinely different mesh under the same algorithm.
lc = __LC__ * 1.000037;
eps = 1e-7;

Box(1) = {-1, 0, 0, 1, 1, 1};
Box(2) = { 0, 0, 0, 1, 1, 1};
Box(3) = { 1, 0, 0, 1, 1, 1};

BooleanFragments{ Volume{1, 2, 3}; Delete; }{}

leftBath[] = Volume In BoundingBox{-1-eps, -eps, -eps, 0+eps, 1+eps, 1+eps};
heart[] = Volume In BoundingBox{0-eps, -eps, -eps, 1+eps, 1+eps, 1+eps};
rightBath[] = Volume In BoundingBox{1-eps, -eps, -eps, 2+eps, 1+eps, 1+eps};

Physical Volume("myocardium") = {heart[]};
Physical Volume("bath") = {leftBath[], rightBath[]};

xMin[] = Surface In BoundingBox{-1-eps, -eps, -eps, -1+eps, 1+eps, 1+eps};
xMax[] = Surface In BoundingBox{2-eps, -eps, -eps, 2+eps, 1+eps, 1+eps};
yMin[] = Surface In BoundingBox{-1-eps, -eps, -eps, 2+eps, eps, 1+eps};
yMax[] = Surface In BoundingBox{-1-eps, 1-eps, -eps, 2+eps, 1+eps, 1+eps};
zMin[] = Surface In BoundingBox{-1-eps, -eps, -eps, 2+eps, 1+eps, eps};
zMax[] = Surface In BoundingBox{-1-eps, -eps, 1-eps, 2+eps, 1+eps, 1+eps};

Physical Surface("xMin") = {xMin[]};
Physical Surface("xMax") = {xMax[]};
Physical Surface("sides") = {yMin[], yMax[], zMin[], zMax[]};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.Algorithm3D = 4;
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2;
Mesh.OptimizeNetgen = 1;
Mesh.Smoothing = 100;
Mesh.RandomSeed = 42;
