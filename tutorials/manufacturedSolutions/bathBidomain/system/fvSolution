FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }

    "phiE|phiEFinal|phiI|phiIFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }
}

PIMPLE
{
    // The global bath phiE is advanced outside this loop. Keep one outer
    // sweep and express the second Vm assembly as an equation corrector.
    nOuterCorrectors         1;
    nNonOrthogonalCorrectors 1;

    // phiE defaults to nNonOrthogonalCorrectors above. The reported bath
    // results were produced before that fallback existed, i.e. with no
    // non-orthogonal correction on the elliptic phiE solve, so it is pinned
    // explicitly here. Raising it changes the interface errors materially on
    // tetrahedra; it is a study parameter, not a free tuning knob.
    phiENonOrthogonalCorrectors 0;

    // residualControl
    // {
