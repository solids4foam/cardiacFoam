FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

vertices
(
    (-1 0 0) (0 0 0) (1 0 0) (2 0 0)
    (-1 1 0) (0 1 0) (1 1 0) (2 1 0)
    (-1 0 0.05) (0 0 0.05) (1 0 0.05) (2 0 0.05)
    (-1 1 0.05) (0 1 0.05) (1 1 0.05) (2 1 0.05)
);

blocks
(
    hex (0 1 5 4 8 9 13 12) (20 20 1) simpleGrading (1 1 1)
    hex (1 2 6 5 9 10 14 13) (20 20 1) simpleGrading (1 1 1)
    hex (2 3 7 6 10 11 15 14) (20 20 1) simpleGrading (1 1 1)
);

boundary
(
    xMin
    {
        type patch;
        faces ((0 8 12 4));
    }
    xMax
    {
        type patch;
        faces ((3 7 15 11));
    }
    ySides
    {
        type patch;
        faces
        (
            (0 1 9 8)
            (1 2 10 9)
            (2 3 11 10)
            (4 12 13 5)
            (5 13 14 6)
            (6 14 15 7)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 4 5 1)
            (1 5 6 2)
            (2 6 7 3)
            (8 9 13 12)
            (9 10 14 13)
            (10 11 15 14)
        );
    }
);

mergePatchPairs
(
);

