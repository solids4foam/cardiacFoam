FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    conductivitySource uniform;
    cellZone        myocardium;
    bathPredictorCorrector yes;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] ( 0.111453 0 0 0.121585 0 0.0303964 );
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] ( 0.0461655 0 0 0.0503623 0 0.0125906 );
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      bathBidomainFDAManufactured;
    outputVariables
    {
        ionic
        {
            export          ( V u1 u2 u3 Iion );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedFDABathBidomainVerifier;
        k               0.707107;
        alpha           0.01;
        groundElectrode yes;
        fdaBathVariant  electrodePair;
    }
    manufacturedBidomain
    {
        k               0.707107;
        alpha           0.01;
        groundElectrode yes;
        fdaBathVariant  electrodePair;
    }
    dimension       "1D";
    solutionAlgorithm implicit;
    CFL             0.1;
    solver          RKF45;
    initialODEStep  1e-05;
    maxSteps        1000000000;
    bathPotentialDomain
    {
        bathCellZones   ( bath );
        bathConductivityField bodyAndOrgansConductivity;
        interfaceConductivityInterpolation distanceWeightedHarmonic;
        groundPatches
        {
        }
        surfaceCurrentPatches
        {
            xMax            0.01;
            xMin            -0.01;
        }
        phiERefPoint    ( -0.9 0.05 0.05 );
        phiEReferenceValue 0;
    }
}


