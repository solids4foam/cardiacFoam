// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;

    ionicModel      bidomainFDAManufactured;
    dimension       "2D";
    solutionAlgorithm implicit;
    timeCouplingScheme godunov;
    solver          RKF45;
    maxSteps        1000000000;

    cellZone        myocardium;
    exposedFacesPatch exposed;

    // Gi and Ge are cell fields written by setManufacturedFields.
    conductivitySource field;

    sealedHeartBoundary true;
    sealedWallTrace conormal;
    bathHeartPhiETrace global;
    bathPredictorCorrector true;

    bathPotentialDomain
    {
        bathCellZones   ( bathLow bathHigh );
        bathConductivityField bodyAndOrgansConductivity;
        interfaceConductivityInterpolation conormalHarmonic;
        groundPatches
        {
            outerLow    0;
            outerHigh   0;
        }
    }

    verificationModel
    {
        type            manufacturedTransmissionBathBidomainVerifier;
        solution        levelSet;
        geometry        obliqueSlab;
        geometryCoeffs
        {
            alpha       25;
            s1          0.5;
            s2          1.5;
            period      1;
        }
        conductivityCoeffs
        {
            gi          ( 0.17 0.019 0.019 );
            ge          ( 0.62 0.12 0.12 );
            theta0      -20;
            theta1      90;
            sigma0Low   0.30;
            sigma0High  0.45;
            sigmaEps    0.2;
        }
        solutionCoeffs
        {
            f           ( 0.3 0.2 0.4 0.15 );
            h           ( -0.2 0.3 0.1 );
            commonMode
            {
                amplitude   0;
                omega       0;
            }
            affine
            {
                P0          0.1;
                P1          0.4;
                C           0.3;
            }
        }
        boundaryData
        {
            dirichlet   ( outerLow outerHigh );
        }
        N               10;
        k               0.7071067811865476;

        #includeIfPresent "<case>/local/solution"
    }

    #includeIfPresent "<case>/local/configuration"
}


