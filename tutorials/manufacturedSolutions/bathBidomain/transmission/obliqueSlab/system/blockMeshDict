FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Oblique slab: five parallelepiped blocks stacked along the interface
// normal nHat = (cos alpha, sin alpha, 0). A point is x = s nHat + tau tHat
// with tHat = (-sin alpha, cos alpha, 0); tau has period 1 (cyclic sideA /
// sideB) and z is one empty cell of thickness 0.1.
//
//   block     s range      zone         shear
//   0         0   - 0.2    bathLow      0
//   1         0.2 - 0.5    bathLow      cB
//   2         0.5 - 1.5    myocardium   cH
//   3         1.5 - 1.8    bathHigh     cB
//   4         1.8 - 2.0    bathHigh     0
//
// A block with shear c has its s-direction cell edges along nHat + c tHat;
// tau at the lower edge of each block accumulates c*(block width in s).
// alpha must match geometryCoeffs.alpha of the verifier.

N       10;     // cells per unit length in s and per period in tau
cH      0.6;    // heart-block shear
cB      -0.4;   // inner bath-block shear

#includeIfPresent "<case>/local/mesh"

alpha   #eval{ 25*degToRad() };
ca      #eval{ cos($alpha) };
sa      #eval{ sin($alpha) };
dz      0.1;

// s at the six block breaks and tau of the lower edge at each break.
s0  0;
s1  0.2;
s2  0.5;
s3  1.5;
s4  1.8;
s5  2.0;

t0  0;
t1  0;
t2  #eval{ $t1 + $cB*($s2 - $s1) };
t3  #eval{ $t2 + $cH*($s3 - $s2) };
t4  #eval{ $t3 + $cB*($s4 - $s3) };
t5  $t4;

// Cells along s per block.
n0  #eval{ round($N*($s1 - $s0)) };
n1  #eval{ round($N*($s2 - $s1)) };
n2  #eval{ round($N*($s3 - $s2)) };
n3  #eval{ round($N*($s4 - $s3)) };
n4  #eval{ round($N*($s5 - $s4)) };

// Vertex 4i + {0, 1, 2, 3} at break i: (tau lower, z 0), (tau lower + 1, z 0),
// (tau lower, z dz), (tau lower + 1, z dz).
vertices
(
    #eval{ vector($s0*$ca - $t0*$sa, $s0*$sa + $t0*$ca, 0) }
    #eval{ vector($s0*$ca - ($t0 + 1)*$sa, $s0*$sa + ($t0 + 1)*$ca, 0) }
    #eval{ vector($s0*$ca - $t0*$sa, $s0*$sa + $t0*$ca, $dz) }
    #eval{ vector($s0*$ca - ($t0 + 1)*$sa, $s0*$sa + ($t0 + 1)*$ca, $dz) }

    #eval{ vector($s1*$ca - $t1*$sa, $s1*$sa + $t1*$ca, 0) }
    #eval{ vector($s1*$ca - ($t1 + 1)*$sa, $s1*$sa + ($t1 + 1)*$ca, 0) }
    #eval{ vector($s1*$ca - $t1*$sa, $s1*$sa + $t1*$ca, $dz) }
    #eval{ vector($s1*$ca - ($t1 + 1)*$sa, $s1*$sa + ($t1 + 1)*$ca, $dz) }

    #eval{ vector($s2*$ca - $t2*$sa, $s2*$sa + $t2*$ca, 0) }
    #eval{ vector($s2*$ca - ($t2 + 1)*$sa, $s2*$sa + ($t2 + 1)*$ca, 0) }
    #eval{ vector($s2*$ca - $t2*$sa, $s2*$sa + $t2*$ca, $dz) }
    #eval{ vector($s2*$ca - ($t2 + 1)*$sa, $s2*$sa + ($t2 + 1)*$ca, $dz) }

    #eval{ vector($s3*$ca - $t3*$sa, $s3*$sa + $t3*$ca, 0) }
    #eval{ vector($s3*$ca - ($t3 + 1)*$sa, $s3*$sa + ($t3 + 1)*$ca, 0) }
    #eval{ vector($s3*$ca - $t3*$sa, $s3*$sa + $t3*$ca, $dz) }
    #eval{ vector($s3*$ca - ($t3 + 1)*$sa, $s3*$sa + ($t3 + 1)*$ca, $dz) }

    #eval{ vector($s4*$ca - $t4*$sa, $s4*$sa + $t4*$ca, 0) }
    #eval{ vector($s4*$ca - ($t4 + 1)*$sa, $s4*$sa + ($t4 + 1)*$ca, 0) }
    #eval{ vector($s4*$ca - $t4*$sa, $s4*$sa + $t4*$ca, $dz) }
    #eval{ vector($s4*$ca - ($t4 + 1)*$sa, $s4*$sa + ($t4 + 1)*$ca, $dz) }

    #eval{ vector($s5*$ca - $t5*$sa, $s5*$sa + $t5*$ca, 0) }
    #eval{ vector($s5*$ca - ($t5 + 1)*$sa, $s5*$sa + ($t5 + 1)*$ca, 0) }
    #eval{ vector($s5*$ca - $t5*$sa, $s5*$sa + $t5*$ca, $dz) }
    #eval{ vector($s5*$ca - ($t5 + 1)*$sa, $s5*$sa + ($t5 + 1)*$ca, $dz) }
);

// Local block axes: s, tau, z.
blocks
(
    hex (0 4 5 1 2 6 7 3) bathLow ($n0 $N 1) simpleGrading (1 1 1)
    hex (4 8 9 5 6 10 11 7) bathLow ($n1 $N 1) simpleGrading (1 1 1)
    hex (8 12 13 9 10 14 15 11) myocardium ($n2 $N 1) simpleGrading (1 1 1)
    hex (12 16 17 13 14 18 19 15) bathHigh ($n3 $N 1) simpleGrading (1 1 1)
    hex (16 20 21 17 18 22 23 19) bathHigh ($n4 $N 1) simpleGrading (1 1 1)
);

boundary
(
    outerLow
    {
        type patch;
        faces ((0 2 3 1));
    }
    outerHigh
    {
        type patch;
        faces ((20 21 23 22));
    }
    sideA
    {
        type cyclic;
        neighbourPatch sideB;
        transform translational;
        separationVector #eval{ vector(-$sa, $ca, 0) };
        faces
        (
            (0 4 6 2)
            (4 8 10 6)
            (8 12 14 10)
            (12 16 18 14)
            (16 20 22 18)
        );
    }
    sideB
    {
        type cyclic;
        neighbourPatch sideA;
        transform translational;
        separationVector #eval{ vector($sa, -$ca, 0) };
        faces
        (
            (1 3 7 5)
            (5 7 11 9)
            (9 11 15 13)
            (13 15 19 17)
            (17 19 23 21)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 1 5 4)
            (4 5 9 8)
            (8 9 13 12)
            (12 13 17 16)
            (16 17 21 20)
            (2 6 7 3)
            (6 10 11 7)
            (10 14 15 11)
            (14 18 19 15)
            (18 22 23 19)
        );
    }
    exposed
    {
        type patch;
        faces ();
    }
);

