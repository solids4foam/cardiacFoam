// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;

    ionicModel      bidomainFDAManufactured;
    dimension       "3D";
    solutionAlgorithm implicit;
    timeCouplingScheme godunov;
    solver          RKF45;
    maxSteps        1000000000;

    cellZone        myocardium;
    exposedFacesPatch exposed;

    // Gi and Ge are cell fields written by setManufacturedFields.
    conductivitySource field;

    sealedHeartBoundary true;
    sealedWallTrace zeroGradient;
    bathHeartPhiETrace global;
    bathPredictorCorrector true;

    bathPotentialDomain
    {
        bathCellZones   ( bloodPool bath );
        bathConductivityField bodyAndOrgansConductivity;
        interfaceConductivityInterpolation conormalHarmonic;
        surfaceCurrentPatches
        {
            outer       0;
        }
        phiERefPoint    ( 1.23456 -1.13579 0.98765 );

        #includeIfPresent "<case>/local/outer"
    }

    verificationModel
    {
        type            manufacturedTransmissionBathBidomainVerifier;
        solution        levelSet;
        geometry        sphericalShell;
        geometryCoeffs
        {
            r1          0.5;
            r2          1;
        }
        conductivityCoeffs
        {
            gi          ( 0.17 0.019 0.01 );
            ge          ( 0.62 0.12 0.08 );
            frame       ( 20 50 );
            theta0      -20;
            theta1      90;
            sigma0In    0.6;
            sigma0Out   0.25;
            sigmaEps    0.2;
        }
        solutionCoeffs
        {
            wavelength  2;
            f           ( 0.3 0.2 0.4 0.15 );
            h           ( -0.1 0.3 0.25 );
            commonMode
            {
                amplitude   0;
                omega       0;
            }
        }
        boundaryData
        {
            neumann     ( outer );
        }
        N               10;

        #includeIfPresent "<case>/local/solution"
    }

    #includeIfPresent "<case>/local/configuration"
}


