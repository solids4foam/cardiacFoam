FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    activationLineProbes
    {
        type            probes;
        libs            ("libsampling.so");

        probeLocations
        (
            (0.0 0.5 0.5)
            (0.2 0.5 0.5)
            (0.4 0.5 0.5)
            (0.6 0.5 0.5)
            (0.8 0.5 0.5)
            (1.0 0.5 0.5)
        );

        fields
        (
            psi
            Vm
            externalStimulusCurrent
        );

        writeControl    runTime;
        writeInterval   1;
    }
}

