FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "psi|psiFinal"
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-11;
        relTol          0.1;
    }

    asymmetric_psi
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-11;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors    5000;

    residualControl
    {
        psi
        {
            relTol          0.0;
            tolerance       1e-11;
        }
    }
}

relaxationFactors
{
    equations
    {
        psi    0.9;
    }
    fields
    {
    }
}

