FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}

solvers
{
    "activationTime|activationTimeFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.0;
    }

    asymmetric_activationTime
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-11;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors    8000;
    #includeIfPresent "<case>/local/outer"

    residualControl
    {
        activationTime
        {
            relTol          0.0;
            tolerance       1e-8;
        }
    }
}

relaxationFactors
{
    equations
    {
        "activationTime.*"    0.9;
    }
    fields
    {
    }
}


