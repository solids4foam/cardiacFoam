#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

usage()
{
    cat <<USAGE
Usage: ${0##*/} [parallel] [OPTION]...

Options (parameters are written to local/ and included by the dictionaries):
  parallel                  decomposePar, run cardiacFoam in parallel, reconstructPar
  -mesh hex|tet             blockMesh cubed sphere (default) or gmsh tetrahedra (shell.geo.template)
  -N n                      cells per unit length (default 12); hex: a multiple of 4, radial
                            cells per unit length; tet: element size 1/n
  -seed n                   gmsh random seed for -mesh tet (default 1)
  -wallGradient sealed|stock
                            gradient of activationTime: sealedWallLeastSquares (default) or
                            the stock leastSquares control
  -formulation explicit|advectionDiffusion
                            eikonalAdvectionDiffusionApproach false or true (default)
  -iterations n             at most n outer iterations (default 8000, stopped by the
                            residual control)
  -exactStart               start the iteration from the exact field outside the pinned
                            cells (initialiseExact)
  -pinnedRadius x           radius of the ball of pinned cells around the stimulus point
                            (default the header's rPin, 0.15)

-mesh tet needs gmsh (tested with 4.15.2) and gmshToFoam.
USAGE
    exit 2
}

parallel=false
mesh=hex
N=12
seed=1
wallGradient=sealed
formulation=advectionDiffusion
iterations=
exactStart=false
pinnedRadius=

needValue()
{
    [ "$#" -ge 2 ] || { echo "${0##*/}: $1 needs a value" 1>&2; usage; }
}

positiveInteger()
{
    case "$2" in
        ''|*[!0-9]*|0*)
            echo "${0##*/}: $1 takes a positive integer, not $2" 1>&2
            usage
            ;;
    esac
}

while [ "$#" -gt 0 ]
do
    case "$1" in
        parallel)
            parallel=true
            ;;
        -mesh)
            needValue "$@"; mesh="$2"; shift
            case "$mesh" in
                hex|tet) ;;
                *) echo "${0##*/}: unknown -mesh $mesh" 1>&2; usage ;;
            esac
            ;;
        -N)
            needValue "$@"; N="$2"; shift
            positiveInteger -N "$N"
            ;;
        -seed)
            needValue "$@"; seed="$2"; shift
            positiveInteger -seed "$seed"
            ;;
        -wallGradient)
            needValue "$@"; wallGradient="$2"; shift
            case "$wallGradient" in
                sealed|stock) ;;
                *) echo "${0##*/}: unknown -wallGradient $wallGradient" 1>&2; usage ;;
            esac
            ;;
        -formulation)
            needValue "$@"; formulation="$2"; shift
            case "$formulation" in
                explicit|advectionDiffusion) ;;
                *) echo "${0##*/}: unknown -formulation $formulation" 1>&2; usage ;;
            esac
            ;;
        -iterations)
            needValue "$@"; iterations="$2"; shift
            positiveInteger -iterations "$iterations"
            ;;
        -exactStart)
            exactStart=true
            ;;
        -pinnedRadius)
            needValue "$@"; pinnedRadius="$2"; shift
            awk -v r="$pinnedRadius" 'BEGIN { exit !(r ~ /^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/ && r > 0) }' \
                || { echo "${0##*/}: -pinnedRadius takes a positive number, not $pinnedRadius" 1>&2; usage; }
            ;;
        -h|-help|--help)
            usage
            ;;
        *)
            echo "${0##*/}: unknown argument $1" 1>&2
            usage
            ;;
    esac
    shift
done

if [ -e log.gmsh ] || [ -e log.blockMesh ]
then
    echo "${0##*/}: a mesh log exists; run ./Allclean first" 1>&2
    exit 1
fi

if [ "$mesh" = hex ] && [ $((N % 4)) -ne 0 ]
then
    echo "${0##*/}: -mesh hex takes -N as a multiple of 4, not $N" 1>&2
    usage
fi

if [ "$mesh" = tet ]
then
    for tool in gmsh gmshToFoam
    do
        command -v "$tool" > /dev/null || { echo "${0##*/}: $tool not found" 1>&2; exit 1; }
    done
fi

rm -rf local
mkdir local

echo "N $N;" > local/mesh
{
    echo "N $N;"
    echo "initialiseExact $exactStart;"
    if [ -n "$pinnedRadius" ]
    then
        echo "pinnedRadius $pinnedRadius;"
    fi
} > local/verification

# The stock control overrides the gradient entries of system/fvSchemes
if [ "$wallGradient" = stock ]
then
    cat > local/wallGradient <<EOT
grad(activationTime)                leastSquares;
grad(activationTime.component(0))   leastSquares;
EOT
fi

if [ "$formulation" = advectionDiffusion ]
then
    echo "eikonalAdvectionDiffusionApproach true;" > local/formulation
else
    echo "eikonalAdvectionDiffusionApproach false;" > local/formulation
fi

if [ -n "$iterations" ]
then
    echo "nOuterCorrectors $iterations;" > local/outer
fi

# Mesh: blockMesh cubed sphere, or gmsh tetrahedra
if [ "$mesh" = hex ]
then
    runApplication blockMesh
else
    lc=$(awk -v N="$N" 'BEGIN { printf "%.17g", 1/N }')
    cp shell.geo.template local/shell.geo
    runApplication gmsh -3 local/shell.geo -setnumber lc "$lc" -setnumber seed "$seed" -o local/shell.msh
    if grep -q "Error" log.gmsh
    then
        echo "${0##*/}: gmsh reported errors; see log.gmsh" 1>&2
        exit 1
    fi
    runApplication gmshToFoam local/shell.msh
fi
runApplication checkMesh
if grep -q "Failed [0-9]* mesh checks" log.checkMesh
then
    echo "checkMesh reported failed mesh checks; see log.checkMesh" 1>&2
    exit 1
fi

# The cell-wise conductivity 0/Conductivity
runApplication setManufacturedFields

if $parallel
then
    runApplication decomposePar
    runParallel cardiacFoam
    runApplication reconstructPar -latestTime
else
    runApplication cardiacFoam
fi
