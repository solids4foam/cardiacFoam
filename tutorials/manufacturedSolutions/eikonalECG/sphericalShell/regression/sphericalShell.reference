# Reference grammar: tutorials/regression/lib.sh.
# summary <key> <expected> <tolerance>; error <field> <norm> <expected> <tolerance>
# Error tolerances 1e-4 relative: set by the outer residual tolerance 1e-8
summary  cellsPerDirection  12  0
summary  finalTime          1  1e-12
error    activationTime                    L2    2.0416576  0.0002
error    activationTime                    Linf  4.92102606  0.00049
