// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}

myocardiumSolver eikonalSolver;

eikonalSolverCoeffs
{
    conductivitySource uniform;
    conductivity    [ -1 -3 3 0 0 2 0 ] ( 0.106875 -0.0084931 -0.022561 0.116682 -0.0130256 0.0398782 );
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    c0              [ 0 0 -0.5 0 0 0 0 ] 1;
    eikonalAdvectionDiffusionApproach true;
    stimulusLocationMin ( 0 0 0 );
    stimulusLocationMax ( 0.05 1 1 );
    verificationModel
    {
        type    manufacturedEikonalVerifier;
        writeErrorField false;
    }
    ecgDomains
    {
        ECG
        {
            ecgSolver    eikonalECG;
            sampling
            {
                start           0;
                end             2;
                deltaT          0.01;
            }
            verificationModel
            {
                type    manufacturedEikonalECGVerifier;
                enabled    yes;
                referenceQuadratureOrder    96;
                checkQuadratureOrders    (6 12 24 48 96);
            }
            electrodePositions
            {
                E1    (-0.5 0.5 0.5);
                E2    (1.5 0.5 0.5);
                E3    (1.2 0.23 0.61);
                E4    (1.35 0.74 0.28);
                E5    (1.55 0.41 0.83);
            }
        }
    }
}


// ************************************************************************* //
useGraphPrePopulation false;
