// Unit-cube [0,1]^3 tetrahedral mesh, identical to the monodomain and bidomain tet
// templates so every solver refines on the same mesh sequence.
//
// lc is a DefineConstant, set per resolution with `gmsh -setnumber lc <value>`
// (lc = 1/N); the default is the coarsest study level.
//
// Unlike the monodomain case, the eikonal verifier does not rely on a zero-flux
// boundary: it sets every non-empty boundary patch to fixedValue (keyed on patch
// type, not name), so the single "boundary" surface suffices.

SetFactory("OpenCASCADE");

DefineConstant[ lc = { 0.1, Name "lc" } ];

Box(1) = {0, 0, 0, 1, 1, 1};

Physical Volume("internal") = {1};
Physical Surface("boundary") = {1, 2, 3, 4, 5, 6};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.Algorithm3D = 1;      // Delaunay: near-uniform, isotropic tets
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2; // gmshToFoam requires the legacy msh2 format
