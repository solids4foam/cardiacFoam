FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// eikonalECG's hex-mesh defaults (diagonal/DILU preconditioners, relax 0.9).
// Tried transplanting eikonalHeart's (preconditioner none, relax 0.3)
// settings from the real anatomical case -- that made this case *worse*
// (N=40 outer residual only reached 1.5e-2 in 500 iterations, vs ~1.9e-4 at
// relax=0.9 in a comparable budget at N=80): this tet mesh's outer loop is
// decaying smoothly (not oscillating/diverging), so heavier under-relaxation
// just shrinks each step without fixing anything. Reverted to the
// eikonalECG baseline; the slow-rate problem here needs a different fix
// than eikonalHeart's, not yet identified.
solvers
{
    "activationTime|activationTimeFinal"
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-11;
        relTol          0.1;
    }

    asymmetric_activationTime
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-11;
        relTol          0.0;
    }
}

PIMPLE
{
    nOuterCorrectors    8000;

    residualControl
    {
        activationTime
        {
            relTol          0.0;
            tolerance       1e-8;
        }
    }
}

relaxationFactors
{
    equations
    {
        activationTime    0.9;
    }
    fields
    {
    }
}

