FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      activationTime;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 1 0 0 0 0];

// -1 marks "not yet activated"; the solve overwrites it.
internalField   uniform -1;

boundaryField
{
    walls
    {
        // Insulated wall under test, listed in productionPatches.
        // sealedWallTrace conormal replaces zeroGradient by conormalZeroFlux.
        type            zeroGradient;
    }
    ".*"
    {
        // manufacturedEikonalVerifier::applyConstraints writes the exact
        // solution onto these faces every step.
        type            fixedValue;
        value           uniform 0;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}

