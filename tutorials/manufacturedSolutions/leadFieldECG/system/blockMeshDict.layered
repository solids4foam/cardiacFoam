FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Five blocks along x: torso layers [-1, -0.5] and [-0.5, 0], heart [0, 1],
// torso layers [1, 1.5] and [1.5, 2]; N cells per unit length (N even)
N 10;
NHalf 5;
#includeIfPresent "<case>/local/mesh"

vertices
(
    (-1 0 0) (-0.5 0 0) (0 0 0) (1 0 0) (1.5 0 0) (2 0 0)
    (-1 1 0) (-0.5 1 0) (0 1 0) (1 1 0) (1.5 1 0) (2 1 0)
    (-1 0 1) (-0.5 0 1) (0 0 1) (1 0 1) (1.5 0 1) (2 0 1)
    (-1 1 1) (-0.5 1 1) (0 1 1) (1 1 1) (1.5 1 1) (2 1 1)
);

blocks
(
    hex (0 1 7 6 12 13 19 18) ($NHalf $N $N) simpleGrading (1 1 1)
    hex (1 2 8 7 13 14 20 19) ($NHalf $N $N) simpleGrading (1 1 1)
    hex (2 3 9 8 14 15 21 20) ($N $N $N) simpleGrading (1 1 1)
    hex (3 4 10 9 15 16 22 21) ($NHalf $N $N) simpleGrading (1 1 1)
    hex (4 5 11 10 16 17 23 22) ($NHalf $N $N) simpleGrading (1 1 1)
);

boundary
(
    xMin
    {
        type patch;
        faces ((0 12 18 6));
    }
    xMax
    {
        type patch;
        faces ((5 11 23 17));
    }
    sides
    {
        type patch;
        faces
        (
            (0 1 13 12)
            (6 18 19 7)
            (0 6 7 1)
            (12 13 19 18)
            (1 2 14 13)
            (7 19 20 8)
            (1 7 8 2)
            (13 14 20 19)
            (2 3 15 14)
            (8 20 21 9)
            (2 8 9 3)
            (14 15 21 20)
            (3 4 16 15)
            (9 21 22 10)
            (3 9 10 4)
            (15 16 22 21)
            (4 5 17 16)
            (10 22 23 11)
            (4 10 11 5)
            (16 17 23 22)
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
