#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

usage()
{
    cat <<USAGE
Usage: ${0##*/} [parallel] [OPTION]...

Options (parameters are written to local/ and included by the dictionaries):
  parallel                  decomposePar, buildLeadFields and cardiacFoam in parallel
  -mesh hex|tet             blockMesh cubed sphere (default) or gmsh tetrahedra
                            (shell.geo.template)
  -N n                      cells per unit length (default 12); hex: a multiple of 4,
                            radial heart cells per unit length; tet: element size 1/n
  -seed n                   gmsh random seed for -mesh tet (default 1)

-mesh tet needs gmsh (tested with 4.15.2) and gmshToFoam.
USAGE
    exit 2
}

parallel=false
mesh=hex
N=12
seed=1

needValue()
{
    [ "$#" -ge 2 ] || { echo "${0##*/}: $1 needs a value" 1>&2; usage; }
}

positiveInteger()
{
    case "$2" in
        ''|*[!0-9]*|0*)
            echo "${0##*/}: $1 takes a positive integer, not $2" 1>&2
            usage
            ;;
    esac
}

while [ "$#" -gt 0 ]
do
    case "$1" in
        parallel)
            parallel=true
            ;;
        -mesh)
            needValue "$@"; mesh="$2"; shift
            case "$mesh" in
                hex|tet) ;;
                *) echo "${0##*/}: unknown -mesh $mesh" 1>&2; usage ;;
            esac
            ;;
        -N)
            needValue "$@"; N="$2"; shift
            positiveInteger -N "$N"
            ;;
        -seed)
            needValue "$@"; seed="$2"; shift
            positiveInteger -seed "$seed"
            ;;
        -h|-help|--help)
            usage
            ;;
        *)
            echo "${0##*/}: unknown argument $1" 1>&2
            usage
            ;;
    esac
    shift
done

if [ -e log.gmsh ] || [ -e log.blockMesh ]
then
    echo "${0##*/}: a mesh log exists; run ./Allclean first" 1>&2
    exit 1
fi

if [ "$mesh" = hex ] && [ $((N % 4)) -ne 0 ]
then
    echo "${0##*/}: -mesh hex takes -N as a multiple of 4, not $N" 1>&2
    usage
fi

if [ "$mesh" = tet ]
then
    for tool in gmsh gmshToFoam
    do
        command -v "$tool" > /dev/null || { echo "${0##*/}: $tool not found" 1>&2; exit 1; }
    done
fi

rm -rf local
mkdir local
echo "N $N;" > local/mesh

# Mesh with the cellZones bloodPool, myocardium and bath and the patch outer
if [ "$mesh" = hex ]
then
    runApplication blockMesh
else
    lc=$(awk -v N="$N" 'BEGIN { printf "%.17g", 1/N }')
    runApplication gmsh -3 shell.geo.template -setnumber lc "$lc" -setnumber seed "$seed" \
        -o local/shell.msh
    if grep -q "Error" log.gmsh
    then
        echo "${0##*/}: gmsh reported errors; see log.gmsh" 1>&2
        exit 1
    fi
    runApplication gmshToFoam local/shell.msh
fi
runApplication checkMesh

# Gi, Ge and the torso conductivity of the transmission solution
runApplication setManufacturedFields

# Lead fields of the ECG domain, then one step
if $parallel
then
    runApplication decomposePar
    runParallel buildLeadFields
    runParallel cardiacFoam
else
    runApplication buildLeadFields
    runApplication cardiacFoam
fi
