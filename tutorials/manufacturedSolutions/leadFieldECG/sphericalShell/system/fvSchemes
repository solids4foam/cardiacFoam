FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         none;
    ddt(Vm)         backward;
}

// Sealed heart walls: the heart potentials use the sealed-wall gradient
gradSchemes
{
    default                 leastSquares;
    grad(Vm)                sealedWallLeastSquares;
    grad(Vm.component(0))   sealedWallLeastSquares;
    grad(phiE)              sealedWallLeastSquares;
    grad(phiE.component(0)) sealedWallLeastSquares;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}


