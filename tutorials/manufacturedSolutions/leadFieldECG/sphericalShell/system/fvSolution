FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
    }

    // phiE: the bidomain heart potential and the verifier's direct
    // forward solve
    "phiE|phiEFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-15;
        relTol          0.0;
        // PCG iteration cap; the study README gives the counts reached
        maxIter         5000;
    }

    // buildLeadFields: the lead fields solve (M + C^T) z = e with the assembled
    // matrix through PETSc (conductorLinearSolve)
    leadField
    {
        solver              petsc;
        // True relative residual of the real operator, fatal above
        residualTolerance   1e-10;
        options
        {
            snes_type           ksponly;
            ksp_type            gmres;
            ksp_gmres_restart   "200";
            ksp_pc_side         right;
            ksp_norm_type       unpreconditioned;
            ksp_rtol            "1e-12";
            ksp_atol            "0";
            ksp_max_it          "5000";
            pc_type             gamg;
            #includeIfPresent "<case>/local/solve"
        }
    }

    // The lead-field verifier's direct forward solve (M + C) phi = b, as
    // leadField
    leadFieldDirect
    {
        solver              petsc;
        // True relative residual of the real operator, fatal above
        residualTolerance   1e-10;
        options
        {
            snes_type           ksponly;
            ksp_type            gmres;
            ksp_gmres_restart   "200";
            ksp_pc_side         right;
            ksp_norm_type       unpreconditioned;
            ksp_rtol            "1e-12";
            ksp_atol            "0";
            ksp_max_it          "5000";
            pc_type             gamg;
            #includeIfPresent "<case>/local/solve"
        }
    }
}


PIMPLE
{
    nOuterCorrectors         1;
    nNonOrthogonalCorrectors 0;
}


