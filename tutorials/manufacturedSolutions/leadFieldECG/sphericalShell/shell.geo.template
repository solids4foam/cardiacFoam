// Spherical heart shell r1 < |x| < r2 around the bath ball bloodPool, inside
// the bath ball |x| < r3; Delaunay tetrahedra of size lc. Set lc and seed with
// gmsh -setnumber lc <value> -setnumber seed <value>.

SetFactory("OpenCASCADE");

DefineConstant[ lc = { 1/8, Name "lc" }, seed = { 1, Name "seed" } ];

r1 = 0.5;
r2 = 1.0;
r3 = 1.5;
e = 1e-6;

Sphere(1) = {0, 0, 0, r3};
Sphere(2) = {0, 0, 0, r2};
Sphere(3) = {0, 0, 0, r1};
BooleanFragments{ Volume{1, 2, 3}; Delete; }{}

ball() = Volume In BoundingBox{-r1 - e, -r1 - e, -r1 - e, r1 + e, r1 + e, r1 + e};
inner() = Volume In BoundingBox{-r2 - e, -r2 - e, -r2 - e, r2 + e, r2 + e, r2 + e};
shell() = inner();
shell() -= ball();
outer() = Volume{:};
outer() -= inner();

outerFaces() = Abs(Boundary{ Volume{outer()}; });
sphereFaces() = Surface In BoundingBox{-r2 - e, -r2 - e, -r2 - e, r2 + e, r2 + e, r2 + e};
outerFaces() -= sphereFaces();

Physical Volume("bloodPool") = {ball()};
Physical Volume("myocardium") = {shell()};
Physical Volume("bath") = {outer()};
Physical Surface("outer") = {outerFaces()};

Mesh.MeshSizeMin = lc;
Mesh.MeshSizeMax = lc;
Mesh.MeshSizeFromCurvature = 0;
Mesh.Algorithm = 6;
Mesh.Algorithm3D = 1;      // Delaunay: near-uniform, isotropic tets
Mesh.Optimize = 1;
Mesh.RandomSeed = seed;
Mesh.MaxNumThreads1D = 1;  // one thread: the same mesh for the same lc and seed
Mesh.MaxNumThreads2D = 1;
Mesh.MaxNumThreads3D = 1;
General.NumThreads = 1;
Mesh.MshFileVersion = 2.2; // gmshToFoam requires the legacy msh2 format
