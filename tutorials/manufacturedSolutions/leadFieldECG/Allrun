#!/bin/bash
cd "${0%/*}" || exit 1
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

usage()
{
    cat <<USAGE
Usage: ${0##*/} [parallel] [OPTION]...

Options (parameters are written to local/ and included by the dictionaries):
  parallel                  decomposePar (2 subdomains), then buildLeadFields
                            and cardiacFoam in parallel
  -problem slab|layered     exact passive solution (default slab):
                              slab     insulated heart slab between torso slabs
                              layered  the slab with each torso slab split in
                                       two layers (conductivity 0.1 next to
                                       the heart, 0.02 beyond x = -0.5 and
                                       x = 1.5) and the surface currents
                                       -alpha on xMin and alpha on xMax
  -alpha x                  current of -problem layered (default 0.01); 0 leaves
                            the outer boundary insulated; a current needs
                            -myocardium monodomain
  -mesh hex|tet             blockMesh box (default) or gmsh tetrahedra
                            (three_domain_box.geo.template, layered_box.geo.template)
  -N n                      cells per unit length (default 10; even for
                            -problem layered -mesh hex); tet: element size 1/n
  -seed n                   gmsh random seed for -mesh tet (default 1)
  -myocardium monodomain|bidomain
                            myocardium solver (default monodomain)
  -conductivity anisotropic|isotropic|unequal
                            heart conductivities (default anisotropic):
                              anisotropic  diagonal, different along x, y, z;
                                           Ge proportional to Gi
                              isotropic    the xx values in every direction
                              unequal      the anisotropic xx values; Ge/Gi
                                           is 1 along y and 0.1 along z
  -snGrad corrected|orthogonal
                            non-orthogonal correction of the laplacian and snGrad
                            schemes (default corrected)
  -dt x                     time step (default 0.01)
  -endTime x                end time (default 0.05)
  -fixedPointTolerance x    tolerance of the lead-field and direct fixed
                            points (default 1e-10, system/fvSolution)

-mesh tet needs gmsh (tested with 4.15.2) and gmshToFoam.
USAGE
    exit 2
}

parallel=false
problem=slab
alpha=
mesh=hex
N=10
seed=1
myocardium=monodomain
conductivity=anisotropic
snGrad=corrected
dt=0.01
fixedPointTolerance=
endTime=0.05

needValue()
{
    [ "$#" -ge 2 ] || { echo "${0##*/}: $1 needs a value" 1>&2; usage; }
}

positiveInteger()
{
    case "$2" in
        ''|*[!0-9]*|0*)
            echo "${0##*/}: $1 takes a positive integer, not $2" 1>&2
            usage
            ;;
    esac
}

positiveNumber()
{
    awk -v r="$2" 'BEGIN { exit !(r ~ /^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/ && r > 0) }' \
        || { echo "${0##*/}: $1 takes a positive number, not $2" 1>&2; usage; }
}

oneOf()
{
    local option="$1" value="$2"
    shift 2
    for allowed in "$@"
    do
        [ "$value" = "$allowed" ] && return 0
    done
    echo "${0##*/}: unknown $option $value" 1>&2
    usage
}

while [ "$#" -gt 0 ]
do
    case "$1" in
        parallel)
            parallel=true
            ;;
        -problem)
            needValue "$@"; problem="$2"; shift
            oneOf -problem "$problem" slab layered
            ;;
        -alpha)
            needValue "$@"; alpha="$2"; shift
            awk -v r="$alpha" 'BEGIN { exit !(r ~ /^[-+]?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/) }' \
                || { echo "${0##*/}: -alpha takes a number, not $alpha" 1>&2; usage; }
            ;;
        -mesh)
            needValue "$@"; mesh="$2"; shift
            oneOf -mesh "$mesh" hex tet
            ;;
        -N)
            needValue "$@"; N="$2"; shift
            positiveInteger -N "$N"
            ;;
        -seed)
            needValue "$@"; seed="$2"; shift
            positiveInteger -seed "$seed"
            ;;
        -myocardium)
            needValue "$@"; myocardium="$2"; shift
            oneOf -myocardium "$myocardium" monodomain bidomain
            ;;
        -conductivity)
            needValue "$@"; conductivity="$2"; shift
            oneOf -conductivity "$conductivity" anisotropic isotropic unequal
            ;;
        -snGrad)
            needValue "$@"; snGrad="$2"; shift
            oneOf -snGrad "$snGrad" corrected orthogonal
            ;;
        -dt)
            needValue "$@"; dt="$2"; shift
            positiveNumber -dt "$dt"
            ;;
        -endTime)
            needValue "$@"; endTime="$2"; shift
            positiveNumber -endTime "$endTime"
            ;;
        -fixedPointTolerance)
            needValue "$@"; fixedPointTolerance="$2"; shift
            positiveNumber -fixedPointTolerance "$fixedPointTolerance"
            ;;
        -h|-help|--help)
            usage
            ;;
        *)
            echo "${0##*/}: unknown argument $1" 1>&2
            usage
            ;;
    esac
    shift
done

if [ -n "$alpha" ] && [ "$problem" != layered ]
then
    echo "${0##*/}: -alpha applies to -problem layered only" 1>&2
    usage
fi

if [ "$problem" = layered ] && [ "$myocardium" = bidomain ] \
    && awk -v a="${alpha:-0.01}" 'BEGIN { exit !(a + 0 != 0) }'
then
    echo "${0##*/}: -problem layered with a current is monodomain only;" \
        "use -alpha 0 with -myocardium bidomain" 1>&2
    usage
fi

if [ "$problem" = layered ] && [ "$mesh" = hex ] && [ $((N % 2)) -ne 0 ]
then
    echo "${0##*/}: -problem layered -mesh hex needs an even -N, not $N" 1>&2
    usage
fi

if [ -e log.gmsh ] || [ -e log.blockMesh ]
then
    echo "${0##*/}: a mesh log exists; run ./Allclean first" 1>&2
    exit 1
fi

if [ "$mesh" = tet ]
then
    for tool in gmsh gmshToFoam
    do
        command -v "$tool" > /dev/null || { echo "${0##*/}: $tool not found" 1>&2; exit 1; }
    done
fi

rm -rf local
mkdir local

echo "N $N;" > local/mesh
echo "myocardiumSolver ${myocardium}Solver;" > local/myocardium

# The exact solution of the verifier, and its geometry and torso
case "$problem" in
    slab)
        echo "reference slab;" > local/reference
        geometry=three_domain_box
        dictSuffix=
        ;;
    layered)
        cat > local/reference <<EOF
reference       layered;
layerInterfaces ( -0.5 1.5 );
EOF
        geometry=layered_box
        dictSuffix=.layered
        echo "NHalf $((N/2));" >> local/mesh
        echo "bathCellZones ( torsoInner torsoOuter );" > local/torso
        alpha=${alpha:-0.01}
        if awk -v a="$alpha" 'BEGIN { exit !(a != 0) }'
        then
            cat >> local/torso <<EOF
surfaceCurrentPatches
{
    xMin            $(awk -v a="$alpha" 'BEGIN { printf "%.17g", -a }');
    xMax            $(awk -v a="$alpha" 'BEGIN { printf "%.17g", a }');
}
EOF
        fi
        ;;
esac

# Isotropic: every diagonal entry takes the xx value
if [ "$conductivity" = isotropic ]
then
    cat > local/conductivity <<EOF
_monodomainG     ( 0.111453302 0 0 0.111453302 0 0.111453302 );
_monodomainGi    ( 0.380525375260 0 0 0.380525375260 0 0.380525375260 );
_monodomainGe    ( 0.157618771260 0 0 0.157618771260 0 0.157618771260 );
_bidomainGi      ( 0.111453302 0 0 0.111453302 0 0.111453302 );
_bidomainGe      ( 0.046165469 0 0 0.046165469 0 0.046165469 );
EOF
fi

# Unequal: Gi and the xx entries as anisotropic; Ge yy = Gi yy and
# Ge zz = 0.1 Gi zz, and G_m = Gi (Gi+Ge)^-1 Ge
if [ "$conductivity" = unequal ]
then
    cat > local/conductivity <<EOF
_monodomainG     ( 0.111453302 0 0 0.207559294976 0 0.009434513408 );
_monodomainGi    ( 0.380525375260 0 0 0.415118589951 0 0.103779647488 );
_monodomainGe    ( 0.157618771260 0 0 0.415118589951 0 0.0103779647488 );
_bidomainGi      ( 0.111453302 0 0 0.121585420 0 0.030396355 );
_bidomainGe      ( 0.046165469 0 0 0.121585420 0 0.0030396355 );
EOF
fi

echo "default         Gauss linear $snGrad;" > local/laplacian
echo "default         $snGrad;" > local/snGrad
rm -f local/fixedPoint
if [ -n "$fixedPointTolerance" ]
then
    echo "tolerance       $fixedPointTolerance;" > local/fixedPoint
fi

cat > local/time <<EOF
endTime         $endTime;
deltaT          $dt;
writeInterval   $endTime;
EOF

# Mesh: blockMesh box, or gmsh tetrahedra
if [ "$mesh" = hex ]
then
    runApplication blockMesh ${dictSuffix:+-dict system/blockMeshDict$dictSuffix}
else
    lc=$(awk -v N="$N" 'BEGIN { printf "%.17g", 1/N }')
    runApplication gmsh -3 $geometry.geo.template -setnumber lc "$lc" -setnumber seed "$seed" \
        -o local/$geometry.msh
    if grep -q "Error" log.gmsh
    then
        echo "${0##*/}: gmsh reported errors; see log.gmsh" 1>&2
        exit 1
    fi
    runApplication gmshToFoam local/$geometry.msh
fi
runApplication checkMesh

# The myocardium and torso cellZones, and the torso conductivity
runApplication topoSet ${dictSuffix:+-dict system/topoSetDict$dictSuffix}
runApplication setTorsoOrganConductivityField \
    ${dictSuffix:+-dict system/setTorsoOrganConductivityFieldDict$dictSuffix}

# Lead fields of the ECG domain, then the run
if $parallel
then
    runApplication decomposePar
    runParallel buildLeadFields
    runParallel cardiacFoam
else
    runApplication buildLeadFields
    runApplication cardiacFoam
fi
