FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Myocardium on the cellZone myocardium of the heart+torso mesh; the torso
// is the cellZone bath. The dictionary holds the defaults: the monodomain
// heart, the conductivity set anisotropic and the reference slab. Allrun
// writes its options into local/.

myocardiumSolver monodomainSolver;

#includeIfPresent "<case>/local/myocardium"

// Heart conductivity sets (S/m). The set anisotropic is the one written in
// monodomainSolverCoeffs, bidomainSolverCoeffs and ecgDomains.ECG: diagonal,
// different along x, y, z, Ge proportional to Gi, and the bidomain Gi and Ge
// those of manufacturedSolutions/bidomain. Allrun -conductivity isotropic or
// unequal writes the set below into local/. In every set the monodomain
// conductivity equals Gi (Gi+Ge)^-1 Ge of its ECG domain, and
// Gi_xx/(Gi_xx+Ge_xx) = 1/sqrt(2).
_conductivities
{
    // The anisotropic xx values in every direction
    isotropic
    {
        _monodomainG     ( 0.111453302 0 0 0.111453302 0 0.111453302 );
        _monodomainGi    ( 0.380525375260 0 0 0.380525375260 0 0.380525375260 );
        _monodomainGe    ( 0.157618771260 0 0 0.157618771260 0 0.157618771260 );
        _bidomainGi      ( 0.111453302 0 0 0.111453302 0 0.111453302 );
        _bidomainGe      ( 0.046165469 0 0 0.046165469 0 0.046165469 );
    }

    // Gi and the xx entries as anisotropic; Ge yy = Gi yy and
    // Ge zz = 0.1 Gi zz, and G_m = Gi (Gi+Ge)^-1 Ge
    unequal
    {
        _monodomainG     ( 0.111453302 0 0 0.207559294976 0 0.009434513408 );
        _monodomainGi    ( 0.380525375260 0 0 0.415118589951 0 0.103779647488 );
        _monodomainGe    ( 0.157618771260 0 0 0.415118589951 0 0.0103779647488 );
        _bidomainGi      ( 0.111453302 0 0 0.121585420 0 0.030396355 );
        _bidomainGe      ( 0.046165469 0 0 0.121585420 0 0.0030396355 );
    }
}

// Body surface: eight electrodes 0.003 inside the outer faces of the torso
// slabs, two on each end face (x = -1, x = 2) and one on each of four side
// faces, in both layers of -problem layered. Interior probes: two in the left
// slab and one in the right, and one in each slab next to the heart. None
// lies on a hexahedral face at N = 10, 20, 40, 80
_leadFieldElectrodes
{
    surface1        ( -0.997 0.3137 0.6871 );
    surface2        ( -0.997 0.7213 0.2419 );
    surface3        ( 1.997 0.4127 0.5813 );
    surface4        ( 1.997 0.8317 0.1733 );
    surface5        ( -0.3713 0.003 0.4419 );
    surface6        ( -0.6871 0.5371 0.997 );
    surface7        ( 1.3317 0.997 0.6137 );
    surface8        ( 1.7219 0.2713 0.003 );
    torsoLeft       ( -0.4567 0.4137 0.5871 );
    torsoLeftFar    ( -0.8713 0.2311 0.7129 );
    torsoRight      ( 1.5433 0.6173 0.3311 );
    nearLeft        ( -0.0213 0.4521 0.5317 );
    nearRight       ( 1.0187 0.3719 0.4613 );
}

_leadFieldVerifier
{
    type            manufacturedLeadFieldECGVerifier;
    reference       slab;
    #includeIfPresent "<case>/local/reference"
}

monodomainSolverCoeffs
{
    sealedHeartBoundary false;
    cellZone        myocardium;
    conductivitySource uniform;
    conductivity    [ -1 -3 3 0 0 2 0 ] ( 0.111453302 0 0 0.121585420 0 0.030396355 );
    #includeIfPresent "<case>/local/monodomainConductivity"
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      monodomainFDAManufactured;
    timeCouplingScheme godunov;
    outputVariables
    {
        ionic
        {
            export          ( u1 u2 u3 );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedFDAMonodomainVerifier;
    }
    dimension       "1D";
    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    externalStimulus
    {
        stimulusLocationMin ( 0 0 0.0055 );
        stimulusLocationMax ( 0.0015 0.0015 0.007 );
        stimulusDuration [ 0 0 1 0 0 0 0 ] 0;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 0;
        stimulusStartTime 0;
    }
}

bidomainSolverCoeffs
{
    sealedHeartBoundary false;
    bathHeartPhiETrace zeroGradient;
    cellZone        myocardium;
    conductivitySource uniform;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] ( 0.111453302 0 0 0.121585420 0 0.030396355 );
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] ( 0.046165469 0 0 0.050362330 0 0.012590582 );
    #includeIfPresent "<case>/local/bidomainConductivity"
    chi             [ 0 -1 0 0 0 0 0 ] 3;
    cm              [ -1 -4 4 0 0 2 0 ] 2;
    ionicModel      bidomainFDAManufactured;
    timeCouplingScheme godunov;
    outputVariables
    {
        ionic
        {
            export          ( u1 u2 u3 );
            debug           ( V u1 u2 u3 Iion );
        }
    }
    verificationModel
    {
        type            manufacturedFDABidomainVerifier;
    }
    dimension       "1D";
    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    // Heart potential pin (inside one cell at every level)
    phiERefPoint    ( 0.1137 0.0437 0.0437 );
    phiEReferenceValue 0;
    externalStimulus
    {
        stimulusLocationMin ( 0 0 0.0055 );
        stimulusLocationMax ( 0.0015 0.0015 0.007 );
        stimulusDuration [ 0 0 1 0 0 0 0 ] 0;
        stimulusIntensity [ 0 -3 0 0 0 1 0 ] 0;
        stimulusStartTime 0;
    }
}

// The torso conductor of the lead field: insulated outer boundary, pinned in
// the left torso slab (inside one cell at every level). -problem layered
// sets the layer cellZones and the surface currents in local/torso.
torso
{
    cellZones       ( bath );
    conductivityField bodyAndOrgansConductivity;
    interfaceConductivityInterpolation distanceWeightedHarmonic;
    phiERefPoint    ( -0.9013 0.0437 0.0437 );
    phiEReferenceValue 0;
    #includeIfPresent "<case>/local/torso"
}

torsoCoupling leadField;

// The ECG domain holds the Gi and Ge of the monodomain heart; for the
// bidomain heart, whose Gi and Ge are those of its Coeffs, Allrun
// -myocardium bidomain removes them (local/ecgConductivity)
ecgDomains
{
    ECG
    {
        ecgSolver       torsoECG;
        conductivitySource uniform;
        conductivityIntracellular [ -1 -3 3 0 0 2 0 ] ( 0.380525375260 0 0 0.415118589951 0 0.103779647488 );
        conductivityExtracellular [ -1 -3 3 0 0 2 0 ] ( 0.157618771260 0 0 0.171947749951 0 0.0429869374877 );
        #includeIfPresent "<case>/local/ecgConductivity"
        electrodePositions { $:_leadFieldElectrodes; }
        verificationModel { $:_leadFieldVerifier; }
    }
}


