FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}

internalFacesOnly true;
baffles
{
    leadGuardFace
    {
        type faceZone;
        zoneName leadGuardFace;
        patches
        {
            master { name leadGuardMaster; type wall; }
            slave { name leadGuardSlave; type wall; }
        }
    }
}
