FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         leastSquares;
    limitedGrad     cellMDLimited leastSquares 1;
}

divSchemes
{
    default         none;
    div(phiU,activationTime)    Gauss linearUpwind limitedGrad;
    div((conductivityIntracellular&grad(Vm)))   Gauss linear;
    div((conductivityIntracellular&grad(phiE))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

