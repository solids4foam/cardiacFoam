FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
    }

    "phiE|phiEFinal|phiI|phiIFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
    }

    "activationTime|activationTimeFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          1e-5;
    }

    asymmetric_activationTime
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.01;
        maxIter         500;
    }
}

PIMPLE
{
    nOuterCorrectors    200;
    residualControl
    {
        "Vm|activationTime"
        {
            relTol          0;
            tolerance       1e-8;
        }
    }
}

relaxationFactors
{
    equations
    {
        activationTime  0.9;
    }
}

