FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  monodomainSolver;

monodomainSolverCoeffs
{
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    explicit;
    solver               RKF45;
    maxSteps             1000000000;

    externalStimulus
    {
        stimulusLocationMin (0 0 0);
        stimulusLocationMax (1e-3 10e-3 0.1e-3);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0;
    }

    verificationModel
    {
        type none;
    }
}

