FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  bidomainSolver;

bidomainSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] (0.08 0 0 0.08 0 0.04);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    implicit;
    solver               RKF45;
    maxSteps             1000000000;

    phiERefPoint       (0.0095 0.0095 5e-05);
    phiEReferenceValue 0;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    // No tissue stimulus: the network root is the only activation, so the
    // myocardium is excited through the junctions alone.
    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;
                ionicModel BuenoOrovio;
                tissue     epicardialCells;
                solver     RKF45;
                maxSteps   1000000000;

                rootStimulus
                {
                    node      0;
                    startTime 0;
                    duration  0.002;
                    intensity 500000.0;
                }
                chi      140000;
                cm       0.01;
                vm1DRest -0.084;
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            conductionNetworkDomain purkinjeNetwork;
            electroDomainCoupler reactionDiffusionPvjCoupler;
            rPvj                 1000;
            pvjRadius            1e-3;
            couplingMode         unidirectional;
        }
    }
}

