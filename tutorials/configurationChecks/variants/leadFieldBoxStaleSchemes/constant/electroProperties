FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The leadFieldBox conductor whose fvSchemes change after the lead fields
// are built (Allprepare): the ECG must refuse the stale lead fields.

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.030985695586772725 0.010985695586772731 -0.0091245929743944305 0.018138897387621696 -0.0018611026123782988 0.010875407025605568);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    explicit;
    solver               RKF45;
    maxSteps             1000000000;

    externalStimulus
    {
        stimulusLocationMin (0 0 0);
        stimulusLocationMax (0.3 2 2);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0;
    }

    cellZone myocardium;

    ecgDomains
    {
        ECG
        {
            ecgSolver leadFieldECG;
            conductivitySource uniform;
            conductivityIntracellular [ -1 -3 3 0 0 2 0 ] (0.092957086760318178 0.032957086760318194 -0.027373778923183292 0.054416692162865092 -0.0055833078371348962 0.032626221076816703);
            conductivityExtracellular [ -1 -3 3 0 0 2 0 ] (0.046478543380159089 0.016478543380159097 -0.013686889461591646 0.027208346081432546 -0.0027916539185674481 0.016313110538408351);
            torso
            {
                bathCellZones   ( bath );
                bathConductivityField bodyAndOrgansConductivity;
                interfaceConductivityInterpolation distanceWeightedHarmonic;
                phiERefPoint    ( -0.95 0.25 0.25 );
                phiEReferenceValue 0.001;
            }
            electrodePositions
            {
                far   (-0.8 0.3 0.28);
                near  (-0.3 0.45 0.35);
            }
        }
    }
}

