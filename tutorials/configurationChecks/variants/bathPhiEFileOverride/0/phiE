FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      phiE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    xMin
    {
        type            fixedValue;
        value           uniform 0;
    }
    xMax
    {
        type            fixedGradient;
        gradient        uniform 0;
    }
    sides
    {
        type            empty;
    }
}

