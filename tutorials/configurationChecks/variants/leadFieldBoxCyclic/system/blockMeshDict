FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// The leadFieldBox mesh, periodic in y.

vertices
(
    (-1 0    0   ) (1 0.5  0.3 ) (1 1.0  0.3 ) (-1 0.5  0   )
    (-1 0    0.5 ) (1 0.5  0.8 ) (1 1.0  0.8 ) (-1 0.5  0.5 )
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (16 5 5) simpleGrading (1 1 1)
);

boundary
(
    xMin
    {
        type patch;
        faces ((0 4 7 3));
    }
    xMax
    {
        type patch;
        faces ((1 2 6 5));
    }
    yLow
    {
        type cyclic;
        neighbourPatch yHigh;
        transform translational;
        separationVector (0 0.5 0);
        faces ((0 1 5 4));
    }
    yHigh
    {
        type cyclic;
        neighbourPatch yLow;
        transform translational;
        separationVector (0 -0.5 0);
        faces ((3 7 6 2));
    }
    sides
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

