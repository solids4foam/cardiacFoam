FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Monodomain on the myocardium cellZone of the bath column. The ECG domain
// gives Gi and Ge with Gi (Gi+Ge)^-1 Ge equal to the monodomain
// conductivity, and the torso conductor in its torso sub-dictionary.

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    explicit;
    solver               RKF45;
    maxSteps             1000000000;

    externalStimulus
    {
        stimulusLocationMin (0 0 0);
        stimulusLocationMax (0.1 0.1 0.1);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0;
    }

    cellZone myocardium;

    ecgDomains
    {
        ECG
        {
            ecgSolver leadFieldECG;
            conductivitySource uniform;
            conductivityIntracellular [ -1 -3 3 0 0 2 0 ] (0.12 0 0 0.12 0 0.06);
            conductivityExtracellular [ -1 -3 3 0 0 2 0 ] (0.06 0 0 0.06 0 0.03);
            torso
            {
                bathCellZones   ( bath );
                bathConductivityField bodyAndOrgansConductivity;
                interfaceConductivityInterpolation distanceWeightedHarmonic;
                groundPatches
                {
                    xMin        0.001;
                }
            }
            electrodePositions
            {
                left  (-0.5 0.05 0.05);
                right (1.5 0.05 0.05);
            }
        }
    }
}

