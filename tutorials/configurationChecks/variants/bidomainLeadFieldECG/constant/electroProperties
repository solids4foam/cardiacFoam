FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Bidomain on the myocardium cellZone of the bath column, insulated, with
// the torso ECG from lead fields: Gi and Ge are those of the Coeffs, the
// torso conductor is the top-level torso block.

myocardiumSolver bidomainSolver;

bidomainSolverCoeffs
{
    sealedHeartBoundary false;
    bathHeartPhiETrace zeroGradient;
    conductivitySource uniform;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] (0.12 0 0 0.12 0 0.06);
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] (0.06 0 0 0.06 0 0.03);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    implicit;
    solver               RKF45;
    maxSteps             1000000000;

    // Pin of the heart phiE
    phiERefPoint       (0.5125 0.05 0.05);
    phiEReferenceValue 0;

    externalStimulus
    {
        stimulusLocationMin (0 0 0);
        stimulusLocationMax (0.1 0.1 0.1);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0;
    }

    cellZone myocardium;
}

torso
{
    cellZones       ( bath );
    conductivityField bodyAndOrgansConductivity;
    interfaceConductivityInterpolation distanceWeightedHarmonic;
    groundPatches
    {
        xMin        0.001;
    }
}

torsoCoupling leadField;

ecgDomains
{
    ECG
    {
        ecgSolver torsoECG;
        electrodePositions
        {
            left  (-0.5 0.05 0.05);
            right (1.5 0.05 0.05);
        }
    }
}

