FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  bidomainSolver;

bidomainSolverCoeffs
{
    cellZone myocardium;
    ecgDomains { ECG { ecgSolver leadFieldECG; } }

    sealedHeartBoundary false;

    conductivitySource uniform;
    conductivityIntracellular [-1 -3 3 0 0 2 0] (2 0 0 2 0 2);
    conductivityExtracellular [-1 -3 3 0 0 2 0] (2 0 0 2 0 2);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;

    solutionAlgorithm    implicit;
    solver               RKF45;
    maxSteps             1000000000;

    phiERefPoint       (0.0095 0.0095 5e-05);
    phiEReferenceValue 0;

    externalStimulus
    {
        stimulusLocationMin (0 0 0);
        stimulusLocationMax (0.05 0.1 0.1);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0;
    }
}

