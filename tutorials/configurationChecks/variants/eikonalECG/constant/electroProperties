FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  eikonalSolver;

eikonalSolverCoeffs
{
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;
    c0    [ 0 0 -0.5 0 0 0 0 ] 60;
    eikonalAdvectionDiffusionApproach true;

    stimulusLocationMin (0 0 0);
    stimulusLocationMax (1e-3 10e-3 0.1e-3);

    // eikonalECG builds its transmural waveform templates from this block
    ionicHeterogeneity
    {
        mode              namedRegions;
        field             t;
        transitionMode    hard;
        regions
        {
            endocardialCells { range (0 0.3); }
            mCells           { range (0.3 0.7); }
            epicardialCells  { range (0.7 1); }
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver eikonalECG;
            sigmaExtracellular 0.2;
            sampling
            {
                start  0;
                end    0.01;
                deltaT 1e-3;
            }
            electrodePositions
            {
                E1 (-0.01 0.005 0.00005);
                E2 (0.02 0.005 0.00005);
            }
        }
    }
}

