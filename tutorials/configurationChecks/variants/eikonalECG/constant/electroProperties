FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  eikonalSolver;

eikonalSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    conductivity [ -1 -3 3 0 0 2 0 ] (0.04 0 0 0.04 0 0.02);
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;
    c0    [ 0 0 -0.5 0 0 0 0 ] 60;
    eikonalAdvectionDiffusionApproach true;

    stimulusLocationMin (0 0 0);
    stimulusLocationMax (1e-3 10e-3 0.1e-3);

    // Transmural coordinate t runs 0 -> 1 across x, so the ECG sees the
    // template difference between endocardium and epicardium (the
    // sum_k U_k grad(w_k) term); post/eikonalECGGradientCheck checks it.
    ionicHeterogeneity
    {
        mode              namedRegions;
        field             t;
        transitionMode    blend;
        transitionWidth   0.2;
        smoothing         smoothstep;
        regions
        {
            endocardialCells { range (0 0.5); }
            epicardialCells  { range (0.5 1); }
        }
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver eikonalECG;
            checkGradVm true;
            sigmaExtracellular 0.2;
            sampling
            {
                start  0;
                end    0.4;
                deltaT 1e-3;
            }
            electrodePositions
            {
                E1 (-0.01 0.005 0.00005);
                E2 (0.02 0.005 0.00005);
            }
        }
    }
}

