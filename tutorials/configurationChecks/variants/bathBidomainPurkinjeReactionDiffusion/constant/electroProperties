FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver bidomainSolver;

// The bath composition of the heart--torso cases with a Purkinje network.
// The 1-D column of the bath base, scaled to centimetres (system/), so that
// the network excites the myocardium through its junction.
bidomainSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    cellZone        myocardium;
    bathPredictorCorrector yes;
    conductivityIntracellular [ -1 -3 3 0 0 2 0 ] ( 0.111453302 0 0 0.121585420 0 0.030396355 );
    conductivityExtracellular [ -1 -3 3 0 0 2 0 ] ( 0.046165469 0 0 0.050362330 0 0.012590582 );
    chi   [ 0 -1 0 0 0 0 0 ] 140000;
    cm    [ -1 -4 4 0 0 2 0 ] 0.01;

    ionicModel    BuenoOrovio;
    tissue        epicardialCells;
    timeCouplingScheme godunov;

    solutionAlgorithm implicit;
    solver          RKF45;
    maxSteps        1000000000;
    bathPotentialDomain
    {
        bathCellZones   ( bath );
        bathConductivityField bodyAndOrgansConductivity;
        interfaceConductivityInterpolation distanceWeightedHarmonic;
        groundPatches
        {
        }
        surfaceCurrentPatches
        {
            xMax            0;
            xMin            0;
        }
        phiERefPoint    ( -0.009 0.0005 0.0005 );
        phiEReferenceValue 0;
    }

    ecgDomains
    {
        ECG
        {
            ecgSolver torsoECG;
            electrodePositions
            {
                left  (-0.005 0.0005 0.0005);
                right (0.015 0.0005 0.0005);
            }
        }
    }

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;

    // No tissue stimulus: the network root is the only activation, so the
    // myocardium is excited through the junctions alone.
    conductionNetworkDomains
    {
        purkinjeNetwork
        {
            conductionSystemDomain purkinjeGraphModel;

            purkinjeGraphModelCoeffs
            {
                conductionSystemSolver monodomain1DSolver;
                graphFile              purkinjeGraph;
                ionicModel BuenoOrovio;
                tissue     epicardialCells;
                solver     RKF45;
                maxSteps   1000000000;

                rootStimulus
                {
                    node      0;
                    startTime 0;
                    duration  0.002;
                    intensity 500000.0;
                }
                chi      140000;
                cm       0.01;
                vm1DRest -0.084;
            }
        }
    }

    domainCouplings
    {
        purkinjeToMyocardium
        {
            conductionNetworkDomain purkinjeNetwork;
            electroDomainCoupler reactionDiffusionPvjCoupler;
            rPvj                 1000;
            pvjRadius            1e-3;
            couplingMode         unidirectional;
        }
    }
}

