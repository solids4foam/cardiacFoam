# Configuration checks, run by regression/regressionTest.sh
#
# name  base  variant  expect  [edit ...]
#
#   base     case under base/ providing mesh, system/ and Allprepare
#   variant  files under variants/ copied over the base (at least
#            constant/electroProperties)
#   expect   pass: must complete and write the files in
#                  regression/manifests/<name>
#            fail:<text>: must stop with a FOAM FATAL error mentioning <text>
#                  (write spaces in <text> as ~)
#   edit     applied to constant/electroProperties with foamDictionary:
#            path=value sets an entry, path! removes it (write spaces in
#            values as ~; a value can be a whole {...} sub-dictionary);
#            np=N runs on N processors (simple decomposition) and
#            reconstructs; post=<script> then runs post/<script> in the
#            run directory (a post-processing utility);
#            skip=<version>[,...] skips the check on those OpenFOAM versions

# ---- Myocardium models and options --------------------------------------
monodomainExplicit                     slab  monodomainExplicit                     pass
monodomainImplicit                     slab  monodomainImplicit                     pass
monodomainSbdf2                        slab  monodomainSbdf2                        pass
monodomainFieldConductivity            slab  monodomainFieldConductivity            pass
# A field conductivity that jumps across periodic faces, read on a cyclic mesh
monodomainPeriodicFieldConductivity    slab  monodomainPeriodicFieldConductivity    pass
monodomainCellZone                     slab  monodomainCellZone                     pass
monodomainVerificationNone             slab  monodomainVerificationNone             pass
# A keyword starting with '_' is a case variable and is accepted
monodomainCaseVariable                 slab  monodomainExplicit                     pass  monodomainSolverCoeffs/_caseVariable=1
bidomain                               slab  bidomain                               pass
eikonal                                slab  eikonal                                pass

# ---- Conduction system (Purkinje) and junction couplers -----------------
monodomainPurkinjeReactionDiffusion    slab  monodomainPurkinjeReactionDiffusion    pass
monodomainPurkinjeReactionDiffusionBidirectional slab monodomainPurkinjeReactionDiffusionBidirectional pass
monodomainPurkinjeRestitutionEikonal   slab  monodomainPurkinjeRestitutionEikonal   pass
eikonalPurkinje                        slab  eikonalPurkinje                        pass
eikonalSeedBoxList                     slab  eikonal                                pass  eikonalSolverCoeffs/stimulusLocationMin!  eikonalSolverCoeffs/stimulusLocationMax!  eikonalSolverCoeffs/stimulusLocationMinList=((0~0~0)~(9e-3~0~0))  eikonalSolverCoeffs/stimulusLocationMaxList=((1e-3~10e-3~0.1e-3)~(10e-3~10e-3~0.1e-3))
eikonalSeedBoxListSingle               slab  eikonal                                pass  eikonalSolverCoeffs/stimulusLocationMin!  eikonalSolverCoeffs/stimulusLocationMax!  eikonalSolverCoeffs/stimulusLocationMinList=((0~0~0))  eikonalSolverCoeffs/stimulusLocationMaxList=((1e-3~10e-3~0.1e-3))
eikonalPurkinjeCutBranch               slab  eikonalPurkinjeCutBranch               pass
eikonalPurkinjeCutBranchIgnored        slab  eikonalPurkinjeCutBranch               pass  eikonalSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/useEdgeConductance=false
eikonalPurkinjePvjDelay                slab  eikonalPurkinje                        pass  eikonalSolverCoeffs/domainCouplings/purkinjeToMyocardium/pvjDelay=0.005
# The seed box is optional: the junctions alone seed the myocardium;
# with neither a box nor a network the solve must stop
eikonalPurkinjeNoSeedBox               slab  eikonalPurkinje                        pass  eikonalSolverCoeffs/stimulusLocationMin!  eikonalSolverCoeffs/stimulusLocationMax!
eikonalNoSeed                          slab  eikonal                                fail:no~activation~seed  eikonalSolverCoeffs/stimulusLocationMin!  eikonalSolverCoeffs/stimulusLocationMax!
# An ionic state of the graph model exported next to the coupling outputs;
# in parallel each processor holds only its share of the graph nodes (#48)
monodomainPurkinjeIonicExport          slab  monodomainPurkinjeReactionDiffusion    pass  monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/outputVariables={export~(IcouplingSource~Vm~v);}

# ---- ECG ------------------------------------------------------------------
monodomainPseudoECG                    slab  monodomainPseudoECG                    pass
bidomainPseudoECG                      slab  bidomainPseudoECG                      pass
eikonalECG                             slab  eikonalECG                             pass
eikonalECGGradientCheck                slab  eikonalECG                             pass  post=eikonalECGGradientCheck
eikonalECGRegionStates                 slab  eikonalECGRegionStates                 pass

# ---- Bath (extracellular potential domain) and torso ECG ------------------
bathBidomain                           bath  bathBidomain                           pass
bathTorsoECG                           bath  bathTorsoECG                           pass

# ---- Single cell ------------------------------------------------------------
singleCellBuenoOrovio                  singleCell singleCellBuenoOrovio             pass
singleCellTWorldActiveTension          singleCell singleCellTWorldActiveTension     pass

# ---- Parallel runs (2 processors, simple decomposition) --------------------
# Compared with the serial run of the same variant in ./comparisons
monodomainExplicitParallel             slab  monodomainExplicit                     pass  np=2
monodomainImplicitParallel             slab  monodomainImplicit                     pass  np=2
bidomainParallel                       slab  bidomain                               pass  np=2
eikonalParallel                        slab  eikonal                                pass  np=2
monodomainPurkinjeReactionDiffusionParallel slab monodomainPurkinjeReactionDiffusion pass np=2
monodomainPurkinjeRestitutionEikonalParallel slab monodomainPurkinjeRestitutionEikonal pass np=2
monodomainPurkinjeIonicExportParallel  slab  monodomainPurkinjeReactionDiffusion    pass  np=2  monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/outputVariables={export~(IcouplingSource~Vm~v);}
eikonalPurkinjeParallel                slab  eikonalPurkinje                        pass  np=2
eikonalPurkinjeSeedFlat                slab  eikonalPurkinje                        pass  eikonalSolverCoeffs/domainCouplings/purkinjeToMyocardium/seedProfile=flat
monodomainPseudoECGParallel            slab  monodomainPseudoECG                    pass  np=2
eikonalECGParallel                     slab  eikonalECG                             pass  np=2
bathTorsoECGParallel                   bath  bathTorsoECG                           pass  np=2
# The decomposition splits the periodic faces into processorCyclic faces
monodomainPeriodicFieldConductivityParallel slab monodomainPeriodicFieldConductivity pass np=2

# ---- Post-processing utilities that link the electro libraries -----------
monodomainPseudoECGRecomputed          slab  monodomainPseudoECG                    pass  post=recomputePseudoECG
bathBidomainInterfaceMetrics           bath  bathBidomain                           pass  post=bathBidomainInterfaceMetrics

# ---- Restart from the latest time (startFrom latestTime) -------------------
# The run is continued to twice its end time from the fields it wrote; a
# cellZone myocardium reads them back from base-mesh-sized files
monodomainExplicitRestart              slab  monodomainExplicit                     pass  post=restartLatestTime
monodomainCellZoneRestart              slab  monodomainCellZone                     pass  post=restartLatestTime
bathBidomainRestart                    bath  bathBidomain                           pass  post=restartLatestTime
bathBidomainRestartParallel            bath  bathBidomain                           pass  np=2  post=restartLatestTime
# A decomposed Purkinje run, whose network state the master writes into the
# case-root time directories, then reconstructed from the restart time on
purkinjeRestartParallel                slab  monodomainPurkinjeReactionDiffusion    pass  np=2  post=restartLatestTime

# ---- Invalid configurations: must stop with a clear fatal error ------------
unknownMyocardiumSolver                slab  monodomainExplicit          fail:bogusSolver              myocardiumSolver=bogusSolver
missingMyocardiumCoeffs                slab  monodomainExplicit          fail:bidomainSolverCoeffs     myocardiumSolver=bidomainSolver
unknownIonicModel                      slab  monodomainExplicit          fail:bogusIonicModel          monodomainSolverCoeffs/ionicModel=bogusIonicModel
unknownConductivitySource              slab  monodomainExplicit          fail:bogusSource              monodomainSolverCoeffs/conductivitySource=bogusSource
unknownTimeCouplingScheme              slab  monodomainImplicit          fail:bogusScheme              monodomainSolverCoeffs/timeCouplingScheme=bogusScheme
unknownVerificationModel               slab  monodomainVerificationNone  fail:bogusVerifier           monodomainSolverCoeffs/verificationModel/type=bogusVerifier
unknownAdvanceScheme                   slab  monodomainPurkinjeReactionDiffusion fail:bogusAdvanceScheme monodomainSolverCoeffs/electrophysicsAdvanceScheme=bogusAdvanceScheme
unknownConductionSystemDomain          slab  monodomainPurkinjeReactionDiffusion fail:bogusDomain  monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/conductionSystemDomain=bogusDomain
unknownConductionSystemSolver          slab  monodomainPurkinjeReactionDiffusion fail:bogusSolver1D monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/conductionSystemSolver=bogusSolver1D
missingGraphFile                       slab  monodomainPurkinjeReactionDiffusion fail:missingGraph monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/graphFile=missingGraph
unknownElectroDomainCoupler            slab  monodomainPurkinjeReactionDiffusion fail:bogusCoupler monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/electroDomainCoupler=bogusCoupler
couplingToUnknownNetwork               slab  monodomainPurkinjeReactionDiffusion fail:bogusNetwork monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/conductionNetworkDomain=bogusNetwork
missingCouplingMode                    slab  monodomainPurkinjeReactionDiffusion fail:couplingMode monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/couplingMode!
twoConductionNetworkDomains            slab  monodomainPurkinjeReactionDiffusion fail:only~one~conduction~network~domain monodomainSolverCoeffs/conductionNetworkDomains/secondNetwork={conductionSystemDomain~purkinjeGraphModel;}
pvjDelayWithReactionDiffusion          slab  monodomainPurkinjeReactionDiffusion fail:pvjDelay~is~not~used monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/pvjDelay=0.005
seedProfileWithReactionDiffusion       slab  monodomainPurkinjeReactionDiffusion fail:seedProfile~is~used~only monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/seedProfile=front
unknownSeedProfile                     slab  eikonalPurkinje                        fail:Unknown~seedProfile eikonalSolverCoeffs/domainCouplings/purkinjeToMyocardium/seedProfile=bogus
eikonalSeedBoxListSizeMismatch         slab  eikonal                                fail:same~size  eikonalSolverCoeffs/stimulusLocationMinList=((0~0~0)~(9e-3~0~0))  eikonalSolverCoeffs/stimulusLocationMaxList=((1e-3~10e-3~0.1e-3))
ecgDomainCoupling                      slab  monodomainPseudoECG         fail:ECG~domains~take~no~coupling monodomainSolverCoeffs/ecgDomains/ECG/coupling={electroDomainCoupler~reactionDiffusionPvjCoupler;}
twoPseudoECGDomains                    slab  monodomainPseudoECG         fail:both~select~ecgSolver~pseudoECG monodomainSolverCoeffs/ecgDomains/ECG2={ecgSolver~pseudoECG;electrodePositions~{E3~(0.005~0.005~0.00005);}}
unknownEcgSolver                       slab  monodomainPseudoECG         fail:bogusECG                 monodomainSolverCoeffs/ecgDomains/ECG/ecgSolver=bogusECG
eikonalECGWithMonodomain               slab  monodomainPseudoECG         fail:eikonalECG               monodomainSolverCoeffs/ecgDomains/ECG/ecgSolver=eikonalECG
eikonalECGWithoutHeterogeneity         slab  eikonalECG                  fail:ionicHeterogeneity       eikonalSolverCoeffs/ionicHeterogeneity!
torsoECGWithMonodomain                 slab  monodomainPseudoECG         fail:torsoECG                 monodomainSolverCoeffs/ecgDomains/ECG/ecgSolver=torsoECG
torsoECGWithoutBath                    slab  bidomainPseudoECG           fail:torsoECG                 bidomainSolverCoeffs/ecgDomains/ECG/ecgSolver=torsoECG
bathWithoutCellZone                    bath  bathBidomain                fail:subset~cell~map          bidomainSolverCoeffs/cellZone!
unknownBathInterfaceInterpolation      bath  bathBidomain                fail:bogusInterpolation       bidomainSolverCoeffs/bathPotentialDomain/interfaceConductivityInterpolation=bogusInterpolation
bathPhiEFileOverride                   bath  bathPhiEFileOverride         fail:global~phiE~patch~types~differ
unknownActiveTensionModel              singleCell singleCellTWorldActiveTension fail:bogusTension     singleCellSolverCoeffs/activeTensionModel=bogusTension

# ---- Misspelt or unknown entries: must stop and name the valid ones ---------
unknownTopLevelKeyword                 slab  monodomainExplicit          fail:zzzUnknownKey            zzzUnknownKey=1
unknownCoeffsKeyword                   slab  monodomainExplicit          fail:zzzUnknownKey            monodomainSolverCoeffs/zzzUnknownKey=1
misspeltActiveTensionModel             singleCell singleCellTWorldActiveTension fail:did~you~mean~'activeTensionModel' singleCellSolverCoeffs/activeTensionModel! singleCellSolverCoeffs/activeTensionModl=LandNiedererTWorld
misspeltStimulusKeyword                slab  monodomainExplicit          fail:did~you~mean~'stimulusIntensity' monodomainSolverCoeffs/externalStimulus/stimulusIntensty=1
misspeltCouplingKeyword                slab  monodomainPurkinjeReactionDiffusion fail:did~you~mean~'pvjRadius' monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/pvjRadiu=1e-3
misspeltPurkinjeKeyword                slab  monodomainPurkinjeReactionDiffusion fail:did~you~mean~'purkinjeConductivity' monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/purkinjeConductivty=0.4
unknownEcgDomainKeyword                slab  monodomainPseudoECG         fail:zzzUnknownKey            monodomainSolverCoeffs/ecgDomains/ECG/zzzUnknownKey=1
misspeltSolutionAlgorithm              slab  monodomainExplicit          fail:did~you~mean~'explicit'  monodomainSolverCoeffs/solutionAlgorithm=expicit
misspeltPvjKernel                      slab  monodomainPurkinjeReactionDiffusionBidirectional fail:did~you~mean~'gaussian' monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/pvjKernel=gausian
unknownEikonalPvjCouplingScheme        slab  monodomainPurkinjeRestitutionEikonal fail:bogusScheme monodomainSolverCoeffs/domainCouplings/purkinjeToMyocardium/pvjCouplingScheme=bogusScheme
unknownIonicExport                     slab  monodomainExplicit          fail:Unknown~ionic~model~output monodomainSolverCoeffs/outputVariables={ionic~{export~(bogusVariable);}}
unknownPurkinjeExport                  slab  monodomainPurkinjeReactionDiffusion fail:did~you~mean~'IcouplingSource' monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/outputVariables={export~(Vm~Icoupling);}
unknownPurkinjeDebug                   slab  monodomainPurkinjeReactionDiffusion fail:did~you~mean~'Iion' monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/outputVariables={export~(Vm);debug~(Vm~Iin);}
unknownActiveTensionExport             singleCell singleCellTWorldActiveTension fail:Unknown~active~tension~output singleCellSolverCoeffs/outputVariables/activeTension={export~(bogusTa);}
# Settings that are wrong whatever their spelling
conductionNetworkUncoupled             slab  monodomainPurkinjeReactionDiffusion fail:links~it~to~the~myocardium monodomainSolverCoeffs/domainCouplings!
conductionNetworkWithoutGraph          slab  monodomainPurkinjeReactionDiffusion fail:graphFile monodomainSolverCoeffs/conductionNetworkDomains/purkinjeNetwork/purkinjeGraphModelCoeffs/graphFile!
ecgWithoutElectrodes                   slab  monodomainPseudoECG         fail:has~no~electrodes        monodomainSolverCoeffs/ecgDomains/ECG/electrodePositions!
