// ─────────────────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────────────────
// C. bidomainSolver
//    Adds a phiE solver; tighter tolerances; fewer PIMPLE iterations because
//    the bidomain system converges quickly with the operator-splitting scheme.
//    Replace the entire solvers/PIMPLE/relaxationFactors block with:
//
// solvers
// {
//     "Vm|VmFinal|u|uFinal"
//     {
//         solver          PCG;
//         preconditioner  DIC;
//         tolerance       1e-15;
//         relTol          0.0;
//     }
//
//     "phiE|phiEFinal|phiI|phiIFinal"
//     {
//         solver          PCG;
//         preconditioner  DIC;
//         tolerance       1e-15;
//         relTol          0.0;
//     }
// }
//
// PIMPLE
// {
//     nOuterCorrectors    2;
// }
