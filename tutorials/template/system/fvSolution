FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// cardiacFoam fvSolution — three canonical configurations:
//
//   A. monodomainSolver / singleCellSolver  [ACTIVE]
//   B. eikonalSolver                        [see below]
//   C. bidomainSolver                       [see below]
//
// Copy this file to your case's system/ directory and uncomment the block
// that matches your myocardiumSolver choice.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ─────────────────────────────────────────────────────────────────────────────
// A. monodomainSolver / singleCellSolver
//    Active below — use as-is for these solver types.
// ─────────────────────────────────────────────────────────────────────────────

solvers
{
    "Vm|VmFinal|u|uFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.0;
    }

    "psi|psiFinal"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-11;
        relTol          0.1;
    }
}

PIMPLE
{
    nOuterCorrectors    1000;

    residualControl
    {
        "Vm|psi"
        {
            relTol          0.0;
            tolerance       1e-6;
        }
    }
}

relaxationFactors
{
    equations
    {
        psi     0.9;
    }
}


// ─────────────────────────────────────────────────────────────────────────────
// B. eikonalSolver
//    No Vm evolution — psi (activation time) is solved as a steady elliptic
//    problem. The asymmetric_psi block handles the advection-diffusion form
//    when eikonalAdvectionDiffusionApproach = true.
//    Replace the entire solvers/PIMPLE/relaxationFactors block with:
//
// solvers
// {
//     "psi|psiFinal"
//     {
//         solver          PCG;
//         preconditioner  diagonal;
//         tolerance       1e-11;
//         relTol          0.1;
//     }
//
//     asymmetric_psi
//     {
//         solver          PBiCGStab;
//         preconditioner  DILU;
//         tolerance       1e-11;
//         relTol          0.0;
//     }
// }
