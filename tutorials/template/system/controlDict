FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     cardiacFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// [s] Simulation end time.
// Monodomain / bidomain: cover at least one full action potential cycle.
//   Human ventricle:  ~0.3 s    (300 ms AP duration)
//   Niederer benchmark: 0.055 s (activation time study only)
// EikonalSolver: set to the latest expected activation time + small margin.
endTime         0.3;

// [s] Time step.
// explicit solutionAlgorithm  →  stability-limited; typical values:
//   dx = 0.5 mm  → deltaT ≈ 5e-6 s
//   dx = 0.2 mm  → deltaT ≈ 5e-6 s
//   dx = 0.1 mm  → deltaT ≈ 1e-6 s
// implicit solutionAlgorithm  →  free of diffusion stability limit; use
//   deltaT = 1e-4 to 5e-4 s with residualControl in fvSolution.
// eikonalSolver  →  deltaT is irrelevant (steady-state activation solve).
deltaT          5e-6;

writeControl    runTime;

// [s] Output frequency (in simulation time when writeControl = runTime).
// Typical cardiac: every 5 ms captures AP upstroke and repolarisation.
writeInterval   5e-3;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
