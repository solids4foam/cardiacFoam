FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Number of MPI subdomains. Match the -np argument passed to mpirun.
// For a quick serial test set to 1 (cardiacFoam runs without mpirun).
numberOfSubdomains  4;

// scotch requires no geometry and works well for cardiac meshes.
method          scotch;

