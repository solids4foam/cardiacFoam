FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  bidomainSolver;

bidomainSolverCoeffs
{
    sealedHeartBoundary false;
    conductivitySource uniform;
    conductivityIntracellular [-1 -3 3 0 0 2 0] (0.16999999997580645 0 0 0.022433677922419355 0 0.022433677922419355);
    conductivityExtracellular [-1 -3 3 0 0 2 0] (0.6199999999117647 0 0 0.08181694301117647 0 0.08181694301117647);
    chi   [0 -1 0 0 0 0 0] 140000;
    cm    [-1 -4 4 0 0 2 0] 0.01;

    ionicModel    TNNPcompactBatched;
    batchedIntegrator rushLarsen;
    tissue    epicardialCells;

    outputVariables
    {
        ionic
        {
            export (Vm);
            debug (Vm);
        }
    }

    solutionAlgorithm    implicit;

    phiERefPoint    (0.01995 0.00295 0.00005);
    phiEReferenceValue 0;

    externalStimulus
    {
        stimulusLocationMin (0 0 5.5e-3);
        stimulusLocationMax (1.5e-3 1.5e-3 7e-3);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0.0;
    }

    #includeIfPresent "<case>/local/conductivity"
}

