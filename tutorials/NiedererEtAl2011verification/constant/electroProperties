FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver  monodomainSolver;

monodomainSolverCoeffs
{
    sealedHeartBoundary false;
    sealedWallTrace     zeroGradient;
    conductivitySource uniform;
    conductivity [-1 -3 3 0 0 2 0] (0.1334177215 0 0 0.01760617761 0 0.01760617761);
    chi   [0 -1 0 0 0 0 0] 140000;
    cm    [-1 -4 4 0 0 2 0] 0.01;

    // The batched TNNP with Rush-Larsen gating (owner, 2026-09-26): at
    // dx 0.2 mm over 1000 steps it ran 5.6x faster than TNNP with RKF45
    // (93 s against 527 s) with the same wavefront at 10 ms (max |dVm|
    // 0.059 mV, 4021 cells above 0 mV in both). Evidence: omniD
    // docs/solver-learning/cardiacfoam.md, section T.
    ionicModel    TNNPcompactBatched;
    batchedIntegrator rushLarsen;
    tissue    epicardialCells;

    outputVariables
    {
        ionic
        {
            export (Vm Jsi);
            debug (Vm Iion);
        }
    }

    solutionAlgorithm    implicit;
    // No `solver`/`maxSteps`: they configure OpenFOAM's ODESolver, which
    // ionicModel::odeSolver() builds only when a scalar model calls it
    // (src/ionicModels/ionicModel/ionicModel.H); the batched models
    // integrate in batchedIonicModel.H and never do.

    externalStimulus
    {
        stimulusLocationMin (0 0 5.5e-3);
        stimulusLocationMax (1.5e-3 1.5e-3 7e-3);
        stimulusDuration [0 0 1 0 0 0 0] 2e-3;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0.0;
    }

}

