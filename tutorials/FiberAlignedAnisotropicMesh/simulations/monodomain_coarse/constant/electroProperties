FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      electroProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

myocardiumSolver monodomainSolver;

monodomainSolverCoeffs
{

    externalStimulus
    {
        stimulusLocationMin (0.074 0.001 -0.010);
        stimulusLocationMax (0.083 0.010 0.000);
        stimulusDuration [0 0 1 0 0 0 0] 0.002;
        stimulusIntensity [0 -3 0 0 0 1 0] 50000;
        stimulusStartTime 0.0;
    }


    


    

    

    

    conductivitySource field;
    chi         [0 -1 0 0 0 0 0] 140000;
    cm          [-1 -4 4 0 0 2 0] 0.01;

    ionicModel  BuenoOrovio;
    tissue      epicardialCells;

    /* ionicHeterogeneity
    {
        field             uvc_transmural;
        mode              transmuralBands;
        endoMInterface    0.3;
        mEpiInterface     0.7;
        transitionWidth   0;
        transitionMode    hard;
        smoothing         smoothstep;
    } */

    solutionAlgorithm implicit;
    solver            RKF45;
    initialODEStep    1e-6;
    maxSteps          1000000000;

    electrophysicsAdvanceScheme staggeredElectrophysicsAdvanceScheme;


    ecgDomains
    {
        ECG
        {
            ecgSolver pseudoECG;
            sigmaExtracellular 0.2;

            electrodePositions
            {
                V1 (0.047864   0.05969    -0.10536);
                V2 (0.08917    0.08074    -0.14187);
                V3 (0.10940    0.0684336   -0.169305);
                V4 (0.131631   0.073495    -0.21842);
                V5 (0.132433   0.11248     -0.290978);
                V6 (0.137525   0.0933918   -0.26164);
            }
        }
    }
}

