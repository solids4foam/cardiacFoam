FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fiberFoamDict;
}

fiberFoam
{
    geometryModel   biventricular;
    coordinateModel cobivecoLike;
}

labels
{
    endoLv      ENDO_LV;
    endoRv      ENDO_RV;
    epi         EPI;
    base        BASE;
}

geometry
{
    axes
    {
        enabled true;
    }
}

coordinates
{
    // Shared LV/RV and septal-interface convention for every coordinate stage.
    tvSplitValue 0.5;

    apicobasal
    {
        method                  cobiveco;
        diffusivity             1.0;
        apexCellCount           16;
    }

    transventricular
    {
        diffusivity         1.0;
        writeAuxiliaryFields true;
    }

    transmural
    {
        method              cobiveco;
        diffusivity         1.0;
        writeAuxiliaryFields true;
        bandHalfWidth       0.05;
    }

    rotational
    {
        small               1e-12;
        rotationalMethod    geometric;
        writeAuxiliaryFields true;
    }
}

// Rule-based (LDRB) fiber angles. Helix angle alpha is interpolated
// transmurally by tm (epi -> endo); beta is the sheet/transverse angle.
// Convention: endocardium positive, epicardium negative (Streeter/Bayer).
// Edit these and re-run fiberFoamGenerateFibers (no recompile needed).
fibers
{
    lvAlphaEndo     60;
    lvAlphaEpi      -60;
    rvAlphaEndo     90;
    rvAlphaEpi      -25;

    lvBetaEndo      0;
    lvBetaEpi       0;
    rvBetaEndo      0;
    rvBetaEpi       0;

    tvSplitValue    0.5;
}
