# git-ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.

*.withDefaultValues
notes.txt
todo*
tutorialsTest
tutorialsTest-regression

# Build log files
log.Allwmake
log.Allcheck

# Library files which are replaced by links
src/blockCoupledSolids4FoamTools/Make/files
src/solids4FoamModels/Make/files

# ignore eigen and ltensor libraries
ThirdParty/eigen3

# preCICE tutorial repo
tutorials/fluidSolidInteraction-preCICE/tutorials

# editor and misc backup files - anywhere
*~
.*~
*.bak
*.bak[0-9][0-9]
*.orig
*.orig[0-9][0-9]
\#*\#

# file-browser settings - anywhere
.directory

# CVS recovered versions - anywhere
.#*

# objects and archives - anywhere
*.[oa]
*.la
*.so
*.jar
*.dylib

# derived files
lex.yy.c

# Corefiles
/core
!src/electroModels/core/
!src/electroModels/core/**

# dependency files - anywhere
*.dep

# lnInclude (symlink) folders - anywhere
lnInclude

# A hidden file created by the Mac OS X Finder.
.DS_Store

# build folders - anywhere
darwin*Gcc*/
darwin*Clang*/
linux*Gcc*/
linux*Icc*/
darwin*Intel*/
darwin*Arm*/
linuxming*/
SiCortex*Gcc*/
solaris*Gcc*/
SunOS*Gcc*/

# generated files in the main directory (e.g. ReleaseNotes-?.?.html)
/*.html

# patch residue
*.rej

# C++ Tooling & IDEs
compile_commands.json
.vscode/
.idea/

# python-compile & environments
*.pyc
__pycache__/
venv/
.venv/
env/
*.egg-info/

# other stuff
.build
.hgignore
.timeStamp
.trash/
scratch/
scratch_meshes/

# logs and outputs
*.log
outputs/
outputs*/

# source packages - anywhere
*.tar.bz2
*.tar.gz
*.tar
*.tgz
*.gtgz


# Generated mesh / field data (VTK)
*.vtk
*.vtu
.worktrees/

# Local tooling - not part of the repo
.agents/
.claude/
docs/superpowers/
.superpowers/

# Generated driverFOAM run reports and artifacts
**/setup*/run_report.md
**/setup*/action_events.jsonl
**/setup*/artifacts_manifest.json
**/setup*/cachedCasePostProcessing/
**/setup*/explicit_only_config.json
**/setup*/run_config.json

# OpenFOAM run artifacts under all tutorials
tutorials/**/log.*
tutorials/**/processor*/
tutorials/**/postProcessing/
tutorials/**/archivedPostProcessing/
tutorials/**/logs/
tutorials/**/constant/polyMesh/
tutorials/**/constant/*/polyMesh/
tutorials/**/0.[0-9]*/
tutorials/**/[1-9]*/

# Generated 0 directories and specific untracked cases
tutorials/manufacturedSolutions/*/0/*
tutorials/**/0/electro/

# Anatomical and derived initial fields under any tutorial 0/ directory.
# Fibre, sheet, tag, conductivity and UVC fields are mesh-sized (tens to
# hundreds of MB each) and are regenerated from the mesh, not authored here.
# Case dictionaries under constant/ and system/ remain tracked.
tutorials/**/0/*
# ...except activationTime, which is small, hand-authored case data:
# the eikonal solver now reads its boundary conditions from it
# (MUST_READ), so it must be tracked like any constant/ or system/ dict.
!tutorials/**/0/activationTime

# Large mesh / field exports under tutorials — git cannot handle these
tutorials/**/*.vtp
tutorials/**/*.vtm
tutorials/**/*.pvd
tutorials/**/*.dat
tutorials/**/*.avi
tutorials/**/*.mp4
tutorials/**/*.mov
tutorials/**/*.gif
tutorials/**/data/

# Media under tutorials
tutorials/**/media

# standalone dashboard
dashboard/
run_dashboard.sh

# PATHOS disease cases carry heart-mesh-resolution initial fields (e.g.
# 0/conductivity, hundreds of MB) — exclude the generated 0/ field dirs.
tutorials/PATHOS/**/0/

# ParaView/pyvista .foam marker files — zero-byte, auto-created on demand,
# every case can regenerate one; never meaningful to commit.
tutorials/**/*.foam

# Quarto build artefacts — only relevant if Quarto is run inside a tutorial dir
tutorials/**/.quarto/
tutorials/**/_output/

# Paper I derived results data (archived to Zenodo, never committed)
**/setup/results/
paperI_data_bundle/
# Per-run provenance manifests (regenerated by reproduce_paperI.sh; bundled, not committed)
**/provenance.json

# MMS generated study/working data (allowlist audit 2026-07-19: keep scripts,
# configs, OpenFOAM dicts, *.geo.template, per-study .gitignore, notes, and the
# committed reference/*.csv which lives at case root outside setup/).
tutorials/manufacturedSolutions/*/setup/**/*.csv
tutorials/manufacturedSolutions/*/setup/**/*.dat
tutorials/manufacturedSolutions/*/setup/**/*.vtk
tutorials/manufacturedSolutions/*/setup/**/*.sha256
tutorials/manufacturedSolutions/**/__pycache__/

# Generated tet-mesh .geo files (rendered from a tracked *.geo.template by
# substituting the actual mesh resolution at apply_case time -- e.g.
# niederer_2012.py writes setup/slab.geo from setup/mesh/tet/slab.geo.template
# on every tet-mesh_family run). Only the .template source is ever tracked;
# a bare *.geo getting committed is always leftover build output.
tutorials/**/*.geo

# MMS: coupled 1D-3D generated mesh-variant sweep scratch (regenerated per-N)
tutorials/manufacturedSolutions/**/blockMeshDict.*.active*

# Presentation: vendored third-party assets and build output.
# The slide sources under presentation/src and presentation/slides are small;
# vendor/ and build/ are regenerated and must never enter history.
presentation/vendor/
presentation/build/
presentation/node_modules/

# Mesh-generation and visualisation artefacts under tutorials. All are
# regenerable from the case setup and are far too large for git.
tutorials/**/*.msh
tutorials/**/*.pos
tutorials/**/*.blend
tutorials/**/*.blend1
tutorials/**/*.ply
tutorials/**/*.obj
tutorials/**/*.npz
tutorials/**/*.html

# Whole-heart Purkinje trees (3-10 MB each). The small verification-scale
# graphs under manufacturedSolutions/ and NiedererEtAl2011/ (<=30 kB) stay
# tracked, since the 1D-3D convergence cases depend on them.
tutorials/PATHOS/**/constant/purkinjeGraph*
tutorials/heartSim3D-1D/**/constant/purkinjeGraph*
tutorials/FiberAlignedAnisotropicMesh/**/constant/purkinjeGraph*

# Post-processing output directories carry generated figures; the existing
# rule only matched the exact name "postProcessing".
tutorials/**/postProcessing*/
tutorials/**/blenderViz/

# ---------------------------------------------------------
# New AI Decoupling Rules (2026-08)
# ---------------------------------------------------------

# OpenFOAM generated mesh quality and properties fields
tutorials/**/constant/aspectRatio
tutorials/**/constant/cell*
tutorials/**/constant/face*
tutorials/**/constant/min*
tutorials/**/constant/nonOrthoAngle
tutorials/**/constant/skewness
tutorials/**/constant/C
tutorials/**/constant/Cx
tutorials/**/constant/Cy
tutorials/**/constant/Cz

# Sweep/Runner temporary folders and PIDs
tutorials/**/*_temp/
tutorials/**/run.pid

# Simulation output plots, artifacts, and nested results
tutorials/**/*.png
tutorials/**/results/
tutorials/**/interfaceStudy/

# Versioned audience-facing figures for the TWORLD/Gaur single-cell study
!tutorials/electrophysiologyProtocols/singleCell/setup/studies/tworldVsGaur/*.png

# Benchmarks and scripts output
meluxinaScripts_GPU/benchmarkGPU_results_summary.*

# Reference outputs (keep these untracked if generated)
tutorials/**/reference/*.csv

# Presentations
presentation/
tutorials/manufacturedSolutions/eikonalECG/gradient_full_sweep.csv

# Local-only open-issue working notes (kept on disk, never tracked)
docs/issues/

# driverFOAM strict-plan / CLI outputs written next to the package.
# Generated artifacts: they drift silently against the dict catalog
# (a stale reportSetup override survived in one of these until 2026-08-14).
applications/scripts/driverFoam/*_plan.json
applications/scripts/driverFoam/out.json
applications/scripts/driverFoam/validation_run/

# driverFOAM host-local runtime backend selection (mirrors
# driverfoam-runtime.example.yaml; every host copies its own, never shared).
applications/scripts/driverFoam/driverfoam-runtime.yaml
