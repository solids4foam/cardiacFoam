# git-ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.

*.withDefaultValues
notes.txt
todo*
tutorialsTest
tutorialsTest-regression

# Build log files
log.Allwmake
log.Allcheck

# Library files which are replaced by links
src/blockCoupledSolids4FoamTools/Make/files
src/solids4FoamModels/Make/files

# ignore eigen and ltensor libraries
ThirdParty/eigen3

# preCICE tutorial repo
tutorials/fluidSolidInteraction-preCICE/tutorials

# editor and misc backup files - anywhere
*~
.*~
*.bak
*.bak[0-9][0-9]
*.orig
*.orig[0-9][0-9]
\#*\#

# file-browser settings - anywhere
.directory

# CVS recovered versions - anywhere
.#*

# objects and archives - anywhere
*.[oa]
*.la
*.so
*.jar
*.dylib

# derived files
lex.yy.c

# Corefiles
/core
!src/electroModels/core/
!src/electroModels/core/**

# dependency files - anywhere
*.dep

# lnInclude (symlink) folders - anywhere
lnInclude

# A hidden file created by the Mac OS X Finder.
.DS_Store

# build folders - anywhere
darwin*Gcc*/
darwin*Clang*/
linux*Gcc*/
linux*Icc*/
darwin*Gcc*/
darwin*Intel*/
darwin*Arm*/
darwin*Clang*/
linuxming*/
SiCortex*Gcc*/
solaris*Gcc*/
SunOS*Gcc*/

# generated files in the main directory (e.g. ReleaseNotes-?.?.html)
/*.html

# patch residue
*.orig
*.rej

# python-compile
*.pyc

# other stuff
.build
.hgignore
.timeStamp

# source packages - anywhere
*.tar.bz2
*.tar.gz
*.tar
*.tgz
*.gtgz


# Generated mesh / field data (VTK)
*.vtk
*.vtu
.worktrees/

# Local tooling - not part of the repo
.agents/
.claude/
docs/superpowers/

# Generated driverFOAM run reports and artifacts
**/setup*/run_report.md
**/setup*/action_events.jsonl
**/setup*/artifacts_manifest.json
**/setup*/cachedCasePostProcessing/
**/setup*/explicit_only_config.json
**/setup*/run_config.json

# Python bytecode caches
__pycache__/

# OpenFOAM run artifacts under all tutorials
tutorials/**/log.*
tutorials/**/processor*/
tutorials/**/postProcessing/
tutorials/**/archivedPostProcessing/
tutorials/**/logs/
tutorials/**/constant/polyMesh/
tutorials/**/constant/*/polyMesh/
tutorials/**/0.[0-9]*/
tutorials/**/[1-9]*/

# Generated 0 directories and specific untracked cases
tutorials/manufacturedSolutions/*/0/
tutorials/**/0/electro/

# Large mesh / field exports under tutorials — git cannot handle these
tutorials/**/*.vtu
tutorials/**/*.vtk
tutorials/**/*.vtp
tutorials/**/*.vtm
tutorials/**/*.pvd
tutorials/**/*.dat
tutorials/**/*.avi
tutorials/**/*.mp4
tutorials/**/*.mov
tutorials/**/*.gif
tutorials/**/data/

# PATHOS disease cases carry heart-mesh-resolution initial fields (e.g.
# 0/conductivity, hundreds of MB) — exclude the generated 0/ field dirs.
tutorials/PATHOS/**/0/
